<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.AutomationPage">
  <!--
    自动化页（v0.2.1 跨平台-2 任务一，第 7 个迁移模块）。

    覆盖：安全协议、总开关、任务与选择器、详情页与文件、运行参数、结果目录、定时、
    登录态、运行/停止、运行日志。控件名与 AutomationId 与 WPF 版同名。

    **非 Windows 上的处置**（任务书明确要求）：自动化依赖本机 Edge 的受控启动，
    在 Linux/macOS 上是**已知的两条降级边界之一**。本页在那些平台上：
      * 顶部显示降级横幅（原因 + 替代做法，不把平台限制说成依赖缺失）；
      * 全部输入禁用（而不是允许填写却永远跑不起来）；
      * 后端也会拒绝（平台检查在 `automation.validate` 里，前端只是不让人白填）。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">

      <!-- ① 平台降级横幅（仅非 Windows 显示） -->
      <Border x:Name="PlatformBanner" IsVisible="False"
              Background="{DynamicResource WarningBannerBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12,8">
        <StackPanel Spacing="3">
          <TextBlock x:Name="PlatformBannerTitle" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="PlatformBannerBody" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
        </StackPanel>
      </Border>

      <!-- ② 安全协议 -->
      <TextBlock x:Name="SafetyTitle" FontWeight="Bold" FontSize="14" />
      <TextBlock x:Name="SafetyBodyText" FontSize="11" TextWrapping="Wrap" Opacity="0.8" />
      <CheckBox x:Name="SafetyCheck" FontSize="12"
                AutomationProperties.AutomationId="SafetyCheck" />
      <CheckBox x:Name="AutomationEnabledCheck" FontSize="12"
                AutomationProperties.AutomationId="AutomationEnabledCheck" />

      <!-- ②-b 配置模板 + 填写帮助 + 逐字段「?」（v0.2.2 第 2 批补全，
           对齐 WPF 的 TemplateCombo / AutomationGuideButton / AutomationField_GotFocus）。

           模板内容来自后端（`automation_templates`），**随界面语言切换** ——
           前端不复制一份模板文案，中英双语天然一致。
           字段说明同理：`automation_field_help` 回传 label/help/example/step，
           本页只负责把它摆到界面上。 -->
      <TextBlock x:Name="TemplatesTitle" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />

      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <ComboBox x:Name="TemplateCombo" Grid.Column="0" HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="TemplateCombo" />
        <Button x:Name="ApplyTemplateButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                AutomationProperties.AutomationId="ApplyTemplateButton" />
        <Button x:Name="SaveTemplateButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
                AutomationProperties.AutomationId="SaveTemplateButton" />
        <Button x:Name="AutomationGuideButton" Grid.Column="3" Margin="8,0,0,0" Padding="12,4"
                AutomationProperties.AutomationId="AutomationGuideButton" />
      </Grid>

      <!-- 「存为自定义模板」的内联表单（WPF 用的是 InputDialog；Avalonia 侧没有对话框体系，
           就地展开一行输入框 —— 行为等价，少一个模态窗口） -->
      <StackPanel x:Name="SaveTemplatePanel" Orientation="Horizontal" Spacing="8" IsVisible="False"
                  AutomationProperties.AutomationId="SaveTemplatePanel">
        <TextBox x:Name="SaveTemplateNameBox" Width="240" Padding="6,4"
                 AutomationProperties.AutomationId="SaveTemplateNameBox" />
        <Button x:Name="SaveTemplateConfirmButton" Padding="12,4"
                AutomationProperties.AutomationId="SaveTemplateConfirmButton" />
        <Button x:Name="SaveTemplateCancelButton" Padding="12,4"
                AutomationProperties.AutomationId="SaveTemplateCancelButton" />
      </StackPanel>

      <TextBlock x:Name="TemplateStatusText" FontSize="10" TextWrapping="Wrap" Opacity="0.7"
                 AutomationProperties.AutomationId="TemplateStatusText" />

      <!-- 测试向导的结果：WPF 用 MessageBox 弹出，Avalonia 侧就地展开一块可滚动文本
           （行为等价：结果可见、可复制；少一个必须逐次关闭的模态窗口） -->
      <Border x:Name="WizardResultPanel" IsVisible="False" CornerRadius="6" Padding="10,8"
              BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
              AutomationProperties.AutomationId="WizardResultPanel">
        <StackPanel Spacing="4">
          <TextBlock x:Name="WizardResultTitle" FontWeight="SemiBold" FontSize="12" />
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="WizardResultText" FontSize="11" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="WizardResultText" />
          </ScrollViewer>
          <Button x:Name="WizardResultCloseButton" HorizontalAlignment="Left" Padding="10,3"
                  FontSize="11" AutomationProperties.AutomationId="WizardResultCloseButton" />
        </StackPanel>
      </Border>

      <!-- ③ 任务与选择器 -->
      <TextBlock x:Name="BasicSectionTitle" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="TaskListUrlLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button x:Name="HelpTaskListUrlButton" Padding="5,0" FontSize="10" Height="18"
                  VerticalAlignment="Center" Tag="task_list_url"
                  AutomationProperties.AutomationId="HelpTaskListUrl" />
        </StackPanel>
        <TextBox x:Name="TaskUrlBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="TaskUrlBox" Tag="task_list_url" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="TaskListSelectorLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpTaskListSelector" Tag="task_list_selector" AutomationProperties.AutomationId="HelpTaskListSelector" />
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
          <TextBox x:Name="TaskSelectorBox" Grid.Column="0" Margin="0,4" Padding="6,4"
                   AutomationProperties.AutomationId="TaskSelectorBox" Tag="task_list_selector" />
          <Button x:Name="TestSelectorButton" Grid.Column="1" Margin="8,4,0,4" Padding="12,4"
                  AutomationProperties.AutomationId="TestSelectorButton" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="TaskRowSelectorLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpTaskRowSelector" Tag="task_row_selector" AutomationProperties.AutomationId="HelpTaskRowSelector" />
        </StackPanel>
        <TextBox x:Name="TaskRowBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="TaskRowBox" Tag="task_row_selector" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="NextPageSelectorLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpNextPageSelector" Tag="next_page_selector" AutomationProperties.AutomationId="HelpNextPageSelector" />
        </StackPanel>
        <TextBox x:Name="NextPageBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="NextPageBox" Tag="next_page_selector" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="TaskDetailFileSelectorLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpTaskDetailFileSelector" Tag="task_detail_file_selector" AutomationProperties.AutomationId="HelpTaskDetailFileSelector" />
        </StackPanel>
        <TextBox x:Name="FileSelectorBox" Grid.Row="4" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="FileSelectorBox" Tag="task_detail_file_selector" />
      </Grid>

      <!-- ④ 详情页与文件 -->
      <TextBlock x:Name="DetailSectionTitle" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="FileExtensionsLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpFileExtensions" Tag="file_extensions" AutomationProperties.AutomationId="HelpFileExtensions" />
        </StackPanel>
        <TextBox x:Name="ExtensionsBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="ExtensionsBox" Tag="file_extensions" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="InstructionLabel" VerticalAlignment="Top" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpInstruction" Tag="instruction" AutomationProperties.AutomationId="HelpInstruction" />
        </StackPanel>
        <TextBox x:Name="InstructionBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="6,4"
                 Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                 AutomationProperties.AutomationId="InstructionBox" Tag="instruction" />
      </Grid>
      <TextBlock x:Name="ExtensionsHintText" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />

      <!-- ⑤ 运行参数 -->
      <TextBlock x:Name="RunSectionTitle" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="230,*,230,*" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="MaxTasksLabel" Grid.Row="0" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <TextBox x:Name="MaxTasksBox" Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                 Margin="0,4,10,4" Padding="6,4" AutomationProperties.AutomationId="MaxTasksBox" />
        <TextBlock x:Name="PageTimeoutLabel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <TextBox x:Name="TimeoutBox" Grid.Row="0" Grid.Column="3" Width="110" HorizontalAlignment="Left"
                 Margin="0,4" Padding="6,4" AutomationProperties.AutomationId="TimeoutBox" />
        <TextBlock x:Name="RetriesLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <TextBox x:Name="RetriesBox" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                 Margin="0,4,10,4" Padding="6,4" AutomationProperties.AutomationId="RetriesBox" />
        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Vertical" Spacing="2">
          <CheckBox x:Name="DedupeCheck" FontSize="12" AutomationProperties.AutomationId="DedupeCheck" />
          <CheckBox x:Name="SaveResultsCheck" FontSize="12" AutomationProperties.AutomationId="SaveResultsCheck" />
        </StackPanel>
      </Grid>

      <!-- ⑥ 结果目录 -->
      <TextBlock x:Name="ResultSectionTitle" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock x:Name="TaskNameLabel" Grid.Row="0" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <TextBox x:Name="TaskNameBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="TaskNameBox" />
        <TextBlock x:Name="ResultsRootNameLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
          <TextBox x:Name="ResultsRootNameBox" Grid.Column="0" Margin="0,4" Padding="6,4"
                   AutomationProperties.AutomationId="ResultsRootNameBox" />
          <Button x:Name="OpenResultsButton" Grid.Column="1" Margin="8,4,0,4" Padding="12,4"
                  AutomationProperties.AutomationId="OpenResultsButton" />
        </Grid>
        <TextBlock x:Name="ResultsLocationLabel" Grid.Row="2" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
          <TextBox x:Name="ResultsLocationBox" Grid.Column="0" Margin="0,4" Padding="6,4"
                   AutomationProperties.AutomationId="ResultsLocationBox" />
          <Button x:Name="BrowseResultsButton" Grid.Column="1" Margin="8,4,0,4" Padding="12,4"
                  AutomationProperties.AutomationId="BrowseResultsButton" />
        </Grid>
      </Grid>
      <TextBlock x:Name="ResultsPreviewText" FontSize="10" Opacity="0.65" TextWrapping="Wrap" />
      <TextBlock x:Name="ResultsStatusText" FontSize="10" TextWrapping="Wrap" Opacity="0.8"
                 AutomationProperties.AutomationId="ResultsStatusText" />

      <!-- ⑦ 定时 -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <CheckBox x:Name="ScheduleCheck" FontSize="12" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="ScheduleCheck" />
        <TextBox x:Name="ScheduleTimesBox" Width="220" Padding="6,4"
                 AutomationProperties.AutomationId="ScheduleTimesBox" />
      </StackPanel>

      <!-- ⑧ 登录态 -->
      <TextBlock x:Name="LoginSectionTitle" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
      <TextBlock x:Name="LoginHintText" FontSize="11" TextWrapping="Wrap" Opacity="0.7" />
      <!-- 登录态读取结果（v0.2.2 第 2 批）：只显示"数据目录在哪、占多大、最后改动时间"，
           **不显示任何 Cookie 内容** —— 界面上不该出现凭据，也不该给用户
           "程序在读我的密码"的错觉。 -->
      <TextBlock x:Name="LoginStateText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="LoginStateText" />
      <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="LoginStateDirLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpLoginStateDir" Tag="login_state_dir" AutomationProperties.AutomationId="HelpLoginStateDir" />
        </StackPanel>
        <TextBox x:Name="LoginStateDirBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="LoginStateDirBox" Tag="login_state_dir" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="LoginCheckSelectorLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpLoginCheckSelector" Tag="login_check_selector" AutomationProperties.AutomationId="HelpLoginCheckSelector" />
        </StackPanel>
        <TextBox x:Name="LoginCheckSelectorBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="LoginCheckSelectorBox" Tag="login_check_selector" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="LoginUrlKeywordsLabel" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
          <Button Padding="5,0" FontSize="10" Height="18" VerticalAlignment="Center"
                  x:Name="HelpLoginUrlKeywords" Tag="login_url_keywords" AutomationProperties.AutomationId="HelpLoginUrlKeywords" />
        </StackPanel>
        <TextBox x:Name="LoginKeywordsBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="6,4"
                 AutomationProperties.AutomationId="LoginKeywordsBox" Tag="login_url_keywords" />
      </Grid>
      <Button x:Name="ClearLoginStateButton" HorizontalAlignment="Left" Padding="12,4"
              AutomationProperties.AutomationId="ClearLoginStateButton" />

      <!-- ⑨ 操作 -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button x:Name="SaveConfigButton" Padding="16,6"
                AutomationProperties.AutomationId="SaveConfigButton" />
        <Button x:Name="ReloadConfigButton" Padding="12,6"
                AutomationProperties.AutomationId="ReloadConfigButton" />
        <Button x:Name="RunOnceButton" Padding="14,6"
                AutomationProperties.AutomationId="RunOnceButton" />
        <Button x:Name="StopAutomationButton" Padding="14,6"
                AutomationProperties.AutomationId="StopAutomationButton" />
        <Button x:Name="WizardButton" Padding="14,6"
                AutomationProperties.AutomationId="WizardButton" />
      </StackPanel>

      <!-- ⑨-a 测试向导第 1–4 步与配置导入导出（v0.2.2 第 2 批）：
           WPF 把整套动作摆成一行按钮，这里照抄同一组 AutomationId。 -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="WizardStep1Button" Padding="10,4"
                AutomationProperties.AutomationId="WizardStep1Button" />
        <Button x:Name="WizardStep2Button" Padding="10,4"
                AutomationProperties.AutomationId="WizardStep2Button" />
        <Button x:Name="WizardStep3Button" Padding="10,4"
                AutomationProperties.AutomationId="WizardStep3Button" />
        <Button x:Name="WizardStep4Button" Padding="10,4"
                AutomationProperties.AutomationId="WizardStep4Button" />
        <Button x:Name="ExportConfigButton" Padding="10,4" Margin="16,0,0,0"
                AutomationProperties.AutomationId="ExportConfigButton" />
        <Button x:Name="ImportConfigButton" Padding="10,4"
                AutomationProperties.AutomationId="ImportConfigButton" />
      </StackPanel>

      <!-- ⑨-b 可视化选取与浏览器复用（任务十七，自测问题修复-1）
（编号跟在⑨"操作"后面：它本身也是一组操作，只是内容多到需要单独一块。）

           这一整块是新增的，对应任务书第 4 条"两段式选取"：先打开/连接页面让用户自己
           登录与导航（等待准备），再点「开始选取」进入选取模式。按钮文案与状态文案都由
           后端语言包（automation.picker.*）回传，前端只负责显示与禁用/启用——
           这样中英双语天然一致，也不会出现"前端写一句、后端写另一句"的漂移。

           控件命名沿用本页现有的 `x:Name` + `AutomationProperties.AutomationId` 同名风格，
           便于 ui_probe.ps1 之类的界面探针按名字定位。 -->
      <TextBlock x:Name="PickSectionTitle" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />
      <TextBlock x:Name="PickHintText" FontSize="11" TextWrapping="Wrap" Opacity="0.75" />

      <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock x:Name="BrowserChoiceLabel" Grid.Row="0" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <ComboBox x:Name="BrowserChoiceBox" Grid.Row="0" Grid.Column="1" Margin="0,4" MinWidth="240"
                  HorizontalAlignment="Left" AutomationProperties.AutomationId="BrowserChoiceBox" />
        <TextBlock x:Name="ReuseModeLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <ComboBox x:Name="ReuseModeBox" Grid.Row="1" Grid.Column="1" Margin="0,4" MinWidth="240"
                  HorizontalAlignment="Left" AutomationProperties.AutomationId="ReuseModeBox" />
        <TextBlock x:Name="CdpPortLabel" Grid.Row="2" VerticalAlignment="Center" FontSize="12" Margin="0,4" />
        <TextBox x:Name="CdpPortBox" Grid.Row="2" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                 Margin="0,4" Padding="6,4" AutomationProperties.AutomationId="CdpPortBox" />
      </Grid>
      <TextBlock x:Name="ReuseStateText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="ReuseStateText" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="PickTargetLabel" VerticalAlignment="Center" FontSize="12" />
        <ComboBox x:Name="PickTargetBox" Width="200" MinWidth="200"
                  AutomationProperties.AutomationId="PickTargetBox" />
        <Button x:Name="PickOpenButton" Padding="12,5"
                AutomationProperties.AutomationId="PickOpenButton" />
        <Button x:Name="PickBeginButton" Padding="14,5"
                AutomationProperties.AutomationId="PickBeginButton" />
        <Button x:Name="PickCancelButton" Padding="12,5"
                AutomationProperties.AutomationId="PickCancelButton" />
        <Button x:Name="PickCloseButton" Padding="12,5"
                AutomationProperties.AutomationId="PickCloseButton" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="LaunchDebugBrowserButton" Padding="12,5"
                AutomationProperties.AutomationId="LaunchDebugBrowserButton" />
        <Button x:Name="PickReloadTabButton" Padding="12,5"
                AutomationProperties.AutomationId="PickReloadTabButton" />
      </StackPanel>

      <!-- 等待准备阶段的提示与当前目标页：这两行是任务书第 4 条的核心（用户先看到
           "在哪里操作"，再决定什么时候开始选） -->
      <Border Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="10,8">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PickReadyPromptText" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock x:Name="PickStateText" FontSize="12" TextWrapping="Wrap" />
          <TextBlock x:Name="PickTargetUrlText" FontSize="11" TextWrapping="Wrap" Opacity="0.8" />
          <TextBlock x:Name="PickMessageText" FontSize="11" TextWrapping="Wrap" Opacity="0.9" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="PickDebugHintText" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />

      <!-- ⑪ 日志与状态 -->
      <TextBlock x:Name="RunLogLabel" FontWeight="Bold" FontSize="13" Margin="0,6,0,0" />
      <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <TextBox x:Name="AutomationLogBox" Padding="6,4" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" FontSize="11" FontFamily="Consolas,Menlo,monospace"
                 AutomationProperties.AutomationId="AutomationLogBox" />
      </ScrollViewer>
      <TextBlock x:Name="AutomationStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="AutomationStatusText" />

    </StackPanel>
  </ScrollViewer>
</UserControl>


