<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.AgentPage">
  <!--
    [EN] Agent page (v0.2.1 cross-platform track 2, development task 1, sixth migrated module).

    [EN] Scope: **tool authorization** (one switch per tool), **maximum step count** and a
         **read-only MCP status display**. Both the tool list and the MCP server list are built
         in code, matching the WPF build: these are dynamic rows whose count depends on what the
         backend returns.
    [ZH] 智能体页（v0.2.1 跨平台-2 研发任务 1，第 6 个迁移模块）。

    覆盖：**工具授权**（逐工具开关）、**最大步数**、**MCP 状态只读展示**。
    工具列表与 MCP 服务器列表都由代码构建（与 WPF 版一致：这两块是动态行，
    行数取决于后端返回什么）。
  -->
  <UserControl.Styles>
    <!--
      [EN] Cards generated by code (tool row and MCP server row): they use a style class instead
           of looking up brushes in code. Application.Current.TryFindResource cannot resolve the
           brushes inside ThemeDictionaries (it does not carry the active theme variant), so the
           cards rendered as a borderless column of plain text; this was observed in practice.
      [ZH] 代码生成的卡片（工具行 / MCP 服务器行）：用样式类而不是在代码里查画刷。
           代码里 Application.Current.TryFindResource 取不到 ThemeDictionaries 里的画刷
           （不带当前主题变体），结果卡片画出来是“没有边框的纯文本排” —— 实测踩到。
    -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,12" Spacing="6">

      <!--
        [EN] (1) Title row: in WPF the shield icon, the Agent title and the reload action share
             one row, followed by the description and the state text. The earlier Avalonia build
             had no such row (its first heading was tool permissions), and the reload button sat
             at the very bottom of the page.
        [ZH] ① 标题行：WPF 是「🛡 智能体（Agent） + 🔄 重新读取」同一行，下面是说明与状态。
             原来的 Avalonia 版没有这一行（首个标题是「工具权限」），重新读取按钮还被放到了页面最底部。
      -->
      <Grid ColumnDefinitions="Auto,Auto,*">
        <TextBlock x:Name="AgentTitle" Grid.Column="0" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <Button x:Name="AgentReloadButton" Grid.Column="1" Padding="10,3" FontSize="11"
                Margin="10,0,0,0" VerticalAlignment="Center"
                AutomationProperties.AutomationId="AgentReloadButton" />
      </Grid>

      <TextBlock x:Name="AgentIntroText" FontSize="11" TextWrapping="Wrap" Opacity="0.8" />
      <TextBlock x:Name="AgentStateText" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"
                 AutomationProperties.AutomationId="AgentStateText" />

      <!--
        [EN] (2) Maximum number of tool calls: WPF places it **above** the tool list, so the
             budget is defined first and the tools are then authorized one by one.
        [ZH] ② 最大工具调用数：WPF 把它放在工具列表**之上**（先定预算，再逐个授权工具）。
      -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <TextBlock x:Name="AgentStepsLabel" VerticalAlignment="Center" FontSize="12" />
        <TextBox x:Name="AgentStepsBox" Width="60" Padding="6,4"
                 AutomationProperties.AutomationId="AgentStepsBox" />
        <Button x:Name="AgentStepsApplyButton" Padding="12,4"
                AutomationProperties.AutomationId="AgentStepsApplyButton" />
        <TextBlock x:Name="AgentStepsHint" FontSize="11" VerticalAlignment="Center"
                   TextWrapping="Wrap" Opacity="0.7" MaxWidth="420" />
      </StackPanel>

      <!--
        [EN] (3) Tool authorization: section title plus the subtitle note used by the WPF build.
        [ZH] ③ 工具授权：区块标题 +（WPF 同款的）副标题说明。
      -->
      <TextBlock x:Name="AgentToolsTitle" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />
      <TextBlock x:Name="AgentToolsSubtitle" FontSize="11" TextWrapping="Wrap" Opacity="0.7" />
      <StackPanel x:Name="AgentToolList" Spacing="4" />

      <!--
        [EN] (3) MCP (v0.2.2 batch 2: extended from a read-only display to an **editable** one,
             aligned with SettingsWindow.Mcp.cs in the WPF build). Control names and
             AutomationIds match WPF, so a single probe can drive both interfaces.

             The editing model matches WPF item by item: **changes are staged locally** in the
             server list, and only the save action or the connect-and-fetch-tools action submits
             them as a whole. mcp_apply itself means "replace the entire configuration", so
             batching the edits fits the shape of the interface better than sending one request
             per keystroke, and it also allows the user to change their mind without saving.
        [ZH] ③ MCP（v0.2.2 第 2 批：从“只读展示”补成**可编辑**，对齐 WPF 的 SettingsWindow.Mcp.cs）。
             控件名与 AutomationId 与 WPF 同名，同一份探针可以驱动两套界面。

             编辑模型与 WPF 逐条一致：**界面上的改动先落在本地**（服务器列表），
             点「💾 保存」或「🔌 连接并取工具」才整体提交 —— mcp_apply 本身就是
             “整份配置替换”的语义，攒着一起交比每敲一个键就发一次更符合接口形状，
             也让“改错了不点保存”成为可能。
      -->
      <TextBlock x:Name="McpTitle" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="McpReloadButton" Padding="12,4"
                AutomationProperties.AutomationId="McpReloadButton" />
        <Button x:Name="McpSaveButton" Padding="12,4"
                AutomationProperties.AutomationId="McpSaveButton" />
        <Button x:Name="McpConnectButton" Padding="12,4"
                AutomationProperties.AutomationId="McpConnectButton" />
      </StackPanel>

      <TextBlock x:Name="McpIntro" FontSize="11" TextWrapping="Wrap" Opacity="0.75" />
      <!--
        [EN] The security notice gets its own line plus the accent color and a semibold weight:
             this is the risk boundary of connecting external processes to the agent, and it
             should not be buried in small hint text. The Avalonia theme has no dedicated
             warning foreground color, so the established approach in this project is to express
             "needs attention" with AccentBrush (see the risk labels on this page).
        [ZH] 安全提示单独一行且用强调色 + 半粗体：这是“把外部进程接进 Agent”的风险边界，
             不该塞进小字提示里。Avalonia 的主题里没有独立的警告前景色，
             本工程已有的做法是用 AccentBrush 表达“需要注意”（见本页的风险标签）。
      -->
      <TextBlock x:Name="McpSecurity" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"
                 Foreground="{DynamicResource AccentBrush}"
                 AutomationProperties.AutomationId="McpSecurity" />

      <StackPanel Orientation="Horizontal" Spacing="14">
        <CheckBox x:Name="McpEnabledCheck" FontSize="11" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="McpEnabledCheck" />
        <CheckBox x:Name="McpAutoConnectCheck" FontSize="11" VerticalAlignment="Center"
                  AutomationProperties.AutomationId="McpAutoConnectCheck" />
        <TextBlock x:Name="McpTimeoutLabel" FontSize="11" VerticalAlignment="Center" />
        <TextBox x:Name="McpTimeoutBox" Width="56" Padding="6,3" FontSize="11"
                 VerticalAlignment="Center"
                 AutomationProperties.AutomationId="McpTimeoutBox" />
        <TextBlock x:Name="McpTimeoutHint" FontSize="10" VerticalAlignment="Center" Opacity="0.6" />
      </StackPanel>

      <TextBlock x:Name="McpStagedHint" FontSize="10" TextWrapping="Wrap" Opacity="0.65" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <TextBlock x:Name="McpListTitle" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
        <Button x:Name="McpAddButton" Padding="12,3" FontSize="11"
                AutomationProperties.AutomationId="McpAddButton" />
        <Button x:Name="McpAddExampleButton" Padding="12,3" FontSize="11"
                AutomationProperties.AutomationId="McpAddExampleButton" />
      </StackPanel>

      <!--
        [EN] Inline form for adding a server (collapsed by default; it expands only through the
             add-server action). A dialog is deliberately **avoided**: the Avalonia side has no
             dialog framework, and an inline form also keeps the entry next to the list on the
             same screen.
        [ZH] 新增 server 的内联表单（默认折叠：「＋ 添加服务器」才展开）。
             刻意**不做弹窗**：Avalonia 侧没有对话框体系，就地展开还能与列表同屏对照。
      -->
      <Border x:Name="McpFormPanel" IsVisible="False" CornerRadius="6" Padding="10,8"
              BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="McpFormPanel">
        <StackPanel Spacing="4">
          <TextBlock x:Name="McpFormTitle" FontWeight="SemiBold" FontSize="11" />
          <TextBlock x:Name="McpFormNameLabel" FontSize="10" Opacity="0.7" />
          <TextBox x:Name="McpFormNameBox" Width="240" HorizontalAlignment="Left"
                   AutomationProperties.AutomationId="McpFormNameBox" />
          <TextBlock x:Name="McpFormCommandLabel" FontSize="10" Opacity="0.7" />
          <TextBox x:Name="McpFormCommandBox" Width="240" HorizontalAlignment="Left"
                   AutomationProperties.AutomationId="McpFormCommandBox" />
          <TextBlock x:Name="McpFormArgsLabel" FontSize="10" Opacity="0.7" />
          <TextBox x:Name="McpFormArgsBox" MinWidth="360" HorizontalAlignment="Left"
                   AutomationProperties.AutomationId="McpFormArgsBox" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="McpFormAddConfirmButton" Padding="14,4" FontSize="11"
                    AutomationProperties.AutomationId="McpFormAddConfirmButton" />
            <Button x:Name="McpFormCancelButton" Padding="14,4" FontSize="11"
                    AutomationProperties.AutomationId="McpFormCancelButton" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel x:Name="McpServerList" Spacing="6" />

      <!--
        [EN] Summary row (kept additionally in the cross-platform build: the WPF side has no
             such row; it only provides a read-only status summary).
        [ZH] 汇总行（跨平台版额外保留：WPF 侧没有这一行，它只做只读状态摘要）。
      -->
      <TextBlock x:Name="McpSummaryText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="McpSummaryText" />

      <!--
        [EN] (4) Status row (the reload button has moved up to the title row, at the same
             position as in WPF).
        [ZH] ④ 状态行（重新读取按钮已上移到标题行，与 WPF 同位置）。
      -->
      <TextBlock x:Name="McpStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="McpStatusText" />
      <TextBlock x:Name="AgentStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="AgentStatusText" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
