<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.GeneralPage">
  <!--
    [EN] General page (visual-alignment revision): the layout replicates the General tab of
         frontend/SettingsWindow.xaml.
           * StackPanel Margin="14,12" with no Spacing; blocks are arranged by the per-block
             Margin used in WPF;
           * the three section titles (appearance and defaults / language / language pack) are
             15 px bold accent text;
           * field labels are small sub-color text, and the controls are 200 wide (theme and
             emoji), 260 (mode and language) and 320 (slider);
           * the language pack and "interface and data locations" are cards with radius 8 and a
             1 px border.
         Control names (x:Name) and AutomationIds are unchanged, as both the probes and the code
         locate controls by these names.
    [ZH] 常规页（视觉对齐版）：版式按 frontend/SettingsWindow.xaml 的「常规」页签复刻。
      · StackPanel Margin="14,12"，不靠 Spacing，而是按 WPF 的逐块 Margin 排；
      · 三个区块标题（外观与默认行为 / 语言 / 语言包）是 15 号加粗强调色；
      · 字段标签是副色小字，控件宽度 200（主题/emoji）、260（模式/语言）、320（滑块）；
      · 语言包与“界面与数据位置”都是 8 圆角、1px 描边的卡片。
    控件名（x:Name）与 AutomationId 保持不变，探针与代码都按这些名字找控件。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,12">

      <!-- [EN] (1) Appearance and default behavior. -->
      <!-- [ZH] ① 外观与默认行为。 -->
      <TextBlock x:Name="AppearanceTitle" FontSize="15" FontWeight="Bold"
                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />

      <TextBlock x:Name="ThemeLabel" Margin="0,4,0,4"
                 Foreground="{DynamicResource SubTextBrush}" />
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="ThemeCombo" Width="200" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="ThemeCombo" />
        <TextBlock x:Name="ThemeStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="{DynamicResource SubTextBrush}" />
      </StackPanel>
      <TextBlock x:Name="ThemeNote" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource SubTextBrush}" />

      <TextBlock x:Name="EmojiLabel" Margin="0,12,0,4"
                 Foreground="{DynamicResource SubTextBrush}" />
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="EmojiCombo" Width="200" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="EmojiCombo" />
        <TextBlock x:Name="EmojiStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock x:Name="FontSizeLabel" Margin="0,14,0,4"
                 Foreground="{DynamicResource SubTextBrush}" />
      <StackPanel Orientation="Horizontal">
        <Slider x:Name="FontSizeSlider" Width="320" Minimum="10" Maximum="24"
                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                AutomationProperties.AutomationId="FontSizeSlider" />
        <TextBlock x:Name="FontSizeValueText" Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource SubTextBrush}"
                   AutomationProperties.AutomationId="FontSizeValueText" />
      </StackPanel>

      <TextBlock x:Name="DefaultModeLabel" Margin="0,14,0,4"
                 Foreground="{DynamicResource SubTextBrush}" />
      <ComboBox x:Name="DefaultModeCombo" Width="260" HorizontalAlignment="Left"
                AutomationProperties.AutomationId="DefaultModeCombo" />
      <TextBlock x:Name="DefaultModeHint" IsVisible="False" />

      <CheckBox x:Name="ConfirmDestructiveCheck" Margin="0,14,0,0"
                AutomationProperties.AutomationId="ConfirmDestructiveCheck" />

      <!-- [EN] (2) Language. -->
      <!-- [ZH] ② 语言 / Language。 -->
      <TextBlock x:Name="LanguageTitle" FontSize="15" FontWeight="Bold"
                 Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10" />

      <TextBlock x:Name="LanguageLabel" Margin="0,0,0,4"
                 Foreground="{DynamicResource SubTextBrush}" />
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="LanguageCombo" Width="260" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="LanguageCombo" />
      </StackPanel>
      <TextBlock x:Name="LanguageHelpText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource SubTextBrush}" />

      <!-- [EN] (3) Language pack. -->
      <!-- [ZH] ③ 语言包。 -->
      <TextBlock x:Name="LangPackTitle" FontSize="15" FontWeight="Bold"
                 Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10" />
      <Border CornerRadius="8" Padding="10,8" BorderThickness="1"
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel>
          <TextBlock x:Name="LangPackText" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubTextBrush}"
                     AutomationProperties.AutomationId="LangPackText" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="ReloadLangButton" Padding="10,3" FontSize="11"
                    AutomationProperties.AutomationId="ReloadLangButton" />
            <Button x:Name="OpenLangDirButton" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="OpenLangDirButton" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- [EN] (4) Interface and data locations. -->
      <!-- [ZH] ④ 界面与数据位置。 -->
      <Border Margin="0,18,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1"
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel>
          <TextBlock x:Name="PathsTitle" FontWeight="Bold" Margin="0,0,0,6" />
          <TextBlock x:Name="PathsText" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubTextBrush}"
                     AutomationProperties.AutomationId="PathsText" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
