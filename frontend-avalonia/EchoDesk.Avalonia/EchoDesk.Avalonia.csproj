<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EchoDesk 跨平台前端（Avalonia）—— 任务一：最小原型。

    这里的关键取舍（见 records/v0.2.2-跨平台记录.md）：
      * **net10.0（不带 -windows 后缀）**：这是"能跨平台"的第一道硬门槛。
        WPF 版的目标框架是 `net10.0-windows`，一旦带上 `-windows` 就无法在
        Linux/macOS 上编译。本工程刻意用不带后缀的 TFM，并且**不引用任何
        Windows 专属包**（WinForms/WPF/P-Invoke 到 user32）。
      * `AvaloniaUseCompiledBindingsByDefault=true`：编译期校验绑定路径，
        少一类"运行时才发现绑定写错"的问题（WPF 版靠手写事件处理绕过了绑定）。
      * `BuiltInComInteropSupport=false`：明确关掉 COM 互操作 —— 项目里**不应有**
        WPS COM 之类 Windows 专属能力；那些能力留在 Python 后端并按平台降级。
      * 输出类型 WinExe（Windows 上不弹控制台），Linux/macOS 上同样是图形程序。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>EchoDesk</AssemblyName>
    <RootNamespace>EchoDesk.Avalonia</RootNamespace>
    <!-- 窗口/任务栏/资源管理器里显示的图标。源文件是 ../assets/EchoDesk.ico 的副本，
         放在 Assets 下是为了同时作为 AvaloniaResource 供 Window.Icon 使用
         （Linux/macOS 上 ApplicationIcon 不生效，只有 AvaloniaResource 生效）。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 版本口径：v0.2.1 = 跨平台之前（没有这个工程）；v0.2.2 = 跨平台版本；
         v0.2.3 = Avalonia 主线（WPF 同期转入 LTS）。权威来源是 backend/version.py 的
         APP_VERSION，升版本时这四处必须同步：`<Version>` 可带预发布后缀，
         `AssemblyVersion`/`FileVersion` 只能是四段纯数字（口径同 app_version_4()）。
         Versioning: v0.2.1 = pre-cross-platform (this project did not exist); v0.2.2 =
         cross-platform release; v0.2.3 = Avalonia as the main line (WPF moves into LTS at the
         same time). The authoritative source is APP_VERSION in backend/version.py, and these
         four fields must be kept in sync: `<Version>` may carry a prerelease suffix, while
         `AssemblyVersion`/`FileVersion` must be four purely numeric fields (same rule as
         app_version_4()). -->
    <Version>0.2.3-alpha.1</Version>
    <FileVersion>0.2.3.0</FileVersion>
    <AssemblyVersion>0.2.3.0</AssemblyVersion>
    <Product>EchoDesk</Product>
    <Company>VoidEntropiaStudio</Company>
    <Copyright>Copyright (c) VoidEntropiaStudio</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 体积：跨平台版把 trimming 的坑留在记录里，先按"不裁剪"发布（见 records 的体积一节） -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      语言包：**链接**仓库里 WPF 版那一份（frontend/Resources/Lang/*.json）而不是拷一份。
      两个前端消费同一批文件，"单一来源"由构建保证 —— 改一处、两边同时生效，
      不会出现"翻译改了 WPF 那份、Avalonia 那份没跟上"的漂移。
      磁盘上的用户语言包（UserPaths.LangDirectory）优先级更高，见 Services/Loc.cs。
    -->
    <AvaloniaResource Include="..\..\frontend\Resources\Lang\*.json"
                      Link="Assets\Lang\%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
