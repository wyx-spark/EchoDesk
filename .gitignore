# ---------- 构建产物 ----------
build/
dist/
out/
frontend/bin/
frontend/obj/
publish/
*.pdb

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
backend_crash.log

# ---------- 模型与缓存（体积过大，不入库） ----------
*.gguf
models/*.gguf
.cache/
backend/.cache/

# ---------- 运行时用户数据（后端在工作目录里生成的文件） ----------
session.json
config.user.json
ui_state.json
snippets.json
backend_crash.log
# 前端崩溃日志（v0.2.0 修复一：全局异常兜底会写这个文件）
frontend_crash.log
# 自动化
automation_log.jsonl
automation_processed.json
automation_results/
browser_state.json
# 自动化的持久化浏览器数据目录（v0.2.1 自动化优化 任务一：登录态存在这里）。
# 它可能出现在仓库根（开发时程序根目录就是仓库根），含 Cookie，绝不能入库。
browser_profile/
# 结果目录（新增三；默认生成在程序根目录，也可能被指到仓库内）
# v0.2.1 发布任务书「全局要求一」：目录名由「批量处理结果」改为英文 results，
# 只锚定仓库根，避免误伤将来任何名为 results 的子目录；旧名保留一行兼容旧用户。
批量处理结果/
/results/
# 模型选择栏（新增四）
models_registry.json
# 技能市场
market_cache.json
skills_registry.json
# 已安装技能目录（运行时）：必须写全路径。只写 skills/ 会连
# examples/skills/（示例插件，需要入库）一起忽略掉——v0.2.1 实际踩到过。
backend/skills/
# 开发时留下的临时脚本/产物
_tmp_*.py
*.tmp

# ---------- IDE / 编辑器 ----------
.idea/
.vs/
*.user
*.suo
*.swp

# ---------- 第三方命令行工具（由 tools\fetch_tools.bat 按需下载） ----------
tools/rcedit-*.exe

# ---------- v0.2.1 新增 ----------
# 开发中的本地插件（放进去即被识别，但不是仓库内容；示例插件在 examples/skills/ 入库）
backend/skills_dev/
# 本地插件清单（含本机路径与信任状态，因人而异）
skills_local.json
# 插件开发日志
skills_dev.log
# 自定义自动化模板（用户自己攒的，不入库）
automation_templates.json
# 用户外置语言包目录（程序根目录下的 lang\，仅本机临时语言包不入库；
# 必须写 /lang/ 而不是 lang/，否则会把 backend/lang/ 里的内置语言包一起忽略）
/lang/
# 自动化配置导出件
*.echodesk-auto

# ---------- 修复四新增 ----------
# 分段摘要缓存（按文件指纹缓存摘要结果，随使用生成；用户可自行删除）
summary_cache.json
backend/summary_cache.json
# 开发期产物（像素校验截图、语言包补丁 JSON 等）
artifacts/

# ---------- 发布任务书「全局要求五」 ----------
# 任务书与提示词文件（prompts\ 下的 *.md，以及散落在根目录的同类文件）不入库：
# 发布任务书明确把「提示词文件：prompts/ 目录及散落的提示词、任务书 md」
# 列为不该有的内容。它们留在工作区供开发时查阅即可。
/prompts/
