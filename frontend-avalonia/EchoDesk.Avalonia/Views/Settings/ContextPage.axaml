<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.ContextPage">
  <!--
    [EN] Context window page (v0.2.6-reader). One question, one answer: "how much can a
         single read hold". The tiers are deliberately expressed in tokens with a plain
         "about N words" hint, and every technical consequence (memory, quality) is stated
         in everyday language. The page never asks the user to understand RoPE or YaRN;
         those names exist only in the configuration file and in this file's comments.
    [ZH] 上下文窗口页（v0.2.6-reader）。一个问题、一个回答：“一次能读多长”。档位用 token
         表达，并附“约多少字”的直观提示；内存与质量代价一律用日常语言说明。页面不要求
         用户理解 RoPE 或 YaRN —— 那些名字只出现在配置文件与本文件的注释里。
    Control names and AutomationIds are what the probe and the UI code look up.
    控件名与 AutomationId 是探针与界面代码查找的依据。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,12">

      <TextBlock x:Name="Title" FontSize="15" FontWeight="Bold"
                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />

      <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                 AutomationProperties.AutomationId="ContextStatusText" />

      <Border CornerRadius="8" Padding="12,10" BorderThickness="1"
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel>

          <TextBlock x:Name="TierLabel" Margin="0,0,0,4"
                     Foreground="{DynamicResource SubTextBrush}" />
          <ComboBox x:Name="TierCombo" Width="360" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="ContextTierCombo" />

          <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Margin="0,10,0,0"
                      IsVisible="False">
            <TextBlock x:Name="CustomLabel" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}" />
            <TextBox x:Name="CustomBox" Width="120" Margin="8,0,0,0"
                     AutomationProperties.AutomationId="ContextCustomBox" />
          </StackPanel>

          <CheckBox x:Name="ExtendCheck" Margin="0,12,0,0"
                    AutomationProperties.AutomationId="ContextExtendCheck" />
          <TextBlock x:Name="ExtendHint" FontSize="11" Margin="24,2,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubTextBrush}" />

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Padding="14,4"
                    AutomationProperties.AutomationId="ContextSaveButton" />
            <Button x:Name="RestoreButton" Padding="14,4" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="ContextRestoreButton" />
            <TextBlock x:Name="SaveStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="11" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ContextSaveStatusText" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Margin="0,16,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1"
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel>
          <TextBlock x:Name="InfoTitle" FontWeight="Bold" Margin="0,0,0,6" />
          <TextBlock x:Name="Note1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                     Foreground="{DynamicResource SubTextBrush}" />
          <TextBlock x:Name="Note2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                     Foreground="{DynamicResource SubTextBrush}" />
          <TextBlock x:Name="Note3" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubTextBrush}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
