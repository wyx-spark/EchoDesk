<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:EchoDesk.Avalonia.Services"
        x:Class="EchoDesk.Avalonia.Views.MainWindow"
        Title="EchoDesk"
        Icon="/Assets/app.ico"
        Width="844" Height="581" MinWidth="744" MinHeight="501"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly"
        DragDrop.AllowDrop="True">
  <!--
    [EN] Borderless shell contract: WindowDecorations="BorderOnly" removes the operating-
    [EN] system caption while preserving the native resize frame, drop shadow and maximise
    [EN] animation. Window movement is delegated to BeginMoveDrag in the code-behind, which
    [EN] executes the platform move loop and therefore inherits native snapping and DPI
    [EN] handling.
    [ZH] 无边框外壳约定：WindowDecorations="BorderOnly" 移除操作系统标题栏，同时保留原生缩放边框、
    [ZH] 投影与最大化动画。窗口移动交由代码隐藏文件中的 BeginMoveDrag 执行平台移动循环，
    [ZH] 因此天然继承系统贴靠与 DPI 处理。
    [EN] The historical visual-alignment notes below are retained unchanged for traceability.
    [ZH] 下方历史视觉对齐说明保持原样，以便追溯。
    [EN] Main window (visual-alignment revision): the skeleton, spacing, font sizes and corner
    [EN] radii are replicated from frontend/MainWindow.xaml.
    [ZH] 主窗口（视觉对齐版）：骨架、间距、字号、圆角全部按 frontend/MainWindow.xaml 复刻。

    [EN] Differences from the previous revision (all of them visible differences, not a
    [EN] refactor):
    [ZH] 与上一版的差别（都是"看得见"的差别，不是重构）：
    [EN] * The window margin is 10 (Grid Margin="10" in WPF), not a full-bleed strip that
    [EN]   runs edge to edge;
    [ZH]   · 窗口外边距 10（WPF 的 Grid Margin="10"），而不是整条通栏贴边；
    [EN] * The title row is a row **tiled** directly on the window background, with no
    [EN]   separate backing plate and no divider line;
    [ZH]   · 标题行是**平铺**在窗口底色上的一行，没有独立底板、没有分隔线；
    [EN] * The input area is a white card with 12 px corners, the command row uses 8 px
    [EN]   corners, and the status area uses 8 px corners;
    [ZH]   · 输入区是 12 圆角的白卡片，命令行是 8 圆角，状态区是 8 圆角；
    [EN] * The bottom hints are centered inside a fixed-height 42 px area (previously they
    [EN]   were squeezed into the middle of the toolbar);
    [ZH]   · 底部提示固定在 42 高的区域里居中（原来塞在工具条中间）；
    [EN] * The toolbar buttons follow the WPF dimensions: command and snippets 170x34,
    [EN]   context 130x30, settings and upload 34x34, send 40x40 (a circular capsule); they
    [EN]   are no longer square buttons carrying text;
    [ZH]   · 工具条按钮按 WPF 的尺寸：命令/常用语 170x34、上下文 130x30、
    [ZH]     设置/上传 34x34、发送 40x40（圆形胶囊），不再是带文字的方块按钮。

    [EN] The feature panels map one-to-one to the WPF build (command panel, snippet panel,
    [EN] notification bar, status area, agent step area).
    [ZH] 功能面板与 WPF 版一一对应（指令面板、常用语面板、通知条、状态区、Agent 步骤区）。
  -->
  <Window.Styles>
    <!-- [EN] WPF RoundButton: margin 2, corner radius 17, a 1 px border and a gray fill. -->
    <!-- [ZH] WPF RoundButton：Margin 2 · 圆角 17 · 1px 描边 · 灰底。 -->
    <Style Selector="Button.round">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!--
      [EN] Small capsule shared by the status area and the title row: padding 6,1, corner radius
           17, font size 11.
      [ZH] 状态区/标题行的小胶囊：Padding 6,1 · 圆角 17 · 11 号字。
    -->
    <Style Selector="Button.chip">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!--
      [EN] Icon-only button: glyphs are drawn from Segoe UI Symbol and follow the foreground
           color, because color emoji lack contrast on light backgrounds.
      [ZH] 纯图标按钮：字形走 Segoe UI Symbol，跟随前景色（彩色 emoji 在浅底上对比度不足）。
    -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI Emoji, Segoe UI" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.brand">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>
    <!--
      [EN] Hover and pressed feedback for the primary send action; the resting accent fill is a
           local value on the button itself.
      [ZH] 发送主操作的悬停与按下反馈；静息态强调色填充由按钮自身的本地值承载。
    -->
    <Style Selector="Button#SendButton:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button#SendButton:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <!--
      [EN] Critical memory pressure. The class is toggled from SetMemoryStatus when the
           measured usage exceeds 90%; the brush stays a DynamicResource so a theme switch
           recolours it without touching the code.
      [ZH] 内存极度紧张。使用率超过 90% 时由 SetMemoryStatus 切换该类；画刷保持
           DynamicResource，因此切换主题会自动换色，无需改代码。
    -->
    <Style Selector="TextBlock.memory-critical">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!--
      [EN] Custom title bar, v0.2.6 item 21 revision: the strip carries **only** the identity
           on the left (icon + version) and the interaction state on the right (model capsule,
           mode capsule, caption controls). Every dynamic status sentence was removed, because
           a long status text used to push the model capsule rightwards and was itself clipped.
      [ZH] 自定义标题栏（v0.2.6 第 21 项修订）：条带**只**承载左侧标识（图标 + 版本号）与
           右侧交互状态（模型胶囊、模式胶囊、窗口按钮）。所有动态状态长句一律移除，
           因为此前过长的状态文本会把模型胶囊向右挤压，而且它自身也显示不全。
    -->
    <Border x:Name="TitleBar" Grid.Row="0" Height="44"
            Background="{DynamicResource TitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!--
            [EN] Application identity mark: the official application icon is rendered directly,
                 so that the title bar and the operating-system task switcher present one identity.
            [ZH] 应用标识：直接渲染官方应用程序图标，使标题栏与操作系统任务切换器呈现同一标识。
          -->
          <Image Width="22" Height="22" Source="/Assets/app.ico" Stretch="Uniform"
                 ToolTip.Tip="EchoDesk" />
          <!--
            [EN] Version only. It comes from the backend `ready` handshake (single source of
                 truth: backend/version.py) and is never hard-coded in the front end.
            [ZH] 仅显示版本号。版本来自后端 `ready` 握手（唯一来源是 backend/version.py），
                 前端绝不写死。
          -->
          <TextBlock x:Name="TitleBarVersionText" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource SubTextBrush}" TextWrapping="NoWrap"
                     AutomationProperties.AutomationId="TitleBarVersionText" />
        </StackPanel>

        <!--
          [EN] The middle column is deliberately an empty star column: it absorbs all free
               width, so no text can ever push the model and mode capsules towards the caption
               controls. Width changes are therefore handled by this spacer alone.
          [ZH] 中列刻意留空并设为星号列：它吸收全部剩余宽度，任何文本都无法再把模型/模式
               胶囊推向窗口按钮。宽度变化只由这个留白列承担。
        -->

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!--
            [EN] Model capsule (moved out of the content row in v0.2.6 item 21). The width is
                 capped and long names are trimmed so that a long model name cannot deform the
                 caption strip either.
            [ZH] 模型胶囊（v0.2.6 第 21 项从内容行迁入）。宽度封顶且超长名称省略显示，
                 因此再长的模型名也不会使窗口按钮条带变形。
          -->
          <Button x:Name="ModelChip" Margin="0,0,6,0" Padding="8,2" Height="26"
                IsHitTestVisible="False" Focusable="False"
                  VerticalAlignment="Center" Classes="round"
                  AutomationProperties.AutomationId="ModelChip">
            <TextBlock x:Name="ModelText" Text="" FontSize="11" MaxWidth="170"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Button>
          <Button x:Name="ModeChip" Margin="0,0,6,0" Padding="8,2" Height="26"
                  VerticalAlignment="Center" Classes="round"
                  AutomationProperties.AutomationId="ModeChip">
            <TextBlock x:Name="ModeText" Text="" FontSize="11" MaxWidth="130"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Button>
          <!-- [EN] Hairline separating interactive state from the caption controls. -->
          <!-- [ZH] 用于分隔交互状态与窗口控制按钮的极细分隔线。 -->
          <Border Width="1" Height="20" Margin="2,0,6,0"
                  Background="{DynamicResource TitleBarBorderBrush}" />
          <Button x:Name="TitleBarMinimizeButton" Classes="chrome"
                  AutomationProperties.AutomationId="TitleBarMinimizeButton">
            <Path Data="M1,5.5 L11,5.5" Stroke="{DynamicResource TitleBarForegroundBrush}"
                  StrokeThickness="1.2" />
          </Button>
          <Button x:Name="TitleBarMaximizeButton" Classes="chrome"
                  AutomationProperties.AutomationId="TitleBarMaximizeButton">
            <Panel Width="12" Height="12">
              <Path x:Name="MaximizeGlyph" Data="M1,1 L11,1 L11,11 L1,11 Z"
                    Stroke="{DynamicResource TitleBarForegroundBrush}" StrokeThickness="1.2" />
              <Path x:Name="RestoreGlyph" IsVisible="False"
                    Data="M4,1 L11,1 L11,8 M1,4 L8,4 L8,11 L1,11 Z"
                    Stroke="{DynamicResource TitleBarForegroundBrush}" StrokeThickness="1.2" />
            </Panel>
          </Button>
          <Button x:Name="TitleBarCloseButton" Classes="chrome close"
                  AutomationProperties.AutomationId="TitleBarCloseButton">
            <Path Data="M1,1 L11,11 M11,1 L1,11"
                  Stroke="{DynamicResource TitleBarCloseForegroundBrush}" StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="10" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,42">

    <!--
      [EN] (1) Top banner area (platform degradation or missing model): it occupies row 0 on its
           own and never overlaps the title row.
      [ZH] ① 顶部横幅区（平台降级 / 无模型引导）：单独占第 0 行，不与标题行重叠。
    -->
    <StackPanel Grid.Row="0" Spacing="4">
    <Border x:Name="PlatformBanner" Classes="elevated" IsVisible="False"
            Background="{DynamicResource WarningBannerBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
      <StackPanel Spacing="2">
        <TextBlock x:Name="PlatformBannerText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="PlatformBannerDetail" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!--
      [EN] (2) No-model guidance bar: when the backend reports that no model is ready, the three
           available paths are listed plainly.
      [ZH] ② 无模型引导条：后端“无模型就绪”时把三条路径直白列出来。
    -->
    <Border x:Name="GuideBanner" Classes="elevated" IsVisible="False"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
      <TextBlock x:Name="GuideText" TextWrapping="Wrap" FontSize="12" />
    </Border>
    </StackPanel>

    <!--
      [EN] v0.2.6 item 21: the former status row (brand mark, run-state sentence, model and mode
           capsules) is gone. The capsules moved into the custom title bar, the run-state text
           moved into the bottom status strip, and the brand block had been hidden since v0.2.3.
           What remains below is a **zero-space legacy scaffold**: four controls that exist only
           on Settings > General but whose named handlers keep Ctrl+± , Ctrl+T and the language
           reflection working. Because the parent is collapsed it consumes no layout and cannot
           deform the title row.
      [ZH] v0.2.6 第 21 项：原状态行（品牌、运行状态长句、模型与模式胶囊）整体移除。胶囊迁入
           自定义标题栏，运行状态文本迁入底部状态区，品牌区块自 v0.2.3 起本就隐藏。下面保留的
           是**零占位旧版脚手架**：四个只属于“设置-常规”的控件，其具名处理器仍支撑 Ctrl+±、
           Ctrl+T 与语言反射。父容器已折叠，因此不占布局，也不会使标题行变形。
    -->
    <StackPanel x:Name="LegacyControlScaffold" Grid.Row="1" IsVisible="False">
      <Button x:Name="FontDownButton" Classes="chip" Content="A-" />
      <Button x:Name="FontUpButton" Classes="chip" Content="A+" />
      <Button x:Name="ThemeButton" Classes="chip" Content="🌓" />
      <ComboBox x:Name="LangCombo" MinWidth="118" />
    </StackPanel>

    <!-- [EN] (4) Message list (Ctrl+wheel adjusts the font size). -->
    <!-- [ZH] ④ 消息列表（支持 Ctrl+滚轮调节字号）。 -->
    <ScrollViewer x:Name="MessageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="MessagePanel" Orientation="Vertical" />
    </ScrollViewer>

    <!--
      [EN] (5) Command input row: hidden by default and revealed after the command button in the
           lower left corner is clicked.
      [ZH] ⑤ 指令输入行：默认隐藏，点击左下角命令按钮后显示。
    -->
    <Border x:Name="CommandInputRow" Grid.Row="3" Margin="0,6,0,0" CornerRadius="8"
            IsVisible="False"
            Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
      <Grid>
        <TextBox x:Name="CommandInputBox" MinHeight="30" Margin="8,4"
                 VerticalContentAlignment="Center" Padding="6,0"
                 AcceptsReturn="False" BorderThickness="0" Background="Transparent"
                 PlaceholderText="" />
      </Grid>
    </Border>

    <!-- [EN] (6) Input area: borderless text input above, round-button toolbar below. -->
    <!-- [ZH] ⑥ 输入区：上半无框文本输入，下半圆形按钮工具栏。 -->
    <Border x:Name="InputAreaBorder" Classes="elevated" Grid.Row="4" Margin="0,6,0,0" CornerRadius="12"
            Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
            Padding="12,8">
      <Grid RowDefinitions="Auto,Auto">

        <TextBox x:Name="InputBox" Grid.Row="0" MinHeight="36" MaxHeight="140"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 BorderThickness="0" Background="Transparent" />

        <Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="Auto,*">
          <!--
            [EN] v0.2.6 item 17: the former 12-column Auto row summed to more than
                 the minimum window width, so the send button could be pushed past the
                 card border while resizing. The left actions now live in an Auto
                 column and the right cluster in a star column whose WrapPanel wraps
                 instead of overflowing. The send action is the last item and therefore
                 always stays inside the border at any window width.
            [ZH] v0.2.6 第 17 项：原来的 12 个 Auto 列在最小窗口宽度下总和超界，缩放时
                 发送按钮会被挤出卡片边框。现在左侧操作放进 Auto 列，右侧按钮簇放进
                星号列，由 WrapPanel 换行而不是溢出。发送按钮是最后一项，因此在任何
                 窗口宽度下都留在边框之内。
          -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                      Spacing="4">

          <!--
            [EN] Left side: toggle button for the command input row (the plus sign rotates into
                 a cross; a fixed width keeps the layout from jumping).
            [ZH] 左侧：命令输入框开关按钮（加号旋转变叉号，固定宽度防跳动）。
          -->
          <Button x:Name="CommandButton" MinWidth="118" MaxWidth="170" Height="34" Classes="round">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="CommandIconText" Text="+" FontSize="18" FontWeight="Bold"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="CommandButtonText" Text="" FontSize="12"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- [EN] Snippet button (same toggle-label style, fixed width). -->
          <!-- [ZH] 常用语按钮（同款开关文字，固定宽度）。 -->
          <Button x:Name="SnippetButton" MinWidth="118" MaxWidth="170" Height="34" Margin="0,2,2,2"
                  Classes="round">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" />
              <TextBlock x:Name="SnippetButtonText" Text="" FontSize="12"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          </StackPanel>

          <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                     VerticalAlignment="Center">
          <!--
            [EN] Right side: context usage, settings, upload and send (the icon buttons follow
                 the WPF dimensions).
            [ZH] 右侧：上下文占用 + 设置 + 上传 + 发送（图标按钮按 WPF 尺寸）。
          -->
          <Button x:Name="PromptLibraryButton" Width="34" Height="34" Margin="2" Classes="icon"
                  Content="🧩" FontSize="14"
                  AutomationProperties.AutomationId="PromptLibraryButton" />
          <Button x:Name="SettingsButton" Width="34" Height="34" Margin="2" Classes="icon"
                  Content="⚙" FontSize="14" />
          <Button x:Name="UploadButton" Width="34" Height="34" Margin="2" Classes="icon"
                  Content="📎" FontSize="14" />
          <Button x:Name="StopButton" Width="34" Height="34" Margin="2" Classes="icon"
                  Content="⏹" FontSize="14" IsVisible="False" />
          <!--
            [EN] The primary send affordance carries the accent fill as a local value, which is
                 immune to the neutral icon-button style overriding it.
            [ZH] 发送主操作以本地值承载强调色填充，避免被中性的图标按钮样式覆盖。
          -->
          <Button x:Name="SendButton" Width="40" Height="40" Margin="6,0,0,0"
                  Classes="icon" Content="➤" FontSize="16"
                  Background="{DynamicResource AccentBrush}"
                  BorderBrush="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource AccentForegroundBrush}" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>

    <!--
      [EN] (7) Lightweight status area: an icon plus a short phrase; clicking any item jumps to
           the matching setting or action, and the button on the right collapses the area.
      [ZH] ⑦ 轻量状态区：图标 + 简短短语，点击任一项跳到对应设置/动作；右侧按钮可折叠。
    -->
    <Border x:Name="StatusStrip" Classes="elevated" Grid.Row="5" Margin="0,4,0,0" CornerRadius="8"
            Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
            Padding="8,3">
      <Grid ColumnDefinitions="*,Auto">
        <!--
          [EN] The container must be a WrapPanel rather than a StackPanel: status items grow with
               every feature, and single-line horizontal flow would clip those that exceed the
               available width. The transition set below only touches opacity and the render
               transform, therefore collapsing the strip never invalidates measure or arrange of
               the surrounding chat layout.
          [ZH] 该容器必须是 WrapPanel 而非 StackPanel：状态项随功能增加，单行横排会裁掉超出可用宽度的项。
               下方过渡仅作用于不透明度与渲染变换，因此折叠状态区不会使周围对话布局的测量或排列失效。
        -->
        <WrapPanel x:Name="StatusStripItems" Grid.Column="0" Orientation="Horizontal"
                   RenderTransform="translate(0px, 0px)">
          <WrapPanel.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"
                                             Easing="CubicEaseOut" />
            </Transitions>
          </WrapPanel.Transitions>
          <!--
            [EN] v0.2.6 item 21: low-priority debug status, relocated from the title row. Only
                 high-frequency engineering noise (segment merging / batch progress) lands here;
                 anything with business meaning goes to the conversation area as a system
                 bubble instead. The width is capped and the full text stays in the tooltip,
                 so a long line can never stretch the status strip.
            [ZH] v0.2.6 第 21 项：从标题行迁入的低优先级调试状态。只有高频工程噪声（分段合并 /
                 批量进度）落在这里；具有业务含义的提示一律作为系统气泡进入对话区。宽度封顶，
                 完整文本放在悬停提示里，因此再长的行也不会撑开状态区。
          -->
          <TextBlock x:Name="StatusText" FontSize="11" Margin="4,0,8,0" IsVisible="False"
                     VerticalAlignment="Center" MaxWidth="300"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource SubTextBrush}"
                     AutomationProperties.AutomationId="StatusText" />
          <!--
            [EN] Reader status: only the current document token count and the model
                 ready state remain. Engineering metrics (KV cache, GPU layers,
                 physical memory, context ratio) were removed with their features.
            [ZH] Reader 状态区：仅保留当前文档 token 数与模型就绪状态。KV Cache、GPU
                 层数、物理内存、上下文占比等工程指标已随对应功能一并移除。
          -->
          <TextBlock x:Name="FileTokensText" FontSize="11" Margin="10,0,8,0"
                     IsVisible="False" VerticalAlignment="Center"
                     Foreground="{DynamicResource SubTextBrush}"
                     AutomationProperties.AutomationId="FileTokensText" />
          <!--
            [EN] Native ProgressBar for update downloads. It is hidden until a download
                 starts, becomes determinate as soon as the backend reports bytes, and is
                 hidden again on completion or failure.
            [ZH] 更新下载用的原生 ProgressBar。下载开始前隐藏；后端上报字节后切换为确定进度；
                 完成或失败后再次隐藏。
          -->
          <Button x:Name="StripUpdateButton" Classes="chip" Margin="6,0,0,0" IsVisible="False">
            <TextBlock x:Name="StripUpdateText" FontSize="11" />
          </Button>
          <ProgressBar x:Name="UpdateProgressBar" Width="96" Height="6" Minimum="0" Maximum="100"
                       Value="0" IsVisible="False" Margin="6,0,0,0" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="UpdateProgressBar" />
          <TextBlock x:Name="MetricsText" FontSize="11" Margin="6,0,0,0" IsVisible="False"
                     VerticalAlignment="Center" Opacity="0.85" />
        </WrapPanel>
        <Button x:Name="StripToggleButton" Grid.Column="1" Classes="chip" Margin="6,0,0,0">
          <TextBlock x:Name="StripToggleText" Text="▾" FontSize="11" />
        </Button>
      </Grid>
    </Border>

    <!--
      [EN] (8) Bottom transient area: only the command-format hint remains.
           v0.2.6 item 21 removed the notification toast entirely: operation feedback is now
           written into the conversation area as a copyable system bubble, so nothing flashes
           past at the bottom of the window any more.
      [ZH] ⑧ 底部临时区域：只剩指令格式提示。
           v0.2.6 第 21 项彻底移除通知条：操作反馈改为写入对话区的可复制系统气泡，
           窗口底部不再有一闪而过的文字。
    -->
    <StackPanel Grid.Row="6" Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
      <TextBlock x:Name="CommandBarHint" IsVisible="False" FontSize="12"
                 Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
      <!--
        [EN] v0.2.6 item 19: the permanent shortcut hint row was removed. It duplicated
             information already available through tooltips and the first-run guide, and it
             occupied a fixed slice of vertical space below the input box.
        [ZH] v0.2.6 第 19 项：常驻快捷键提示行已删除。它与 ToolTip 和首次使用引导重复，
             且在输入框下方长期占用一块固定高度。
      -->
    </StackPanel>

    <!--
      [EN] Snippet palette (the popup takes no layout space; PlacementTarget is assigned in code
           to avoid relying on name binding).
      [ZH] 常用语选择栏（Popup 不占布局；PlacementTarget 在代码里设，避免依赖名字绑定）。
    -->
    <Popup x:Name="SnippetPalette" Placement="Top" IsOpen="False" MaxHeight="260">
      <Border Background="{DynamicResource AppBackgroundBrush}"
              BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
              CornerRadius="10" MinWidth="280" MaxWidth="420" Padding="2" Margin="0,0,0,4">
        <StackPanel>
          <ListBox x:Name="SnippetList" Background="Transparent" BorderThickness="0"
                   MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="svc:Snippet">
                <StackPanel Margin="4,2">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding Text}" FontSize="11"
                             Foreground="{DynamicResource SubTextBrush}"
                             TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="SnippetHint" FontSize="11" Margin="6,2,6,4"
                     Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>

    <!--
      [EN] Command palette: it opens after "/" is typed in the command input box or the chat
           input box (PlacementTarget is assigned in code).
      [ZH] 指令选择栏：在指令输入框或聊天输入框输入 "/" 后弹出（PlacementTarget 在代码里设）。
    -->
    <Popup x:Name="CommandPalette" Placement="Top" IsOpen="False" MaxHeight="300">
      <Border Background="{DynamicResource AppBackgroundBrush}"
              BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
              CornerRadius="10" MinWidth="420" MaxWidth="620" Padding="2" Margin="0,0,0,4">
        <StackPanel>
          <ListBox x:Name="CommandList" Background="Transparent" BorderThickness="0"
                   MaxHeight="240">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="svc:CommandItem">
                <!--
                  [EN] Accessibility anchor: a screen reader should announce what the command
                       does, not read the three TextBlocks as one concatenated string.
                  [ZH] 无障碍锚点：屏幕阅读器读到的应该是“这条指令是干什么的”，
                       而不是把三个 TextBlock 拼起来念。
                -->
                <StackPanel Margin="4,2"
                            AutomationProperties.Name="{Binding Short}"
                            AutomationProperties.HelpText="{Binding Description}">
                  <TextBlock Text="{Binding Command}" FontWeight="Bold"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding Format}" FontSize="11"
                             Foreground="{DynamicResource SubTextBrush}" />
                  <TextBlock Text="{Binding Short}" FontSize="11"
                             Foreground="{DynamicResource SubTextBrush}"
                             TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="PaletteHint" FontSize="11" Margin="6,2,6,4"
                     Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>

    <!--
      [EN] v0.2.6 Part 3 prompt template panel: category filter, template list,
           apply, and an editor for user-defined templates. Built-in templates are
           read-only: selecting one fills the editor but the save and delete actions
           stay disabled, because the built-in table is versioned with the program.
      [ZH] v0.2.6 Part 3 提示词模板面板：分类筛选、模板列表、应用，以及用户自定义
           模板的编辑器。内置模板只读：选中后会填充编辑器，但保存与删除保持禁用，
           因为内置模板表与程序一同版本化。
    -->
    <Popup x:Name="PromptLibraryPanel" Placement="Top" IsOpen="False" MaxHeight="600">
      <Border Background="{DynamicResource AppBackgroundBrush}"
              BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
              CornerRadius="10" MinWidth="560" MaxWidth="760" Padding="10" Margin="0,0,0,4">
        <StackPanel Spacing="6">
          <TextBlock x:Name="PromptLibraryTitleText" FontWeight="Bold" FontSize="13"
                     Foreground="{DynamicResource AccentBrush}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <ComboBox x:Name="PromptCategoryCombo" Grid.Column="0"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="PromptCategoryCombo" />
            <Button x:Name="PromptNewButton" Grid.Column="1" Padding="12,3"
                    AutomationProperties.AutomationId="PromptNewButton" />
          </Grid>
          <ListBox x:Name="PromptTemplateList" MaxHeight="170" Background="Transparent"
                   BorderThickness="0"
                   AutomationProperties.AutomationId="PromptTemplateList" />
          <TextBlock x:Name="PromptTemplateHintText" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubTextBrush}" />
          <TextBox x:Name="PromptNameBox"
                   AutomationProperties.AutomationId="PromptNameBox" />
          <ComboBox x:Name="PromptEditCategoryCombo"
                    AutomationProperties.AutomationId="PromptEditCategoryCombo" />
          <TextBox x:Name="PromptInstructionBox" AcceptsReturn="True" MinHeight="72"
                   MaxHeight="120" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="PromptInstructionBox" />
          <TextBox x:Name="PromptRoleBox" MaxHeight="52" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="PromptRoleBox" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="PromptApplyButton" Classes="primary" Padding="12,3"
                    AutomationProperties.AutomationId="PromptApplyButton" />
            <Button x:Name="PromptSaveButton" Padding="12,3"
                    AutomationProperties.AutomationId="PromptSaveButton" />
            <Button x:Name="PromptDeleteButton" Padding="12,3"
                    AutomationProperties.AutomationId="PromptDeleteButton" />
          </StackPanel>
          <TextBlock x:Name="PromptStatusText" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubTextBrush}"
                     AutomationProperties.AutomationId="PromptStatusText" />
        </StackPanel>
      </Border>
    </Popup>
    </Grid>
  </Grid>
</Window>
