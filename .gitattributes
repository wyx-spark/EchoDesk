# 统一换行符：批处理与 PowerShell 脚本必须以 CRLF 落盘，
# 否则 cmd.exe 解析 label / 续行会出错（tools\set_metadata.bat 曾因此失败）。
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 其余文本文件统一 LF，避免不同平台产生无意义差异
*.py   text eol=lf
*.cs   text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.spec text eol=lf

# 二进制文件不做任何换行处理
*.ico  binary
*.png  binary
*.exe  binary
*.gguf binary
