<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:EchoDesk.Avalonia.Services"
        x:Class="EchoDesk.Avalonia.Views.MainWindow"
        Title="EchoDesk"
        Width="844" Height="581" MinWidth="744" MinHeight="501"
        Background="{DynamicResource AppBackgroundBrush}"
        DragDrop.AllowDrop="True">
  <!--
    主窗口（视觉对齐版）：骨架、间距、字号、圆角全部按 frontend/MainWindow.xaml 复刻。

    与上一版的差别（都是"看得见"的差别，不是重构）：
      · 窗口外边距 10（WPF 的 Grid Margin="10"），而不是整条通栏贴边；
      · 标题行是**平铺**在窗口底色上的一行，没有独立底板、没有分隔线；
      · 输入区是 12 圆角的白卡片，命令行是 8 圆角，状态区是 8 圆角；
      · 底部提示固定在 42 高的区域里居中（原来塞在工具条中间）；
      · 工具条按钮按 WPF 的尺寸：命令/常用语 170x34、上下文 130x30、
        设置/上传 34x34、发送 40x40（圆形胶囊），不再是带文字的方块按钮。

    功能面板与 WPF 版一一对应（指令面板、常用语面板、通知条、状态区、Agent 步骤区）。
  -->
  <Window.Styles>
    <!-- WPF RoundButton：Margin 2 · 圆角 17 · 1px 描边 · 灰底 -->
    <Style Selector="Button.round">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- 状态区/标题行的小胶囊：Padding 6,1 · 圆角 17 · 11 号字 -->
    <Style Selector="Button.chip">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- 纯图标按钮：字形走 Segoe UI Symbol，跟随前景色（彩色 emoji 在浅底上对比度不足） -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI Emoji, Segoe UI" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.brand">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>
  </Window.Styles>

  <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,42">

    <!-- ① 顶部横幅区（平台降级 / 无模型引导）：单独占第 0 行，不与标题行重叠 -->
    <StackPanel Grid.Row="0" Spacing="4">
    <Border x:Name="PlatformBanner" IsVisible="False"
            Background="{DynamicResource WarningBannerBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
      <StackPanel Spacing="2">
        <TextBlock x:Name="PlatformBannerText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="PlatformBannerDetail" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- ② 无模型引导条：后端"无模型就绪"时把三条路径直白列出来 -->
    <Border x:Name="GuideBanner" IsVisible="False"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
      <TextBlock x:Name="GuideText" TextWrapping="Wrap" FontSize="12" />
    </Border>
    </StackPanel>

    <!-- ③ 标题行：品牌 + 版本 + 出品方 + 关键状态（运行状态 / 模型 / 模式），平铺在窗口底色上 -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,Auto">
        <TextBlock x:Name="BrandText" Grid.Column="0" Text="📡 EchoDesk" Classes="brand"
                   VerticalAlignment="Bottom" />
        <TextBlock x:Name="VersionText" Grid.Column="1" Text="v0.2.1" FontSize="10" Margin="4,0,0,0"
                   VerticalAlignment="Bottom" Foreground="{DynamicResource SubTextBrush}" />
      </Grid>
      <TextBlock x:Name="PoweredText" Text="由熵寂工作室出品" FontSize="11" Margin="14,8,0,0"
                 VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
      <TextBlock x:Name="PlatformChip" IsVisible="False" />
      <TextBlock x:Name="StatusText" Grid.Column="4" FontSize="12" FontWeight="Bold"
                 VerticalAlignment="Center" Margin="18,0,0,0"
                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubTextBrush}" />
      <Button x:Name="ModelChip" Margin="14,0,0,0" Padding="8,2" VerticalAlignment="Center"
              Classes="round">
        <TextBlock x:Name="ModelText" Text="🧠 模型: ---" FontSize="11" MaxWidth="200" TextWrapping="NoWrap" />
      </Button>
      <Button x:Name="ModeChip" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Center"
              Classes="round">
        <TextBlock x:Name="ModeText" Text="MODE TEST" FontSize="11" TextWrapping="NoWrap" />
      </Button>
      <!-- 以下四个控件在 WPF 版主窗口里**不存在**（只在设置-常规页）。保留为隐藏状态，
           既不影响观感，也不丢键盘快捷方式（Ctrl+± / Ctrl+T 仍走同一批处理函数）。 -->
      <Button x:Name="FontDownButton" IsVisible="False" Classes="chip" Content="A-" />
      <Button x:Name="FontUpButton" IsVisible="False" Classes="chip" Content="A+" />
      <Button x:Name="ThemeButton" IsVisible="False" Classes="chip" Content="🌓" />
      <ComboBox x:Name="LangCombo" IsVisible="False" MinWidth="118" />
    </StackPanel>

    <!-- ④ 消息列表（支持 Ctrl+滚轮调节字号） -->
    <ScrollViewer x:Name="MessageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="MessagePanel" Orientation="Vertical" />
    </ScrollViewer>

    <!-- ⑤ 指令输入行：默认隐藏，点击左下角命令按钮后显示 -->
    <Border x:Name="CommandInputRow" Grid.Row="3" Margin="0,6,0,0" CornerRadius="8"
            IsVisible="False"
            Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
      <Grid>
        <TextBox x:Name="CommandInputBox" MinHeight="30" Margin="8,4"
                 VerticalContentAlignment="Center" Padding="6,0"
                 AcceptsReturn="False" BorderThickness="0" Background="Transparent"
                 PlaceholderText="在此处输入以“/”开头的指令 · 了解用法输入 /help" />
      </Grid>
    </Border>

    <!-- ⑥ 输入区：上半无框文本输入，下半圆形按钮工具栏 -->
    <Border x:Name="InputAreaBorder" Grid.Row="4" Margin="0,6,0,0" CornerRadius="12"
            Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
            Padding="12,8">
      <Grid RowDefinitions="Auto,Auto">

        <TextBox x:Name="InputBox" Grid.Row="0" MinHeight="36" MaxHeight="140"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 BorderThickness="0" Background="Transparent" />

        <Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

          <!-- 左侧：命令输入框开关按钮（加号旋转变叉号，固定宽度防跳动） -->
          <Button x:Name="CommandButton" Grid.Column="0" Width="170" Height="34" Classes="round">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="CommandIconText" Text="+" FontSize="18" FontWeight="Bold"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="CommandButtonText" Text="打开命令输入框" FontSize="12"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- 常用语按钮（同款开关文字，固定宽度） -->
          <Button x:Name="SnippetButton" Grid.Column="1" Width="170" Height="34" Margin="6,2,2,2"
                  Classes="round">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" />
              <TextBlock x:Name="SnippetButtonText" Text="打开常用语选择框" FontSize="12"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- 右侧：上下文占用 + 设置 + 上传 + 发送（图标按钮按 WPF 尺寸） -->
          <Button x:Name="ContextChip" Grid.Column="3" Height="30" MinWidth="130" Padding="14,0"
                  HorizontalAlignment="Left" Classes="round"
                  AutomationProperties.AutomationId="ContextChip">
            <TextBlock x:Name="ContextChipText" Text="上下文：---/---" FontSize="11" />
          </Button>
          <Button x:Name="SettingsButton" Grid.Column="4" Width="34" Height="34" Classes="icon"
                  Content="⚙" FontSize="14" />
          <Button x:Name="UploadButton" Grid.Column="5" Width="34" Height="34" Classes="icon"
                  Content="📎" FontSize="14" />
          <Button x:Name="StopButton" Grid.Column="6" Width="34" Height="34" Classes="icon"
                  Content="⏹" FontSize="14" IsVisible="False" />
          <Button x:Name="SendButton" Grid.Column="7" Width="40" Height="40" Margin="8,0,0,0"
                  Classes="icon" Content="➤" FontSize="16" />
        </Grid>
      </Grid>
    </Border>

    <!-- ⑦ 轻量状态区：图标 + 简短短语，点击任一项跳到对应设置/动作；右侧按钮可折叠 -->
    <Border x:Name="StatusStrip" Grid.Row="5" Margin="0,4,0,0" CornerRadius="8"
            Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
            Padding="8,3">
      <Grid ColumnDefinitions="*,Auto">
        <!-- 必须是 WrapPanel 而不是 StackPanel：状态项随功能增加，单行横排超出可用宽度的项会被裁掉 -->
        <WrapPanel x:Name="StatusStripItems" Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="StripSearchButton" Classes="chip">
            <TextBlock x:Name="SearchText" Text="" FontSize="11" />
          </Button>
          <Button x:Name="StripAutomationButton" Classes="chip">
            <TextBlock x:Name="AutoText" Text="" FontSize="11" />
          </Button>
          <Button x:Name="StripMarketButton" Classes="chip">
            <TextBlock x:Name="MarketText" Text="" FontSize="11" />
          </Button>
          <Button x:Name="StripContextButton" Classes="chip">
            <TextBlock x:Name="StripContextText" Text="" FontSize="11" />
          </Button>
          <Button x:Name="StripKvButton" Classes="chip">
            <TextBlock x:Name="StripKvText" Text="💾 KV: ---" FontSize="11" />
          </Button>
          <Button x:Name="StripCapabilityButton" Classes="chip">
            <TextBlock x:Name="StripCapabilityText" Text="" FontSize="11" />
          </Button>
          <Button x:Name="StripCompactButton" Classes="chip">
            <TextBlock x:Name="StripCompactText" Text="" FontSize="11" />
          </Button>
          <Button x:Name="StripWarnButton" Classes="chip" IsVisible="False">
            <TextBlock x:Name="StripWarnText" Text="⚠️ 能力提示" FontSize="11" />
          </Button>
          <Button x:Name="StripUpdateButton" Classes="chip" Margin="6,0,0,0" IsVisible="False">
            <TextBlock x:Name="StripUpdateText" Text="🎉 新版本" FontSize="11" />
          </Button>
          <TextBlock x:Name="MetricsText" FontSize="11" Margin="6,0,0,0" IsVisible="False"
                     VerticalAlignment="Center" Opacity="0.85" />
        </WrapPanel>
        <Button x:Name="StripToggleButton" Grid.Column="1" Classes="chip" Margin="6,0,0,0">
          <TextBlock x:Name="StripToggleText" Text="▾" FontSize="11" />
        </Button>
      </Grid>
    </Border>

    <!-- ⑧ 底部提示（固定高度区）：通知提示与操作提示共用一行 -->
    <StackPanel Grid.Row="6" Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
      <TextBlock x:Name="CommandBarHint" IsVisible="False" FontSize="12"
                 Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
      <Border x:Name="ToastBorder" IsVisible="False" CornerRadius="10" Padding="12,4"
              HorizontalAlignment="Center" Margin="0,2,0,0"
              Background="{DynamicResource InputBackgroundBrush}"
              BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
        <TextBlock x:Name="ToastText" FontSize="12" TextTrimming="CharacterEllipsis"
                   MaxWidth="760" Foreground="{DynamicResource AccentBrush}" />
      </Border>
      <TextBlock x:Name="HintText" FontSize="12"
                 Foreground="{DynamicResource SubTextBrush}"
                 HorizontalAlignment="Center" Margin="0,2,0,0" />
    </StackPanel>

    <!-- 常用语选择栏（Popup 不占布局；PlacementTarget 在代码里设，避免依赖名字绑定） -->
    <Popup x:Name="SnippetPalette" Placement="Top" IsOpen="False" MaxHeight="260">
      <Border Background="{DynamicResource AppBackgroundBrush}"
              BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
              CornerRadius="10" MinWidth="280" MaxWidth="420" Padding="2" Margin="0,0,0,4">
        <StackPanel>
          <ListBox x:Name="SnippetList" Background="Transparent" BorderThickness="0"
                   MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="svc:Snippet">
                <StackPanel Margin="4,2">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding Text}" FontSize="11"
                             Foreground="{DynamicResource SubTextBrush}"
                             TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="SnippetHint" FontSize="11" Margin="6,2,6,4"
                     Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- 指令选择栏：在指令输入框或聊天输入框输入 "/" 后弹出（PlacementTarget 在代码里设） -->
    <Popup x:Name="CommandPalette" Placement="Top" IsOpen="False" MaxHeight="300">
      <Border Background="{DynamicResource AppBackgroundBrush}"
              BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
              CornerRadius="10" MinWidth="420" MaxWidth="620" Padding="2" Margin="0,0,0,4">
        <StackPanel>
          <ListBox x:Name="CommandList" Background="Transparent" BorderThickness="0"
                   MaxHeight="240">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="svc:CommandItem">
                <!-- 无障碍锚点：屏幕阅读器读到的应该是"这条指令是干什么的"，
                     而不是把三个 TextBlock 拼起来念。 -->
                <StackPanel Margin="4,2"
                            AutomationProperties.Name="{Binding Short}"
                            AutomationProperties.HelpText="{Binding Description}">
                  <TextBlock Text="{Binding Command}" FontWeight="Bold"
                             Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding Format}" FontSize="11"
                             Foreground="{DynamicResource SubTextBrush}" />
                  <TextBlock Text="{Binding Short}" FontSize="11"
                             Foreground="{DynamicResource SubTextBrush}"
                             TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="PaletteHint" FontSize="11" Margin="6,2,6,4"
                     Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
