<Window x:Class="EchoDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoDesk v0.2.0 — Powered by Void Entropia Studio"
        Height="620" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 底部提示区固定高度：弹出提示时不引起输入区上下移动 -->
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：版本号置于项目名右下角小字，再右侧为署名与状态 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📡 EchoDesk" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Grid.Column="1" Text="v0.2.0" FontSize="10" Margin="4,0,0,0"
                           VerticalAlignment="Bottom" Foreground="{DynamicResource SubTextBrush}"/>
            </Grid>
            <TextBlock Text="Powered by Void Entropia Studio" FontSize="11" Margin="14,8,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
            <!-- 状态栏：运行状态 / 模型 / 模式 / 搜索 / 自动化 / 市场连接状态 -->
            <TextBlock x:Name="StatusText" Text="正在启动后端..." Margin="18,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
            <TextBlock x:Name="ModelText" Text="模型: ---" Margin="14,0,0,0" MaxWidth="190"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}"
                       ToolTip="当前加载的本地模型"/>
            <TextBlock x:Name="ModeText" Text="模式: general" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
            <TextBlock x:Name="SearchText" Text="搜索: 关" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                       ToolTip="联网搜索开关（/search on|off）"/>
            <TextBlock x:Name="AutoText" Text="自动化: 关" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                       ToolTip="浏览器自动化状态"/>
            <TextBlock x:Name="MarketText" Text="市场: 未连接" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                       ToolTip="技能市场连接状态"/>
        </StackPanel>

        <!-- 消息列表（支持 Ctrl+滚轮调节字号） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="MessageScrollViewer"
                      PreviewMouseWheel="MessageScrollViewer_PreviewMouseWheel">
            <StackPanel x:Name="MessagePanel" Orientation="Vertical"/>
        </ScrollViewer>

        <!-- 指令输入行：默认隐藏，点击左下角命令按钮后显示 -->
        <Border x:Name="CommandInputRow" Grid.Row="2" Margin="0,6,0,0" CornerRadius="8"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <TextBox x:Name="CommandInputBox" MinHeight="30" Margin="8,4"
                         VerticalContentAlignment="Center" Padding="6,0"
                         AcceptsReturn="False" BorderThickness="0" Background="Transparent"
                         KeyDown="CommandInputBox_KeyDown"
                         TextChanged="CommandInputBox_TextChanged"/>
                <TextBlock x:Name="CommandPlaceholder"
                           Text="在此处输入以“/”开头的指令 · 了解用法输入 /help"
                           FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 输入区域（仿 DeepSeek-Harness：上半无框文本输入，下半圆形按钮工具栏） -->
        <Border x:Name="InputAreaBorder" Grid.Row="3" Margin="0,6,0,0" CornerRadius="12"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 上半部分：文本输入（无框） -->
                <TextBox x:Name="InputBox" Grid.Row="0" MinHeight="36" MaxHeight="140"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         BorderThickness="0" Background="Transparent"
                         KeyDown="InputBox_KeyDown"
                         TextChanged="InputBox_TextChanged"
                         GotKeyboardFocus="InputBox_GotKeyboardFocus"/>

                <!-- 下半部分：工具栏 -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：命令输入框开关按钮（加号旋转变叉号，固定宽度防跳动） -->
                    <Button x:Name="CommandButton" Grid.Column="0" Width="170" Height="34"
                            Style="{StaticResource RoundButton}"
                            Click="CommandButton_Click" ToolTip="命令输入框">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CommandIconText" Text="+" FontSize="18" FontWeight="Bold"
                                       RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="CommandIconRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="CommandButtonText" Text="打开命令输入框" FontSize="12"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 常用语按钮（同款开关文字，固定宽度） -->
                    <Button x:Name="SnippetButton" Grid.Column="1" Width="170" Height="34" Margin="6,2,2,2"
                            Style="{StaticResource RoundButton}"
                            Click="SnippetButton_Click" ToolTip="常用语选择框">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SnippetButtonText" Text="打开常用语选择框" FontSize="12"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 右侧：上下文占用（按钮样式，随内容自动调宽，点击刷新）+ 设置 + 上传 + 发送 -->
                    <Button x:Name="ContextButton" Grid.Column="3" Height="30" MinWidth="130" Padding="14,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource RoundButton}"
                            Click="ContextButton_Click" ToolTip="点击刷新上下文占用">
                        <TextBlock x:Name="ContextText" Text="上下文：---/---" FontSize="11"/>
                    </Button>
                    <Button x:Name="SettingsButton" Grid.Column="4" Width="34" Height="34"
                            Style="{StaticResource RoundButton}" Content="⚙"
                            Click="SettingsButton_Click"
                            ToolTip="设置（Ctrl+, 打开设置 · Ctrl+M 打开技能市场）"/>
                    <Button x:Name="UploadButton" Grid.Column="5" Width="34" Height="34"
                            Style="{StaticResource RoundButton}" Content="📎"
                            Click="UploadButton_Click" ToolTip="上传文件 (Ctrl+O)"/>
                    <Button x:Name="SendButton" Grid.Column="6" Width="40" Height="40"
                            Style="{StaticResource RoundButton}" Content="➤" FontSize="16"
                            Click="SendButton_Click" ToolTip="发送 (Ctrl+Enter)"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 底部提示（固定高度区）：通知提示与操作提示共用一行 -->
        <StackPanel Grid.Row="4" Margin="0,3,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="CommandBarHint" Visibility="Collapsed" FontSize="12"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                       Text="💡 检测到指令格式：点击左下角「转移到命令输入框」按钮"/>
            <!-- 通知条：下载完成 / 自动化完成 / 错误提示，短暂显示后自动隐藏 -->
            <Border x:Name="ToastBorder" Visibility="Collapsed" CornerRadius="10" Padding="12,4"
                    HorizontalAlignment="Center" Margin="0,2,0,0"
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                <TextBlock x:Name="ToastText" FontSize="12" TextTrimming="CharacterEllipsis"
                           MaxWidth="760" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <TextBlock x:Name="HintText"
                       Text="💡 拖拽文件可上传 · Ctrl+Enter 发送 · Esc 停止 · Ctrl+L 清空 · Ctrl+滚轮 字号"
                       FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 常用语选择栏：显示在输入区域上方（命令栏可见时在命令栏上方） -->
        <Popup x:Name="SnippetPalette" Placement="Top" StaysOpen="True" AllowsTransparency="True" IsOpen="False">
            <Border Background="{DynamicResource WindowBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                    CornerRadius="10" MinWidth="280" MaxWidth="420"
                    Padding="2" Margin="0,0,0,4">
                <StackPanel>
                    <ListBox x:Name="SnippetList" Background="Transparent" BorderThickness="0"
                             MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonUp="SnippetList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Text}" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="/snippet add 名称 文本 可新增 · 空列表时先添加" FontSize="11"
                               Foreground="{DynamicResource SubTextBrush}" Margin="6,2,6,4"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 指令选择栏：在指令输入框输入 / 后弹出，支持 ↑↓/Tab/Enter/Esc -->
        <Popup x:Name="CommandPalette" PlacementTarget="{Binding ElementName=CommandInputBox}"
               Placement="Top" StaysOpen="True" AllowsTransparency="True" IsOpen="False">
            <Border Background="{DynamicResource WindowBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                    CornerRadius="10" Width="{Binding ActualWidth, ElementName=InputAreaBorder}"
                    Padding="2" Margin="0,0,0,4">
                <StackPanel>
                    <ListBox x:Name="CommandList" Background="Transparent" BorderThickness="0"
                             MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonUp="CommandList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Command}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Format}" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Format}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Short}" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="↑↓ 选择 · Tab 补全 · Enter 执行 · Esc 关闭" FontSize="11"
                               Foreground="{DynamicResource SubTextBrush}" Margin="6,2,6,4"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
