<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EchoDesk</AssemblyName>
    <RootNamespace>EchoDesk</RootNamespace>
    <!-- 单文件自包含发布时避免生成多余的 .pdb -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 版本与版权信息（rcedit 会在打包前进一步写入 Win32 版本资源，两者保持一致）
       Version and copyright metadata (rcedit additionally writes the Win32 version resource
       before packaging, so the two must agree).
       版本口径：v0.2.1 = 跨平台之前；v0.2.2 = 跨平台版本；v0.2.3 = Avalonia 主线，
       WPF 自 v0.2.3 起转入长期支持（LTS），只修安全与崩溃缺陷、不再加功能。
       Versioning: v0.2.1 = pre-cross-platform; v0.2.2 = cross-platform release; v0.2.3 = Avalonia
       as the main line, with WPF moving into long-term support (LTS) from v0.2.3 onwards —
       security and crash fixes only, no new features.
       权威来源仍是 backend/version.py 的 APP_VERSION（本文件是 MSBuild 无法直接读 Python 的
       已知重复点，升版本时必须同步，口径与 app_version_4() 一致：文件版本取数字核心段）。
       The authoritative source remains APP_VERSION in backend/version.py; this file is the known
       duplication point because MSBuild cannot read Python directly, so it must be kept in sync
       when the version changes. The rule matches app_version_4(): the file version takes the
       numeric core segment only.
       <Version> 允许预发布后缀，<AssemblyVersion>/<FileVersion> 只能是四段纯数字。
       <Version> may carry a prerelease suffix; <AssemblyVersion>/<FileVersion> must be four
       purely numeric fields. -->
  <PropertyGroup>
    <Version>0.2.3-alpha.1</Version>
    <AssemblyVersion>0.2.3.0</AssemblyVersion>
    <FileVersion>0.2.3.0</FileVersion>
    <!-- 固定写全，避免 ProductVersion 带 "+commit" 后缀混进界面与版本资源
         Written out in full so ProductVersion does not pick up a "+commit" suffix that would
         leak into the interface and the version resource. -->
    <InformationalVersion>0.2.3-alpha.1</InformationalVersion>
    <Product>EchoDesk</Product>
    <Company>Void Entropia Studio</Company>
    <Copyright>Copyright (C) Void Entropia Studio</Copyright>
    <!-- FileDescription（文件说明） -->
    <AssemblyTitle>EchoDesk - Local AI Desktop Assistant</AssemblyTitle>
    <!-- Comments（备注） -->
    <Description>Powered by Void Entropia Studio</Description>
    <ApplicationIcon>..\assets\EchoDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 无第三方包依赖：JSON 通信使用 .NET 内置的 System.Text.Json -->

  <!--
    界面语言包（任务书 任务三）。
    发布到程序根目录的 lang\ui\ 子目录（后端语言包在 lang\，两者互不覆盖），而不是嵌进程序集，这样：
      * 翻译者/社区可以直接往 lang\ui\ 里加 <locale>.json 贡献新语言，无需重新编译；
      * 语言包按需加载（只读当前语言与回退链），不会全部驻留内存（任务书 3.9）。
    语言包只有几 KB，对体积没有影响。
  -->
  <ItemGroup>
    <Content Include="Resources\Lang\*.json">
      <Link>lang\ui\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
