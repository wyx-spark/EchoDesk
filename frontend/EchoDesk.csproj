<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EchoDesk</AssemblyName>
    <RootNamespace>EchoDesk</RootNamespace>
    <!-- 单文件自包含发布时避免生成多余的 .pdb -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 版本与版权信息（rcedit 会在打包前进一步写入 Win32 版本资源，两者保持一致） -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <!-- 固定为 0.2.0.0，避免 ProductVersion 带 "+commit" 后缀 -->
    <InformationalVersion>0.2.0.0</InformationalVersion>
    <Product>EchoDesk</Product>
    <Company>Void Entropia Studio</Company>
    <Copyright>Copyright (C) Void Entropia Studio</Copyright>
    <!-- FileDescription（文件说明） -->
    <AssemblyTitle>EchoDesk - Local AI Desktop Assistant</AssemblyTitle>
    <!-- Comments（备注） -->
    <Description>Powered by Void Entropia Studio</Description>
    <ApplicationIcon>..\assets\EchoDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 无第三方包依赖：JSON 通信使用 .NET 内置的 System.Text.Json -->

</Project>
