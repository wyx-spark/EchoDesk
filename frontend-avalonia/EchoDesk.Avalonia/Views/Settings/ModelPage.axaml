<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.ModelPage">
  <!--
    [EN] Model page (v0.2.1 cross-platform development task 1, the eighth migrated module).
    [EN]
    [EN] Covers: **model profiles** (chip switching / download) and **inference parameters**
    [EN] (sampling parameters + preset + context mode). Control names and AutomationIds match
    [EN] the WPF version.
    [EN]
    [EN] **The model market (search / filtering / paging / details / download) was not
    [EN] migrated in this round** — it is a 908-line block on the WPF side (including
    [EN] streaming load and local-query paging). The bottom of the page carries an explicit
    [EN] note and an alternative.
    [ZH] 模型页（v0.2.1 跨平台研发任务 1，第 8 个迁移模块）。
    [ZH]
    [ZH] 覆盖：**模型档位**（胶囊切换 / 下载）与**推理参数**（采样参数 + 预设 + 上下文模式）。
    [ZH] 控件名与 AutomationId 与 WPF 版同名。
    [ZH]
    [ZH] **模型市场（搜索 / 筛选 / 分页 / 详情 / 下载）本轮未迁移** —— 那是 WPF 侧
    [ZH] 908 行的一整块（含流式加载与本地查询分页），页面底部有明确说明与替代做法。
  -->
  <!--
    [EN] Layout aligned with the WPF page (changed when the model market was completed this
    [EN] round): **the upper two blocks scroll on their own; the model market does not scroll.**
    [EN] Why not put the market into the same ScrollViewer: the paging control must stay
    [EN] "fixed below the result list and must not scroll with it" (development task 3); with
    [EN] whole-page scrolling the pager leaves the viewport. The WPF version uses the same
    [EN] structure (Row0 = Auto scroll area + Row1 = * market area).
    [ZH] 版式与 WPF 版对齐（本轮补全模型市场时改的）：**上面两块自己滚动、模型市场不滚**。
    [ZH] 为什么不把市场也塞进同一个 ScrollViewer：分页控件要求“固定在结果列表下方、不随列表滚动”
    [ZH]（研发任务 3），整页滚动的话分页条会跟着跑出视野；WPF 版用的是同一个结构
    [ZH]（Row0 = Auto 的滚动区 + Row1 = * 的市场区）。
  -->
  <Grid RowDefinitions="*,Auto">
    <!--
      [EN] Visual alignment: the WPF model page puts the "model market" **at the top**, the
      [EN] result list takes the remaining height, and the profile plus inference parameters
      [EN] sit below it (SettingsWindow.xaml rows 0-4 are the market, rows 5-8 are the profile
      [EN] and inference parameters). The earlier Avalonia version was reversed, so the reading
      [EN] order of the two pages in screenshots was completely different.
      [ZH] 视觉对齐：WPF 的模型页把“模型市场”放在**顶部**、结果列表吃剩余高度，
      [ZH] 档位与推理参数压在它下面（SettingsWindow.xaml 的行 0-4 是市场，行 5-8 是档位/推理）。
      [ZH] 原来的 Avalonia 版是反过来的，截图里两页的阅读顺序完全不同。
    -->
    <Grid x:Name="MarketHostGrid" Grid.Row="0" RowDefinitions="*">
      <TextBlock x:Name="MarketNotMigratedText" IsVisible="False" />
    </Grid>

    <ScrollViewer Grid.Row="1" MaxHeight="280"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="14,6,14,8" Spacing="8">

      <!-- [EN] (1) Model profiles -->
      <!-- [ZH] ① 模型档位 -->
      <!-- [EN] Same layout as WPF: the title and "Refresh profiles / + New profile" share one
           row, saving a full row of height. -->
      <!-- [ZH] 与 WPF 同排法：标题与「刷新档位 / ＋新建档位」在同一行，省掉一整行高度 -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">
        <TextBlock x:Name="ProfileTitle" Grid.Column="0" FontWeight="Bold" FontSize="14"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button x:Name="ProfileRefreshButton" Grid.Column="1" Padding="10,3" FontSize="11" Margin="0,0,6,0"
                AutomationProperties.AutomationId="ProfileRefreshButton" />
        <Button x:Name="ProfileNewButton" Grid.Column="2" Padding="10,3" FontSize="11"
                AutomationProperties.AutomationId="ProfileNewButton" />
      </Grid>
      <TextBlock x:Name="ProfileHintText" FontSize="11" TextWrapping="Wrap" Opacity="0.75" />
      <WrapPanel x:Name="ModelProfileChips" ItemSpacing="6" LineSpacing="6"
                 AutomationProperties.AutomationId="ModelProfileChips" />
      <TextBlock x:Name="ProfileStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="ProfileStatusText" />

      <!--
        [EN] Profile editor (completed in v0.2.2: the WPF side has "New / Edit / Delete
        [EN] profile", while the cross-platform version could previously only read).
        [EN] Compact one-line form: clicking "Edit" on a chip loads that profile, clicking
        [EN] "+ New profile" clears the form. Deliberately **no dialog**: the Avalonia side has
        [EN] no dialog framework, and in-place editing keeps the form visible next to the chips.
        [ZH] 档位编辑器（v0.2.2 补全：WPF 侧有「新建/编辑/删除档位」，跨平台版此前只能读）。
        [ZH] 紧凑一行式表单：点胶囊上的「编辑」把该档读进来，点「＋ 新建档位」清空表单。
        [ZH] 刻意**不做**弹窗：Avalonia 侧没有对话框体系，就地编辑还能与胶囊同屏对照。
      -->
      <Border x:Name="ProfileEditorPanel" IsVisible="False" CornerRadius="6" Padding="10,8"
              BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
              AutomationProperties.AutomationId="ProfileEditorPanel">
        <StackPanel Spacing="4">
          <TextBlock x:Name="ProfileEditorTitle" FontWeight="Bold" FontSize="12" />
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
            <TextBlock x:Name="ProfileAliasLabel" Grid.Row="0" VerticalAlignment="Center" FontSize="11" />
            <TextBox x:Name="ProfileAliasBox" Grid.Row="0" Grid.Column="1" Margin="0,2"
                     AutomationProperties.AutomationId="ProfileAliasBox" />
            <TextBlock x:Name="ProfilePathLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="11" />
            <TextBox x:Name="ProfilePathBox" Grid.Row="1" Grid.Column="1" Margin="0,2"
                     AutomationProperties.AutomationId="ProfilePathBox" />
            <TextBlock x:Name="ProfileRepoLabel" Grid.Row="2" VerticalAlignment="Center" FontSize="11" />
            <TextBox x:Name="ProfileRepoBox" Grid.Row="2" Grid.Column="1" Margin="0,2"
                     AutomationProperties.AutomationId="ProfileRepoBox" />
            <TextBlock x:Name="ProfileContextLabel" Grid.Row="3" VerticalAlignment="Center" FontSize="11" />
            <TextBox x:Name="ProfileContextBox" Grid.Row="3" Grid.Column="1" Margin="0,2"
                     AutomationProperties.AutomationId="ProfileContextBox" />
            <TextBlock x:Name="ProfileTempLabel" Grid.Row="4" VerticalAlignment="Center" FontSize="11" />
            <TextBox x:Name="ProfileTempBox" Grid.Row="4" Grid.Column="1" Margin="0,2"
                     AutomationProperties.AutomationId="ProfileTempBox" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ProfileSaveButton" Padding="14,4" FontSize="11"
                    AutomationProperties.AutomationId="ProfileSaveButton" />
            <Button x:Name="ProfileDeleteButton" Padding="14,4" FontSize="11"
                    AutomationProperties.AutomationId="ProfileDeleteButton" />
            <Button x:Name="ProfileCancelButton" Padding="14,4" FontSize="11"
                    AutomationProperties.AutomationId="ProfileCancelButton" />
          </StackPanel>
          <TextBlock x:Name="ProfileEditorStatus" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                     AutomationProperties.AutomationId="ProfileEditorStatus" />
        </StackPanel>
      </Border>

      <!--
        [EN] (2) Inference parameters: WPF puts this whole block in a card with an 8 px radius
        [EN] and a 1 px border, and lays it out in **two columns** (temperature / top-p,
        [EN] repetition penalty / max tokens), with the preset and the context strategy on the
        [EN] title row. A single vertical column needs scrolling in a 660-px-high window —
        [EN] about twice the height of the WPF side-by-side layout.
        [ZH] ② 推理参数：WPF 把这一整块放在 8 圆角、1px 描边的卡片里，
        [ZH] 而且**两列并排**（温度/核采样、重复惩罚/最大生成），预设与上下文策略在标题行上。
        [ZH] 单列竖排在 660 高的窗口里必须滚动才能看全 —— 与 WPF 并排的排法差了一倍高度。
      -->
      <Border CornerRadius="8" Padding="12,10" BorderThickness="1"
              Background="{DynamicResource InputBackgroundBrush}"
              BorderBrush="{DynamicResource InputBorderBrush}">
        <StackPanel Spacing="6">

          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
            <TextBlock x:Name="InferenceTitle" Grid.Column="0" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="PresetLabel" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Margin="0,0,6,0" />
            <ComboBox x:Name="PresetCombo" Grid.Column="2" Width="150" MinWidth="0"
                      AutomationProperties.AutomationId="PresetCombo" />
            <TextBlock x:Name="ContextModeLabel" Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                       Margin="16,0,6,0" />
            <ComboBox x:Name="ContextModeCombo" Grid.Column="4" Width="150" MinWidth="0"
                      AutomationProperties.AutomationId="ContextModeCombo" />
          </Grid>

          <!--
            [EN] Inference preset (v0.2.4 development task 2): fast / balanced / quality.
            [EN] It is **a different thing** from the "generation preset" above: the generation
            [EN] preset changes only sampling parameters (temperature / top_p / repetition
            [EN] penalty / max output), while the inference preset changes **build-time
            [EN] parameters** (initial context, usable-limit ratio, batch size and thread
            [EN] preference), so switching it must rebuild the engine. Putting them side by side
            [EN] would make users think they are one group, hence a separate row that also shows
            [EN] "native context / actually available" and the limiting reason on the right.
            [ZH] 推理预设（v0.2.4 研发任务 2）：极速 / 均衡 / 质量三档。
            [ZH] 与上面的「生成预设」是**两件不同的事**：生成预设只改采样参数（温度 / top_p /
            [ZH] 重复惩罚 / 最大输出），推理预设改的是**构建期参数**（初始上下文、可用上限比例、
            [ZH] 批大小与线程偏好），因此切换后必须重建引擎。两行并排会让用户以为它们是同一组，
            [ZH] 所以单独占一行，右侧同时给出「原生上下文 / 实际可用」以及限制原因。
          -->
          <Grid ColumnDefinitions="Auto,160,*,Auto">
            <TextBlock x:Name="InferenceProfileLabel" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Margin="0,0,6,0" />
            <ComboBox x:Name="InferenceProfileCombo" Grid.Column="1" Width="150" MinWidth="0"
                      AutomationProperties.AutomationId="InferenceProfileCombo" />
            <TextBlock x:Name="ContextWindowText" Grid.Column="2" VerticalAlignment="Center"
                       FontSize="11" Margin="12,0,0,0" TextWrapping="Wrap" Opacity="0.85"
                       AutomationProperties.AutomationId="ContextWindowText" />
          </Grid>

          <!-- [EN] Explicit override inputs (v0.2.4 task 3): the values default to
               [EN] the hardware recommendation and become the user's decision once
               [EN] edited. The warning icon explains an over-budget value but never
               [EN] blocks saving — that is the "dashboard, not nanny" contract.
               [ZH] 显式覆盖输入（v0.2.4 任务-3）：默认填入硬件推荐值，用户一旦编辑
               [ZH] 即成为其决定。警告图标解释超预算取值，但绝不阻止保存 —— 这正是
               [ZH] "仪表盘而非保姆"的约定。 -->
          <Grid ColumnDefinitions="Auto,110,24,Auto,110,24,*">
            <TextBlock x:Name="NctxLabel" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Margin="0,0,6,0" />
            <TextBox x:Name="NctxBox" Grid.Column="1" Width="100" FontSize="12"
                     AutomationProperties.AutomationId="NctxBox" />
            <TextBlock x:Name="NctxWarningIcon" Grid.Column="2" Text="⚠" IsVisible="False"
                       FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"
                       AutomationProperties.AutomationId="NctxWarningIcon" />
            <TextBlock x:Name="GpuLayersLabel" Grid.Column="3" VerticalAlignment="Center"
                       FontSize="12" Margin="12,0,6,0" />
            <TextBox x:Name="GpuLayersBox" Grid.Column="4" Width="100" FontSize="12"
                     AutomationProperties.AutomationId="GpuLayersBox" />
            <TextBlock x:Name="GpuLayersWarningIcon" Grid.Column="5" Text="⚠" IsVisible="False"
                       FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"
                       AutomationProperties.AutomationId="GpuLayersWarningIcon" />
            <TextBlock x:Name="OverrideHintText" Grid.Column="6" VerticalAlignment="Center"
                       FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap" Opacity="0.75" />
          </Grid>

          <TextBlock x:Name="OverrideWarningsText" FontSize="11" TextWrapping="Wrap"
                     IsVisible="False" AutomationProperties.AutomationId="OverrideWarningsText" />

          <Grid ColumnDefinitions="170,*,60,28,170,*,60" RowDefinitions="Auto,Auto">
            <TextBlock x:Name="TempLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Margin="0,3" />
            <Slider x:Name="TempSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    AutomationProperties.AutomationId="TempSlider" />
            <TextBlock x:Name="TempValueText" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                       FontSize="11" Margin="6,0,0,0" />

            <TextBlock x:Name="TopPLabel" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center"
                       FontSize="12" Margin="0,3" />
            <Slider x:Name="TopPSlider" Grid.Row="0" Grid.Column="5" Minimum="0.1" Maximum="1"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    AutomationProperties.AutomationId="TopPSlider" />
            <TextBlock x:Name="TopPValueText" Grid.Row="0" Grid.Column="6" VerticalAlignment="Center"
                       FontSize="11" Margin="6,0,0,0" />

            <TextBlock x:Name="RepeatLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Margin="0,3" />
            <Slider x:Name="RepeatSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="2"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    AutomationProperties.AutomationId="RepeatSlider" />
            <TextBlock x:Name="RepeatValueText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                       FontSize="11" Margin="6,0,0,0" />

            <TextBlock x:Name="MaxTokensLabel" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center"
                       FontSize="12" Margin="0,3" />
            <Slider x:Name="MaxTokensSlider" Grid.Row="1" Grid.Column="5" Minimum="64" Maximum="4096"
                    TickFrequency="64" IsSnapToTickEnabled="True"
                    AutomationProperties.AutomationId="MaxTokensSlider" />
            <TextBlock x:Name="MaxTokensValueText" Grid.Row="1" Grid.Column="6" VerticalAlignment="Center"
                       FontSize="11" Margin="6,0,0,0" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="ClarifyVagueCheck" FontSize="12"
                      AutomationProperties.AutomationId="ClarifyVagueCheck" />
            <CheckBox x:Name="SummaryCacheCheck" FontSize="12"
                      AutomationProperties.AutomationId="SummaryCacheCheck" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="InferenceSaveButton" Padding="16,5"
                    AutomationProperties.AutomationId="InferenceSaveButton" />
            <Button x:Name="InferenceReloadButton" Padding="12,5"
                    AutomationProperties.AutomationId="InferenceReloadButton" />
            <Button x:Name="InferenceResetButton" Padding="12,5"
                    AutomationProperties.AutomationId="InferenceResetButton" />
            <Button x:Name="InferenceTestLoadButton" Padding="12,5"
                    AutomationProperties.AutomationId="InferenceTestLoadButton" />
          </StackPanel>
          <TextBlock x:Name="InferenceStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                     AutomationProperties.AutomationId="InferenceStatusText" />
        </StackPanel>
      </Border>

      <!-- [EN] Hardware diagnostics (v0.2.4 task 3): a collapsed panel that
           [EN] makes the probe results and the recommended values visible instead
           [EN] of hiding them behind automatic decisions.
           [ZH] 硬件诊断（v0.2.4 任务-3）：折叠面板，把探测结果与推荐值摆到明面，
           [ZH] 而不是藏在自动决策背后。 -->
      <Expander x:Name="HardwareDiagnosticsExpander" IsExpanded="False"
                AutomationProperties.AutomationId="HardwareDiagnosticsExpander">
        <Expander.Header>
          <TextBlock x:Name="HardwareDiagnosticsTitle" FontWeight="Bold" FontSize="13" />
        </Expander.Header>
        <StackPanel Spacing="2" Margin="4,2,4,4">
          <TextBlock x:Name="HardwareCpuText" FontSize="11" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="HardwareCpuText" />
          <TextBlock x:Name="HardwareGpuText" FontSize="11" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="HardwareGpuText" />
          <TextBlock x:Name="HardwareRamText" FontSize="11" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="HardwareRamText" />
          <TextBlock x:Name="HardwareNativeText" FontSize="11" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="HardwareNativeText" />
          <TextBlock x:Name="HardwareBudgetText" FontSize="11" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="HardwareBudgetText" />
          <TextBlock x:Name="HardwareRecommendedText" FontSize="11" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="HardwareRecommendedText" />
          <TextBlock x:Name="HardwareWarningsText" FontSize="11" TextWrapping="Wrap"
                     IsVisible="False" AutomationProperties.AutomationId="HardwareWarningsText" />
        </StackPanel>
      </Expander>
      <!--
        [EN] (3) Local model library (completed in v0.2.2 batch 2, aligned with the WPF
        [EN] HubRegistry* block). The "model market" lists **what can be downloaded**; the
        [EN] "local model library" lists **what is on disk** — on the WPF side these have always
        [EN] been two different things, and the cross-platform version previously had only the
        [EN] market and no library. Control names and AutomationIds match WPF, so one probe can
        [EN] drive both interfaces.
        [ZH] ③ 本地模型库（v0.2.2 第 2 批补全，对齐 WPF 的 HubRegistry* 那一块）。
        [ZH]「模型市场」列的是**能下载什么**，「本地模型库」列的是**磁盘上有什么** —— WPF 侧
        [ZH] 一直是两块不同的东西，此前跨平台版只有市场、没有库。
        [ZH] 控件名与 AutomationId 与 WPF 同名，同一份探针可以驱动两套界面。
      -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <TextBlock x:Name="HubRegistryTitle" Grid.Column="0" FontWeight="Bold" FontSize="14"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="HubRegistryTitle" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="HubRescanButton" Padding="12,3" FontSize="11"
                  AutomationProperties.AutomationId="HubRescanButton" />
          <Button x:Name="HubRegistryRefreshButton" Padding="12,3" FontSize="11"
                  AutomationProperties.AutomationId="HubRegistryRefreshButton" />
        </StackPanel>
      </Grid>
      <Border CornerRadius="6" BorderThickness="1" MaxHeight="160"
              BorderBrush="{DynamicResource CardBorderBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="HubRegistryList" Spacing="2" Margin="6,4"
                      AutomationProperties.AutomationId="HubRegistryList" />
        </ScrollViewer>
      </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
