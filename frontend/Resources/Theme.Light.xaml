<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TextForeground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#483D8B"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#777777"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="UserBrush" Color="#1E90FF"/>
    <SolidColorBrush x:Key="AssistantBrush" Color="#2E8B57"/>
    <SolidColorBrush x:Key="SystemBrush" Color="#888888"/>
</ResourceDictionary>
