<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.ModelPage">
  <!--
    模型页（v0.2.1 跨平台-2 任务一，第 8 个迁移模块）。

    覆盖：**模型档位**（胶囊切换 / 下载）与**推理参数**（采样参数 + 预设 + 上下文模式）。
    控件名与 AutomationId 与 WPF 版同名。

    **模型市场（搜索 / 筛选 / 分页 / 详情 / 下载）本轮未迁移** —— 那是 WPF 侧
    908 行的一整块（含流式加载与本地查询分页），页面底部有明确说明与替代做法。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="10">

      <!-- ① 模型档位 -->
      <TextBlock x:Name="ProfileTitle" FontWeight="Bold" FontSize="14" />
      <TextBlock x:Name="ProfileHintText" FontSize="11" TextWrapping="Wrap" Opacity="0.75" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ProfileRefreshButton" Padding="10,3" FontSize="11"
                AutomationProperties.AutomationId="ProfileRefreshButton" />
      </StackPanel>
      <WrapPanel x:Name="ModelProfileChips" ItemSpacing="6" LineSpacing="6"
                 AutomationProperties.AutomationId="ModelProfileChips" />
      <TextBlock x:Name="ProfileStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="ProfileStatusText" />

      <!-- ② 推理参数 -->
      <TextBlock x:Name="InferenceTitle" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />

      <Grid ColumnDefinitions="190,*,70" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock x:Name="TempLabel" Grid.Row="0" VerticalAlignment="Center" FontSize="12" Margin="0,3" />
        <Slider x:Name="TempSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2"
                TickFrequency="0.05" IsSnapToTickEnabled="True"
                AutomationProperties.AutomationId="TempSlider" />
        <TextBlock x:Name="TempValueText" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="11" />
        <TextBlock x:Name="TopPLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Margin="0,3" />
        <Slider x:Name="TopPSlider" Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="1"
                TickFrequency="0.05" IsSnapToTickEnabled="True"
                AutomationProperties.AutomationId="TopPSlider" />
        <TextBlock x:Name="TopPValueText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" />
        <TextBlock x:Name="RepeatLabel" Grid.Row="2" VerticalAlignment="Center" FontSize="12" Margin="0,3" />
        <Slider x:Name="RepeatSlider" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="2"
                TickFrequency="0.05" IsSnapToTickEnabled="True"
                AutomationProperties.AutomationId="RepeatSlider" />
        <TextBlock x:Name="RepeatValueText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="11" />
        <TextBlock x:Name="MaxTokensLabel" Grid.Row="3" VerticalAlignment="Center" FontSize="12" Margin="0,3" />
        <Slider x:Name="MaxTokensSlider" Grid.Row="3" Grid.Column="1" Minimum="64" Maximum="4096"
                TickFrequency="64" IsSnapToTickEnabled="True"
                AutomationProperties.AutomationId="MaxTokensSlider" />
        <TextBlock x:Name="MaxTokensValueText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" FontSize="11" />
      </Grid>

      <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="PresetLabel" Grid.Row="0" VerticalAlignment="Center" FontSize="12" Margin="0,3" />
        <ComboBox x:Name="PresetCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="260"
                  AutomationProperties.AutomationId="PresetCombo" />
        <TextBlock x:Name="ContextModeLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="12" Margin="0,3" />
        <ComboBox x:Name="ContextModeCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="260"
                  AutomationProperties.AutomationId="ContextModeCombo" />
      </Grid>

      <CheckBox x:Name="ClarifyVagueCheck" FontSize="12"
                AutomationProperties.AutomationId="ClarifyVagueCheck" />
      <CheckBox x:Name="SummaryCacheCheck" FontSize="12"
                AutomationProperties.AutomationId="SummaryCacheCheck" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <Button x:Name="InferenceSaveButton" Padding="16,5"
                AutomationProperties.AutomationId="InferenceSaveButton" />
        <Button x:Name="InferenceReloadButton" Padding="12,5"
                AutomationProperties.AutomationId="InferenceReloadButton" />
        <Button x:Name="InferenceResetButton" Padding="12,5"
                AutomationProperties.AutomationId="InferenceResetButton" />
      </StackPanel>
      <TextBlock x:Name="InferenceStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="InferenceStatusText" />

      <!-- ③ 未迁移部分 -->
      <TextBlock x:Name="MarketNotMigratedText" FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                 Margin="0,10,0,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
