<Window x:Class="EchoDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:EchoDesk.Services"
        Title="EchoDesk"
        Height="620" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 输入框下方的轻量状态区（优化五）：可折叠，收起时只留一个切换按钮 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部提示区固定高度：弹出提示时不引起输入区上下移动 -->
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- 标题栏（优化五：只保留最关键的运行状态 / 模型 / 模式，
             搜索、自动化、市场、上下文等次要信息移到输入框下方的轻量状态区） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📡 EchoDesk" FontSize="20" FontWeight="Bold"
                           svc:Loc.Key="main.brand"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Grid.Column="1" x:Name="VersionText" Text="v0.2.1" FontSize="10" Margin="4,0,0,0"
                           VerticalAlignment="Bottom" Foreground="{DynamicResource SubTextBrush}"/>
            </Grid>
            <TextBlock Text="Powered by Void Entropia Studio" FontSize="11" Margin="14,8,0,0"
                       svc:Loc.Key="main.powered"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
            <!-- 关键状态：运行状态 / 模型 / 模式。
                 注意：这里给状态文本用 HelpText 说明含义，不能用 AutomationProperties.Name 覆盖，
                 否则屏幕阅读器读到的是"运行状态"而不是"已就绪"，反而丢失信息。 -->
            <TextBlock x:Name="StatusText" Text="正在启动后端..." Margin="18,0,0,0"
                       VerticalAlignment="Center" FontWeight="Bold"
                       svc:Loc.HelpKey="main.status.help"
                       Foreground="{DynamicResource SubTextBrush}"/>
            <Button x:Name="ModelChip" Margin="14,0,0,0" Padding="8,2" VerticalAlignment="Center"
                    Style="{StaticResource RoundButton}" Click="ModelChip_Click"
                    svc:Loc.TipKey="main.model.clickTip"
                    svc:Loc.HelpKey="main.model.help">
                <TextBlock x:Name="ModelText" Text="🧠 模型: ---" FontSize="11" MaxWidth="200"
                           svc:Loc.Key="main.model.placeholder"
                           TextTrimming="CharacterEllipsis"/>
            </Button>
            <Button x:Name="ModeChip" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Center"
                    Style="{StaticResource RoundButton}" Click="ModeChip_Click"
                    svc:Loc.TipKey="main.mode.clickTip"
                    svc:Loc.HelpKey="main.mode.help">
                <TextBlock x:Name="ModeText" Text="🛠️ 模式: general" FontSize="11"
                           svc:Loc.Key="main.mode.placeholder"/>
            </Button>
        </StackPanel>

        <!-- 消息列表（支持 Ctrl+滚轮调节字号） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="MessageScrollViewer"
                      PreviewMouseWheel="MessageScrollViewer_PreviewMouseWheel">
            <StackPanel x:Name="MessagePanel" Orientation="Vertical"/>
        </ScrollViewer>

        <!-- 指令输入行：默认隐藏，点击左下角命令按钮后显示 -->
        <Border x:Name="CommandInputRow" Grid.Row="2" Margin="0,6,0,0" CornerRadius="8"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <TextBox x:Name="CommandInputBox" MinHeight="30" Margin="8,4"
                         VerticalContentAlignment="Center" Padding="6,0"
                         AcceptsReturn="False" BorderThickness="0" Background="Transparent"
                         KeyDown="CommandInputBox_KeyDown"
                         TextChanged="CommandInputBox_TextChanged"/>
                <TextBlock x:Name="CommandPlaceholder"
                           Text="在此处输入以“/”开头的指令 · 了解用法输入 /help"
                           svc:Loc.Key="main.command.placeholder"
                           FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 输入区域（仿 DeepSeek-Harness：上半无框文本输入，下半圆形按钮工具栏） -->
        <Border x:Name="InputAreaBorder" Grid.Row="3" Margin="0,6,0,0" CornerRadius="12"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 上半部分：文本输入（无框） -->
                <TextBox x:Name="InputBox" Grid.Row="0" MinHeight="36" MaxHeight="140"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         BorderThickness="0" Background="Transparent"
                         KeyDown="InputBox_KeyDown"
                         TextChanged="InputBox_TextChanged"
                         GotKeyboardFocus="InputBox_GotKeyboardFocus"/>

                <!-- 下半部分：工具栏 -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：命令输入框开关按钮（加号旋转变叉号，固定宽度防跳动） -->
                    <Button x:Name="CommandButton" Grid.Column="0" Width="170" Height="34"
                            Style="{StaticResource RoundButton}"
                            Click="CommandButton_Click" svc:Loc.TipKey="main.command.tip">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CommandIconText" Text="+" FontSize="18" FontWeight="Bold"
                                       RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="CommandIconRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="CommandButtonText" Text="打开命令输入框" FontSize="12"
                                       svc:Loc.Key="main.command.open"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 常用语按钮（同款开关文字，固定宽度） -->
                    <Button x:Name="SnippetButton" Grid.Column="1" Width="170" Height="34" Margin="6,2,2,2"
                            Style="{StaticResource RoundButton}"
                            Click="SnippetButton_Click" svc:Loc.TipKey="main.snippet.tip">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SnippetButtonText" Text="打开常用语选择框" FontSize="12"
                                       svc:Loc.Key="main.snippet.open"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 右侧：上下文占用（按钮样式，随内容自动调宽，点击刷新）+ 设置 + 上传 + 发送 -->
                    <Button x:Name="ContextButton" Grid.Column="3" Height="30" MinWidth="130" Padding="14,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource RoundButton}"
                            Click="ContextButton_Click" ToolTip="点击刷新上下文占用"
                            svc:Loc.TipKey="main.context.buttonTip">
                        <TextBlock x:Name="ContextText" Text="上下文：---/---" FontSize="11"
                                   svc:Loc.Key="main.context.buttonIdle"/>
                    </Button>
                    <!-- 图标按钮：图标内容必须是 TextBlock + IconText 样式。
                         只给 Button 设 FontFamily 没用——模板生成的 TextBlock 会被
                         Styles.xaml 里的隐式 TextBlock 样式抢走字体，图标仍是彩色 emoji，
                         而在浅色按钮上彩色 emoji 的对比度只有 2.4:1（实测看不清）。 -->
                    <Button x:Name="SettingsButton" Grid.Column="4" Width="34" Height="34"
                            Style="{StaticResource RoundButton}"
                            Click="SettingsButton_Click"
                            svc:Loc.TipKey="main.button.settingsTip">
                        <TextBlock Style="{StaticResource IconText}" Text="⚙"/>
                    </Button>
                    <Button x:Name="UploadButton" Grid.Column="5" Width="34" Height="34"
                            Style="{StaticResource RoundButton}"
                            Click="UploadButton_Click" svc:Loc.TipKey="main.button.uploadTip">
                        <TextBlock Style="{StaticResource IconText}" Text="📎"/>
                    </Button>
                    <Button x:Name="SendButton" Grid.Column="6" Width="40" Height="40"
                            Style="{StaticResource RoundButton}"
                            Click="SendButton_Click" svc:Loc.TipKey="main.button.sendTip">
                        <TextBlock Style="{StaticResource IconText}" Text="➤" FontSize="16"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 轻量状态区（优化五）：图标 + 简短短语，点击任一项跳到对应设置/动作；
             右侧按钮可折叠收起，避免长期占用垂直空间 -->
        <Border x:Name="StatusStrip" Grid.Row="4" Margin="0,4,0,0" CornerRadius="8"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Padding="8,3"
                svc:Loc.HelpKey="main.strip.help">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 必须是 WrapPanel 而不是 StackPanel：
                     状态项随功能增加（修复四又加了"模型能力""压缩上下文""能力提示"三项），
                     单行横排时超出可用宽度的项会被裁掉 —— 而折叠按钮在右列，
                     被裁的项还会被它压住，用户既看不到也点不到（实测 700px 宽下
                     "压缩上下文"超出 28px、"能力提示"超出 117px）。
                     换成 WrapPanel 后空间不够就换行，所有项永远可见可点。 -->
                <WrapPanel x:Name="StatusStripItems" Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="StripSearchButton" Padding="6,1" Margin="0,0,4,0"
                            Style="{StaticResource RoundButton}" Click="StripSearchButton_Click"
                            svc:Loc.TipKey="main.strip.searchTip"
                            svc:Loc.HelpKey="main.strip.searchHelp">
                        <TextBlock x:Name="SearchText" Text="🔍 搜索：关" FontSize="11"
                                   svc:Loc.Key="main.strip.searchIdle"/>
                    </Button>
                    <Button x:Name="StripAutomationButton" Padding="6,1" Margin="0,0,4,0"
                            Style="{StaticResource RoundButton}" Click="StripAutomationButton_Click"
                            svc:Loc.TipKey="main.strip.automationTip"
                            svc:Loc.HelpKey="main.strip.autoHelp">
                        <TextBlock x:Name="AutoText" Text="⚙️ 自动化：关" FontSize="11"
                                   svc:Loc.Key="main.strip.autoIdle"/>
                    </Button>
                    <Button x:Name="StripMarketButton" Padding="6,1" Margin="0,0,4,0"
                            Style="{StaticResource RoundButton}" Click="StripMarketButton_Click"
                            svc:Loc.TipKey="main.strip.marketTip"
                            svc:Loc.HelpKey="main.strip.marketHelp">
                        <TextBlock x:Name="MarketText" Text="🌐 市场：未连接" FontSize="11"
                                   svc:Loc.Key="main.strip.marketIdle"/>
                    </Button>
                    <Button x:Name="StripContextButton" Padding="6,1" Margin="0,0,4,0"
                            Style="{StaticResource RoundButton}" Click="StripContextButton_Click"
                            svc:Loc.TipKey="main.strip.contextTip"
                            svc:Loc.HelpKey="main.strip.contextHelp">
                        <TextBlock x:Name="StripContextText" Text="📊 上下文 0%" FontSize="11"
                                   svc:Loc.Key="main.strip.contextIdle"/>
                    </Button>
                    <Button x:Name="StripKvButton" Padding="6,1" Margin="0,0,4,0"
                            Style="{StaticResource RoundButton}" Click="StripKvButton_Click"
                            svc:Loc.TipKey="main.strip.kvTip"
                            svc:Loc.HelpKey="main.strip.kvHelp">
                        <TextBlock x:Name="StripKvText" Text="💾 KV: ---" FontSize="11"/>
                    </Button>
                    <!-- 修复四（方向七：能力透明化）：模型参数量 / 量化 / 窗口 / 实测生成速度。
                         点一下打开设置窗口的模型 Tab 看完整能力与推荐配置。 -->
                    <Button x:Name="StripCapabilityButton" Padding="6,1" Margin="0,0,4,0"
                            Style="{StaticResource RoundButton}" Click="StripCapabilityButton_Click"
                            svc:Loc.TipKey="main.strip.capabilityTip"
                            svc:Loc.HelpKey="main.strip.capabilityHelp">
                        <TextBlock x:Name="StripCapabilityText" Text="🧠 模型: ---" FontSize="11"
                                   svc:Loc.Key="main.model.placeholder"/>
                    </Button>
                    <!-- 修复四（基础要求：手动压缩上下文按钮）：上下文快满时不用等自动触发 -->
                    <Button x:Name="StripCompactButton" Padding="6,1" Margin="0,0,4,0"
                            Style="{StaticResource RoundButton}" Click="StripCompactButton_Click"
                            svc:Loc.TipKey="main.strip.compactTip"
                            svc:Loc.HelpKey="main.strip.compactHelp">
                        <TextBlock x:Name="StripCompactText" Text="🗜 压缩上下文" FontSize="11"
                                   svc:Loc.Key="main.strip.compact"/>
                    </Button>
                    <!-- 能力提示：模型能力边界被触到时才出现（文档过长 / 速度过低 / 显存不足） -->
                    <Button x:Name="StripWarnButton" Padding="6,1" Margin="0,0,4,0"
                            Visibility="Collapsed"
                            Style="{StaticResource RoundButton}" Click="StripWarnButton_Click"
                            svc:Loc.TipKey="main.strip.warnTip">
                        <TextBlock x:Name="StripWarnText" Text="⚠️ 能力提示" FontSize="11"
                                   svc:Loc.Key="main.strip.warnIdle"/>
                    </Button>
                    <!-- 自动更新提示（v0.2.1 任务五 · 方案 A）：只有真的发现新版本时才出现；
                         点击打开 GitHub Releases 页面，不自动下载、不自动替换。 -->
                    <Button x:Name="StripUpdateButton" Padding="6,1" Margin="6,0,0,0"
                            Visibility="Collapsed"
                            Style="{StaticResource RoundButton}" Click="StripUpdateButton_Click">
                        <TextBlock x:Name="StripUpdateText" Text="🎉 新版本" FontSize="11"
                                   svc:Loc.Key="main.update.idle"/>
                    </Button>
                    <!-- 运行指标（v0.2.1 优化已知问题-2 任务七）：首 token 延迟 / 速度 /
                         token 数 / 总耗时。**全部由后端实测上报**（done.stats 与心跳
                         progress.stats），前端不做估算；生成中每 500ms 刷新一次。
                         默认隐藏：没有指标时（如无模型、请求失败清空）整块不占位。 -->
                    <TextBlock x:Name="MetricsText" FontSize="11" Margin="6,0,0,0"
                               Visibility="Collapsed" VerticalAlignment="Center"
                               Opacity="0.85"
                               svc:Loc.TipKey="main.metrics.tip"
                               AutomationProperties.AutomationId="RunMetrics"/>
                </WrapPanel>
                <Button x:Name="StripToggleButton" Grid.Column="1" Padding="6,1" Margin="6,0,0,0"
                        Style="{StaticResource RoundButton}" Click="StripToggleButton_Click"
                        svc:Loc.TipKey="main.strip.toggleTip">
                    <TextBlock x:Name="StripToggleText" Text="▾" FontSize="11"/>
                </Button>
            </Grid>
        </Border>

        <!-- 底部提示（固定高度区）：通知提示与操作提示共用一行 -->
        <StackPanel Grid.Row="5" Margin="0,3,0,0" HorizontalAlignment="Center">
            <TextBlock x:Name="CommandBarHint" Visibility="Collapsed" FontSize="12"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                       Text="💡 检测到指令格式：点击左下角「转移到命令输入框」按钮"
                       svc:Loc.Key="main.command.hint"/>
            <!-- 通知条：下载完成 / 自动化完成 / 错误提示，短暂显示后自动隐藏 -->
            <Border x:Name="ToastBorder" Visibility="Collapsed" CornerRadius="10" Padding="12,4"
                    HorizontalAlignment="Center" Margin="0,2,0,0"
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                <TextBlock x:Name="ToastText" FontSize="12" TextTrimming="CharacterEllipsis"
                           MaxWidth="760" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <TextBlock x:Name="HintText"
                       Text="💡 拖拽文件可上传 · Ctrl+Enter 发送 · Esc 停止 · Ctrl+L 清空 · Ctrl+滚轮 字号"
                       svc:Loc.Key="main.hint"
                       FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 常用语选择栏：显示在输入区域上方（命令栏可见时在命令栏上方） -->
        <Popup x:Name="SnippetPalette" Placement="Top" StaysOpen="True" AllowsTransparency="True" IsOpen="False">
            <Border Background="{DynamicResource WindowBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                    CornerRadius="10" MinWidth="280" MaxWidth="420"
                    Padding="2" Margin="0,0,0,4">
                <StackPanel>
                    <ListBox x:Name="SnippetList" Background="Transparent" BorderThickness="0"
                             MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonUp="SnippetList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Text}" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="/snippet add 名称 文本 可新增 · 空列表时先添加" FontSize="11"
                               svc:Loc.Key="main.snippet.hint"
                               Foreground="{DynamicResource SubTextBrush}" Margin="6,2,6,4"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 指令选择栏：在指令输入框输入 / 后弹出，支持 ↑↓/Tab/Enter/Esc -->
        <Popup x:Name="CommandPalette" PlacementTarget="{Binding ElementName=CommandInputBox}"
               Placement="Top" StaysOpen="True" AllowsTransparency="True" IsOpen="False">
            <Border Background="{DynamicResource WindowBackground}"
                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                    CornerRadius="10" Width="{Binding ActualWidth, ElementName=InputAreaBorder}"
                    Padding="2" Margin="0,0,0,4">
                <StackPanel>
                    <ListBox x:Name="CommandList" Background="Transparent" BorderThickness="0"
                             MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonUp="CommandList_PreviewMouseLeftButtonUp">
                        <!-- 每项都暴露可被屏幕阅读器读到的完整命令名，同时作为自动化测试的稳定锚点 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Command}"/>
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Command}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <!-- 明确显示完整名称与参数格式，避免把 /clear 与 /clearcache 看混 -->
                                    <TextBlock Text="{Binding Usage}" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}"/>
                                    <TextBlock Text="{Binding Short}" FontSize="11"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="↑↓ 选择 · Tab 补全 · Enter 执行（候选不唯一时先补全命令名再确认）· Esc 关闭"
                               FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="6,2,6,4"
                               svc:Loc.Key="main.paletteHint"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
