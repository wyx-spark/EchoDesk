<Window x:Class="EchoDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:EchoDesk.Services"
        Title="EchoDesk 设置"
        Height="660" Width="780" MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="Tabs">

            <!-- ================= 常规 ================= -->
            <TabItem Header="常规" svc:Loc.Key="settings.tab.general">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="外观与默认行为" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"
                                   svc:Loc.Key="settings.general.sectionAppearance"/>

                        <TextBlock Text="界面主题" Margin="0,4,0,4" Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.general.themeLabel"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="ThemeCombo" Width="200" HorizontalAlignment="Left"
                                      SelectionChanged="ThemeCombo_SelectionChanged"
                                      svc:Loc.HelpKey="settings.general.themeHelp"/>
                            <TextBlock x:Name="ThemeStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="主题与 emoji 显示即时生效，无需重启"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.general.themeNote"/>

                        <TextBlock Text="emoji 显示" Margin="0,12,0,4" Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.general.emojiLabel"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="EmojiCombo" Width="200" HorizontalAlignment="Left"
                                      SelectionChanged="EmojiCombo_SelectionChanged"
                                      svc:Loc.HelpKey="settings.general.emojiHelp"/>
                            <TextBlock x:Name="EmojiStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        </StackPanel>

                        <TextBlock Text="字体大小" Margin="0,14,0,4" Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.general.fontSize"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="FontSizeSlider" Width="320" Minimum="10" Maximum="24" Value="14"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="FontSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="FontSizeLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                        </StackPanel>

                        <TextBlock Text="默认对话模式（下次启动生效，也可用 /mode 即时切换）"
                                   Margin="0,14,0,4" Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.general.defaultMode"/>
                        <ComboBox x:Name="DefaultModeCombo" Width="260" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="ConfirmDestructiveCheck" Margin="0,14,0,0"
                                  Content="执行 /clear、/clearcache 等有副作用的指令前先确认（建议保持开启）"
                                  Checked="ConfirmDestructiveCheck_Changed" Unchecked="ConfirmDestructiveCheck_Changed"
                                  svc:Loc.Key="settings.general.confirmDestructive"
                                  svc:Loc.TipKey="settings.general.confirmDestructiveHelp"/>

                        <TextBlock Text="语言 / Language" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                                   svc:Loc.Key="settings.general.sectionLanguage"/>

                        <TextBlock Text="界面语言" Margin="0,0,0,4" Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.general.language"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="LanguageCombo" Width="260" HorizontalAlignment="Left"
                                      SelectionChanged="LanguageCombo_SelectionChanged"/>
                        </StackPanel>
                        <TextBlock Text="切换后界面、错误提示与指令帮助立即生效，无需重启"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.general.languageHelp"/>

                        <TextBlock Text="语言包" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                   svc:Loc.Key="settings.general.sectionLanguagePack"/>
                        <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LangPackText" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="↻ 重新加载语言包" Padding="10,3" FontSize="11"
                                            Style="{StaticResource RoundButton}" Click="ReloadLangButton_Click"
                                            ToolTip="翻译者改完语言包文件后无需重启即可看到效果"/>
                                    <Button Content="📂 打开语言包目录" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                            Style="{StaticResource RoundButton}" Click="OpenLangDirButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" CornerRadius="8" Padding="12,10"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📌 界面与数据位置" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="PathsText" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 模型（新增四） ================= -->
            <TabItem Header="模型" svc:Loc.Key="settings.tab.model">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🧠 模型选择栏（Hugging Face GGUF 模型）"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <!-- 数据源 + Token -->
                    <Grid Grid.Row="1" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="数据源" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubTextBrush}"/>
                        <ComboBox x:Name="HubSourceCombo" Grid.Column="1" Width="170" Margin="6,0,0,0"
                                  SelectionChanged="HubSourceCombo_SelectionChanged"
                                  ToolTip="自动：优先镜像站，不可达时回退官方站"/>
                        <TextBlock Grid.Column="2" Text="Token" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{DynamicResource SubTextBrush}"/>
                        <PasswordBox x:Name="HubTokenBox" Grid.Column="3" Margin="6,0,0,0" Padding="6,4"
                                     ToolTip="下载需授权的 Gated 模型时填写；留空则读环境变量 HF_TOKEN"/>
                        <Button x:Name="HubSaveTokenButton" Grid.Column="4" Margin="8,0,0,0" Padding="12,4"
                                Content="保存 Token" Style="{StaticResource RoundButton}"
                                Click="HubSaveTokenButton_Click"/>
                        <Button x:Name="HubOpenDirButton" Grid.Column="5" Margin="8,0,0,0" Padding="12,4"
                                Content="模型目录" Style="{StaticResource RoundButton}"
                                Click="HubOpenDirButton_Click"
                                ToolTip="在文件资源管理器中打开本地模型库目录"/>
                    </Grid>

                    <!-- 搜索行（任务二：关键字回车/按钮触发"取全部结果"） -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HubSearchBox" Grid.Column="0" Padding="6,4"
                                 KeyDown="HubSearchBox_KeyDown"
                                 svc:Loc.TipKey="settings.model.tipKeyword"/>
                        <ComboBox x:Name="HubSortCombo" Grid.Column="1" Width="128" Margin="8,0,0,0"
                                  SelectionChanged="HubSortChanged" MinWidth="104"
                                  svc:Loc.TipKey="settings.model.tipSort"/>
                        <Button x:Name="HubSearchButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
                                Style="{StaticResource RoundButton}"
                                Click="HubSearchButton_Click"
                                svc:Loc.Key="settings.model.actionSearch"
                                svc:Loc.TipKey="settings.model.tipSearch"/>
                        <Button x:Name="HubRefreshButton" Grid.Column="3" Margin="6,0,0,0" Padding="12,4"
                                Style="{StaticResource RoundButton}"
                                Click="HubRefreshButton_Click"
                                svc:Loc.Key="settings.model.actionRefresh"
                                svc:Loc.TipKey="settings.model.tipRefresh"/>
                        <Button x:Name="HubMoreButton" Grid.Column="4" Margin="6,0,0,0" Padding="12,4"
                                Style="{StaticResource RoundButton}"
                                Visibility="Collapsed" Click="HubMoreButton_Click"
                                svc:Loc.Key="settings.model.actionMore"
                                svc:Loc.TipKey="settings.model.tipMore"/>
                        <Button x:Name="HubStopButton" Grid.Column="5" Margin="6,0,0,0" Padding="12,4"
                                Style="{StaticResource RoundButton}"
                                Visibility="Collapsed" Click="HubStopButton_Click"
                                svc:Loc.Key="settings.model.actionStop"
                                svc:Loc.TipKey="settings.model.tipStop"/>
                    </Grid>

                    <!-- 本地筛选 + 结构化筛选（任务四、五）：改动只重算本地结果，不重新请求远端 -->
                    <Expander x:Name="HubFilterExpander" Grid.Row="3" Margin="0,0,0,8"
                              IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎛️ 本地筛选与排序" FontWeight="Bold"
                                           svc:Loc.Key="settings.model.filterTitle"/>
                                <TextBlock x:Name="HubFilterSummary" Margin="6,0,0,0" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="本地筛选" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           svc:Loc.Key="settings.model.localFilterLabel"/>
                                <TextBox x:Name="HubFilterBox" Width="240" Margin="6,0,0,0" Padding="6,4"
                                         TextChanged="HubFilterBox_TextChanged"
                                         svc:Loc.TipKey="settings.model.tipLocalFilter"/>
                                <TextBlock x:Name="HubFilterHint" Margin="8,0,0,0" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                            </StackPanel>

                            <WrapPanel x:Name="HubParamFacet" Margin="0,6,0,0"/>
                            <WrapPanel x:Name="HubQuantFacet" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="HubUpdatedFacet" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="HubFlagFacet" Margin="0,6,0,0">
                                <TextBlock x:Name="HubInstalledLabel" Text="下载状态" VerticalAlignment="Center"
                                           FontSize="11" Margin="0,0,6,0"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           svc:Loc.Key="settings.model.facetInstalled"/>
                                <ComboBox x:Name="HubInstalledCombo" Width="130" Margin="0,0,12,0"
                                          SelectionChanged="HubFacetCombo_Changed"/>
                                <CheckBox x:Name="HubRecommendedCheck" VerticalAlignment="Center"
                                          Content="只看推荐" FontSize="11"
                                          Checked="HubFacetCheck_Click" Unchecked="HubFacetCheck_Click"/>
                                <Button x:Name="HubFilterResetButton" Padding="10,3"
                                        FontSize="11" Margin="12,0,0,0"
                                        Style="{StaticResource RoundButton}" Click="HubFilterReset_Click"
                                        svc:Loc.Key="settings.model.actionResetFilter"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <!-- 结果列表 + 详情面板（列表区域独立滚动） -->
                    <Border Grid.Row="4" CornerRadius="8"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 详情面板：默认隐藏，点「详情」后展示可用量化文件 -->
                            <Border x:Name="HubDetailPanel" Grid.Row="0" Visibility="Collapsed"
                                    Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource InputBorder}" BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="HubDetailTitle" Grid.Column="0" FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <Button Grid.Column="1" Padding="10,3" FontSize="11"
                                                Style="{StaticResource RoundButton}" Click="HubCloseDetail_Click"
                                                svc:Loc.Key="settings.model.actionCloseDetail"/>
                                    </Grid>
                                    <ListBox x:Name="HubFileList" Grid.Row="1" MaxHeight="150" Margin="0,6,0,0"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                                                               MinWidth="80" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource SubTextBrush}"/>
                                                    <Button Grid.Column="2" Content="{Binding ActionText}"
                                                            Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                                            IsEnabled="{Binding CanAct}"
                                                            Style="{StaticResource RoundButton}"
                                                            Click="HubDownload_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 默认模型：钉在最上方、标注来源，**不计入下面的分页条数**（任务七） -->
                                <Border x:Name="HubPinnedRow" Grid.Row="0" Visibility="Collapsed"
                                        Margin="6,6,6,0" CornerRadius="6" Padding="8,5"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="HubPinnedTag" FontSize="11" FontWeight="Bold"
                                                           Margin="0,0,4,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock x:Name="HubPinnedName" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="HubPinnedMeta" FontSize="10"
                                                       TextWrapping="Wrap" MaxWidth="520"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                        <Button x:Name="HubPinnedDetailButton" Grid.Column="1" Padding="10,3"
                                                FontSize="11" VerticalAlignment="Center"
                                                Style="{StaticResource RoundButton}"
                                                Click="HubPinnedDetail_Click"
                                                svc:Loc.Key="settings.model.actionDetail"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="HubResultList" Background="Transparent" BorderThickness="0"
                                             Margin="2"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             MouseDoubleClick="HubResultList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Tag}" Margin="0,0,4,0"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding Badge}" Margin="8,0,0,0" FontSize="11"
                                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Meta}" FontSize="10"
                                                                   TextWrapping="Wrap" MaxWidth="540"
                                                                   Foreground="{DynamicResource SubTextBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Padding="10,3" FontSize="11"
                                                                Style="{StaticResource RoundButton}"
                                                                Click="HubDetail_Click" Tag="{Binding}"
                                                                svc:Loc.Key="settings.model.actionDetail"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- 空状态：区分"还没搜"与"本地筛完没结果"（后者给重新搜索远端的出口） -->
                                    <StackPanel x:Name="HubEmptyPanel"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="HubEmptyText"
                                                   Text="输入关键词搜索，或直接点「搜索」浏览热门 GGUF 模型"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
                                        <Button x:Name="HubRemoteRetryButton" Margin="0,8,0,0" Padding="12,4"
                                                HorizontalAlignment="Center"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RoundButton}"
                                                Click="HubSearchButton_Click"
                                                svc:Loc.Key="settings.model.researchRemote"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 分页控件（任务三）：固定在结果列表**下方**，不随列表滚动；窄窗口下自动换行 -->
                    <Border Grid.Row="5" Margin="0,6,0,0" CornerRadius="8" Padding="8,4"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                        <WrapPanel x:Name="HubPagerPanel" Orientation="Horizontal">
                            <TextBlock x:Name="HubPageInfoText" VerticalAlignment="Center" FontSize="11"
                                       Margin="0,2,0,2" FontWeight="Bold"/>
                            <TextBlock x:Name="HubTotalText" VerticalAlignment="Center" FontSize="11"
                                       Margin="10,2,0,2" Foreground="{DynamicResource SubTextBrush}"/>
                            <Button x:Name="HubFirstPageButton" Padding="8,3" FontSize="11"
                                    Margin="10,2,0,2" Style="{StaticResource RoundButton}"
                                    Click="HubFirstPage_Click"
                                    svc:Loc.Key="settings.model.pageFirst"/>
                            <Button x:Name="HubPrevPageButton" Padding="8,3" FontSize="11"
                                    Margin="4,2,0,2" Style="{StaticResource RoundButton}"
                                    Click="HubPrevPage_Click"
                                    svc:Loc.Key="settings.model.pagePrev"/>
                            <TextBlock x:Name="HubJumpLabel" Text="跳至" VerticalAlignment="Center" FontSize="11"
                                       Margin="10,2,0,2" Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.model.pageJumpLabel"/>
                            <TextBox x:Name="HubPageBox" Width="52" Padding="4,2" FontSize="11" Margin="4,2,0,2"
                                     KeyDown="HubPageBox_KeyDown"
                                     svc:Loc.TipKey="settings.model.tipPageBox"/>
                            <Button x:Name="HubGoPageButton" Padding="8,3" FontSize="11"
                                    Margin="4,2,0,2" Style="{StaticResource RoundButton}"
                                    Click="HubGoPage_Click"
                                    svc:Loc.Key="settings.model.pageGo"/>
                            <Button x:Name="HubNextPageButton" Padding="8,3" FontSize="11"
                                    Margin="10,2,0,2" Style="{StaticResource RoundButton}"
                                    Click="HubNextPage_Click"
                                    svc:Loc.Key="settings.model.pageNext"/>
                            <Button x:Name="HubLastPageButton" Padding="8,3" FontSize="11"
                                    Margin="4,2,0,2" Style="{StaticResource RoundButton}"
                                    Click="HubLastPage_Click"
                                    svc:Loc.Key="settings.model.pageLast"/>
                            <TextBlock x:Name="HubPageSizeLabel" Text="每页" VerticalAlignment="Center" FontSize="11"
                                       Margin="12,2,0,2" Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.model.pageSizeLabel"/>
                            <ComboBox x:Name="HubPageSizeCombo" Width="66" Margin="4,2,0,2" FontSize="11"
                                      SelectionChanged="HubPageSize_Changed"/>
                            <!-- 页码相关提示放在分页控件旁边而不是筛选面板里：筛选面板默认折叠，
                                 页码填错时用户根本看不到提示（UI 探针实测到过）。 -->
                            <TextBlock x:Name="HubPagerHint" VerticalAlignment="Center" FontSize="11"
                                       Margin="6,2,0,2" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                        </WrapPanel>
                    </Border>

                    <!-- 加载进度 + 下载进度 + 状态行 -->
                    <StackPanel Grid.Row="6" Margin="0,8,0,0">
                        <ProgressBar x:Name="HubLoadProgressBar" Height="4" Minimum="0" Maximum="100"
                                     Visibility="Collapsed"/>
                        <ProgressBar x:Name="HubProgressBar" Height="8" Minimum="0" Maximum="100"
                                     Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="HubProgressText" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                                       MaxWidth="520"/>
                            <Button x:Name="HubCancelButton" Padding="10,3" FontSize="11"
                                    Margin="10,0,0,0" Visibility="Collapsed"
                                    Style="{StaticResource RoundButton}" Click="HubCancelButton_Click"
                                    svc:Loc.Key="settings.model.actionCancelDownload"/>
                        </StackPanel>
                        <TextBlock x:Name="HubStatusText" Margin="0,4,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                                   Text="尚未搜索。点「搜索」浏览热门 GGUF 模型，或在详情中选择量化版本下载。"/>
                    </StackPanel>

                    <!-- 模型库 -->
                    <Grid Grid.Row="7" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HubRegistryTitle" Grid.Column="0" FontWeight="Bold"
                                       VerticalAlignment="Center" Text="📚 本地模型库"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- 任务二：手工放入 .gguf 后的入口（扫描到即可加载，无需重启程序） -->
                                <Button x:Name="HubRescanButton" Padding="12,3" FontSize="11" Margin="0,0,8,0"
                                        Style="{StaticResource RoundButton}"
                                        Click="HubRescanButton_Click"
                                        svc:Loc.Key="settings.model.actionRescan"/>
                                <Button x:Name="HubRegistryRefreshButton" Padding="12,3" FontSize="11"
                                        Style="{StaticResource RoundButton}"
                                        Click="HubRegistryRefreshButton_Click"
                                        svc:Loc.Key="settings.model.actionRefreshRegistry"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="8" MaxHeight="150"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <ListBox x:Name="HubRegistryList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding CurrentBadge}" Margin="8,0,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Meta}" FontSize="10"
                                                           Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                                                       MinWidth="80" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <!-- 任务五：热加载入口（无需重启程序） -->
                                            <Button Grid.Column="2" Content="{Binding LoadText}" Padding="10,3"
                                                    FontSize="11" Margin="8,0,0,0" IsEnabled="{Binding CanLoad}"
                                                    Style="{StaticResource RoundButton}"
                                                    Click="HubLoad_Click" Tag="{Binding}"/>
                                            <Button Grid.Column="3" Padding="10,3" FontSize="11"
                                                    Margin="8,0,0,0" IsEnabled="{Binding CanDelete}"
                                                    Style="{StaticResource RoundButton}"
                                                    Click="HubDelete_Click" Tag="{Binding}"
                                                    svc:Loc.Key="settings.model.actionDelete"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= 自动化 ================= -->
            <TabItem Header="自动化" svc:Loc.Key="settings.tab.automation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">

                        <!-- 安全协议：开启自动化开关的前置条件 -->
                        <Border CornerRadius="8" Padding="12,10"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🔒 安全协议（开启自动化前必须阅读并勾选）"
                                           FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="SafetyText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                                <CheckBox x:Name="SafetyCheck" Margin="0,10,0,0"
                                          Content="我已阅读并理解上述安全协议，自愿承担使用责任"
                                          Checked="SafetyCheck_Changed" Unchecked="SafetyCheck_Changed"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="AutomationEnabledCheck" Margin="0,12,0,0" IsEnabled="False"
                                  Content="启用自动化功能（运行前仍会要求安全协议已勾选）"
                                  svc:Loc.Key="settings.automation.label.enabled"/>

                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🧩 配置模板（选一个一键填入，再按实际网站微调）" FontWeight="Bold"
                                           svc:Loc.Key="settings.automation.templates"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="TemplateCombo" Grid.Column="0" Padding="6,4"
                                              ToolTip="预置模板来自语言包，随界面语言切换"/>
                                    <Button x:Name="ApplyTemplateButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                                            Content="套用模板" Style="{StaticResource RoundButton}"
                                            Click="ApplyTemplateButton_Click" svc:Loc.Key="settings.automation.applyTemplate"/>
                                    <Button x:Name="SaveTemplateButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
                                            Content="存为自定义模板" Style="{StaticResource RoundButton}"
                                            Click="SaveTemplateButton_Click" svc:Loc.Key="settings.automation.saveTemplate"/>
                                    <Button x:Name="AutomationGuideButton" Grid.Column="3" Margin="8,0,0,0" Padding="12,4"
                                            Content="📖 填写帮助" Style="{StaticResource RoundButton}"
                                            Click="AutomationGuideButton_Click"
                                            svc:Loc.Key="settings.automation.onlineHelp"
                                            svc:Loc.TipKey="settings.automation.onlineHelpTip"/>
                                </Grid>
                                <!-- 字段说明面板：默认就可见（折叠元素既不利于用户发现，也不在 UI 自动化树里），
             未聚焦任何字段时显示一句提示，聚焦后自动切换为该字段的说明与示例。 -->
        <Border x:Name="FieldHelpPanel" CornerRadius="6" Padding="10,8"
                                        Margin="0,8,0,0" Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="FieldHelpTitle" FontWeight="Bold" FontSize="12"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="FieldHelpBody" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="FieldHelpExample" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="任务列表网址" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center"
                                       svc:Loc.Key="settings.automation.label.taskListUrl"/>
                            <Button x:Name="HelpTaskListUrl" Content="?" Padding="5,0" Margin="6,0,0,0"
                                    FontSize="10" Height="18"
                                    Style="{StaticResource RoundButton}" Tag="task_list_url"
                                    Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                        </StackPanel>
                        <TextBox x:Name="TaskUrlBox" Padding="6,4" TextWrapping="NoWrap"
                                 GotKeyboardFocus="AutomationField_GotFocus" Tag="task_list_url"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock Text="任务列表元素位置" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center" svc:Loc.Key="settings.automation.label.taskListSelector"
                                       ToolTip="你想让程序点击的「任务链接」在页面上的位置"/>
                            <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                    Style="{StaticResource RoundButton}" Tag="task_list_selector"
                                    Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TaskSelectorBox" Grid.Column="0" Padding="6,4"
                                     GotKeyboardFocus="AutomationField_GotFocus" Tag="task_list_selector"/>
                            <Button x:Name="PickTaskListButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                                    Content="🎯 可视化选取" Style="{StaticResource RoundButton}"
                                    Tag="task_list" Click="PickSelectorButton_Click"
                                    svc:Loc.Key="settings.automation.pick" svc:Loc.TipKey="settings.automation.pickTip"/>
                            <Button x:Name="TestSelectorButton" Grid.Column="2" Margin="8,0,0,0"
                                    Padding="12,4" Content="测试选择器"
                                    Style="{StaticResource RoundButton}"
                                    Click="TestSelectorButton_Click"
                                    ToolTip="打开浏览器访问该网址，预览选择器匹配到的元素"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="任务行容器（可选）" Foreground="{DynamicResource SubTextBrush}"
                                               svc:Loc.Key="settings.automation.label.taskRowSelector"/>
                                    <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                            Style="{StaticResource RoundButton}" Tag="task_row_selector"
                                            Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                                    <Button Padding="6,0" Margin="6,0,0,0" Height="18"
                                            Style="{StaticResource RoundButton}" Tag="task_row"
                                            Click="PickSelectorButton_Click" ToolTip="可视化选取这一行">
                                        <TextBlock Style="{StaticResource IconText}" Text="🎯" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                                <TextBox x:Name="TaskRowBox" Padding="6,4" Margin="0,4,0,0"
                                         GotKeyboardFocus="AutomationField_GotFocus" Tag="task_row_selector"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="下一页按钮（可选，用于分页）" Foreground="{DynamicResource SubTextBrush}"
                                               svc:Loc.Key="settings.automation.label.nextPageSelector"/>
                                    <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                            Style="{StaticResource RoundButton}" Tag="next_page_selector"
                                            Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                                    <Button Padding="6,0" Margin="6,0,0,0" Height="18"
                                            Style="{StaticResource RoundButton}" Tag="next_page"
                                            Click="PickSelectorButton_Click" ToolTip="可视化选取下一页按钮">
                                        <TextBlock Style="{StaticResource IconText}" Text="🎯" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                                <TextBox x:Name="NextPageBox" Padding="6,4" Margin="0,4,0,0"
                                         GotKeyboardFocus="AutomationField_GotFocus" Tag="next_page_selector"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock Text="任务详情页文件元素位置" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center"
                                       svc:Loc.Key="settings.automation.label.taskDetailFileSelector"/>
                            <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                    Style="{StaticResource RoundButton}" Tag="task_detail_file_selector"
                                    Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FileSelectorBox" Grid.Column="0" Padding="6,4"
                                     GotKeyboardFocus="AutomationField_GotFocus" Tag="task_detail_file_selector"/>
                            <Button x:Name="PickDetailFileButton" Grid.Column="1" Padding="12,4" Margin="8,0,0,0"
                                    Content="🎯 可视化选取" Style="{StaticResource RoundButton}"
                                    Tag="task_detail_file" Click="PickSelectorButton_Click"
                                    svc:Loc.Key="settings.automation.pick"
                                    svc:Loc.TipKey="settings.automation.pickDetailTip"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock Text="需要预览的文件后缀（逗号分隔）" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center"
                                       svc:Loc.Key="settings.automation.label.fileExtensions"/>
                            <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                    Style="{StaticResource RoundButton}" Tag="file_extensions"
                                    Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                            <TextBlock Text="常用：合同 pdf, docx · 表格 xlsx, xls" FontSize="11" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.automation.extensionsHint"/>
                        </StackPanel>
                        <TextBox x:Name="ExtensionsBox" Padding="6,4"
                                 GotKeyboardFocus="AutomationField_GotFocus" Tag="file_extensions"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock Text="任务指令（与文件内容拼接后交给本地模型）"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                       svc:Loc.Key="settings.automation.label.instruction"/>
                            <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                    Style="{StaticResource RoundButton}" Tag="instruction"
                                    Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                        </StackPanel>
                        <TextBox x:Name="InstructionBox" Padding="6,4" Height="58"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 GotKeyboardFocus="AutomationField_GotFocus" Tag="instruction"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="运行参数" FontWeight="Bold" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最多任务数" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox x:Name="MaxTasksBox" Grid.Column="1" Width="70" Margin="6,0,0,0" Padding="6,4"/>
                            <TextBlock Grid.Column="3" Text="页面超时(ms)" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox x:Name="TimeoutBox" Grid.Column="4" Width="90" Margin="6,0,0,0" Padding="6,4"/>
                            <TextBlock Grid.Column="6" Text="重试次数" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox x:Name="RetriesBox" Grid.Column="7" Width="50" Margin="6,0,0,0" Padding="6,4"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="DedupeCheck" Content="任务去重（跳过已处理过的任务）"
                                      VerticalAlignment="Center"/>
                            <CheckBox x:Name="SaveResultsCheck" Content="保存结果到本地文件" Margin="20,0,0,0"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="结果保存" FontWeight="Bold" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="任务名称" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.automation.label.taskName"/>
                            <TextBox x:Name="TaskNameBox" Grid.Column="1" Margin="6,0,0,0" Padding="6,4" TextChanged="ResultsOption_TextChanged"
                                     GotKeyboardFocus="AutomationField_GotFocus" Tag="task_name"
                                     ToolTip="结果的第三层目录名；同名任务会自动追加序号避免覆盖"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="顶层文件夹名" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox x:Name="ResultsRootNameBox" Grid.Column="1" Margin="6,0,0,0" Padding="6,4" TextChanged="ResultsOption_TextChanged"
                                     ToolTip="结果根目录下的第一层文件夹名，默认「results」"/>
                            <Button x:Name="OpenResultsButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
                                    Content="打开结果目录" Style="{StaticResource RoundButton}"
                                    Click="OpenResultsButton_Click"
                                    ToolTip="在文件资源管理器中打开结果根目录"/>
                        </Grid>
                        <TextBlock Text="保存位置（留空 = 程序根目录）" Margin="0,10,0,4"
                                   Foreground="{DynamicResource SubTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ResultsLocationBox" Grid.Column="0" Padding="6,4" TextChanged="ResultsOption_TextChanged"
                                     ToolTip="可为绝对路径（如 D:\合同结果）或相对于程序根目录的路径"/>
                            <Button x:Name="BrowseResultsButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4"
                                    Content="浏览…" Style="{StaticResource RoundButton}"
                                    Click="BrowseResultsButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="ResultsPreviewText" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                                   Text="目录结构：结果根目录 / YYYY-MM-DD / 任务名称 / result.txt + 原始文件"/>

                        <TextBlock Text="定时触发" FontWeight="Bold" Margin="0,16,0,6"/>                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ScheduleCheck" Content="启用定时" VerticalAlignment="Center"/>
                            <TextBlock Text="每天执行时刻（HH:MM，逗号分隔）" Margin="16,0,8,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox x:Name="ScheduleTimesBox" Width="180" Padding="6,4"/>
                        </StackPanel>
                        <TextBlock Text="说明：定时任务要求程序保持运行（后端后台线程调度）；开机自启需在系统「启动」文件夹中放入快捷方式。"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"/>

                        <!-- 登录态（v0.2.1 自动化优化 任务一）：持久化数据目录 + 登录检测 + 清除 -->
                        <TextBlock Text="登录态" FontWeight="Bold" Margin="0,16,0,6"
                                   svc:Loc.Key="settings.automation.loginSection"/>
                        <TextBlock FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Text="自动化使用一个独立的浏览器数据目录保存登录状态（Cookie 等），不与你的日常浏览器共用。第一次运行时程序会打开浏览器让你手动登录，之后自动复用，不用每次重新登录。"
                                   svc:Loc.Key="settings.automation.loginHint"/>
                        <TextBlock x:Name="LoginStateText" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Text="登录态：正在读取…"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="数据目录（留空 = 程序目录下的 browser_profile）"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.automation.label.loginStateDir"/>
                            <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                    Style="{StaticResource RoundButton}" Tag="login_state_dir"
                                    Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LoginStateDirBox" Grid.Column="0" Padding="6,4"
                                     GotKeyboardFocus="AutomationField_GotFocus" Tag="login_state_dir"/>
                            <Button x:Name="ClearLoginStateButton" Grid.Column="1" Padding="12,4" Margin="8,0,0,0"
                                    Content="🗑 清除自动化登录态" Style="{StaticResource RoundButton}"
                                    Click="ClearLoginStateButton_Click"
                                    svc:Loc.Key="settings.automation.clearLogin"
                                    svc:Loc.TipKey="settings.automation.clearLoginTip"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBlock Text="登录后才出现的元素（可选，用于判断是否已登录）"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.automation.label.loginCheckSelector"/>
                            <Button Content="?" Padding="5,0" Margin="6,0,0,0" FontSize="10" Height="18"
                                    Style="{StaticResource RoundButton}" Tag="login_check_selector"
                                    Click="FieldHelp_Click" ToolTip="查看填写说明"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LoginCheckSelectorBox" Grid.Column="0" Padding="6,4"
                                     GotKeyboardFocus="AutomationField_GotFocus" Tag="login_check_selector"/>
                            <Button Grid.Column="1" Padding="12,4" Margin="8,0,0,0"
                                    Content="🎯 可视化选取" Style="{StaticResource RoundButton}"
                                    Tag="login_check" Click="PickSelectorButton_Click"
                                    svc:Loc.Key="settings.automation.pick"
                                    svc:Loc.TipKey="settings.automation.pickLoginTip"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBlock Text="登录页网址关键词（逗号分隔，兜底判断）"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.automation.label.loginKeywords"/>
                        </StackPanel>
                        <TextBox x:Name="LoginKeywordsBox" Padding="6,4"
                                 GotKeyboardFocus="AutomationField_GotFocus" Tag="login_url_keywords"
                                 ToolTip="地址里出现这些词就认为跳到了登录页，例如 login, signin, sso"/>
                        <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Text="多个目标站点可以共用同一个数据目录（浏览器按域名分别保存 Cookie），无需为每个站点单独配置。"
                                   svc:Loc.Key="settings.automation.loginMultiSite"/>

                        <!-- 运行控制 -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="RunOnceButton" Padding="14,6" Content="▶ 立即运行一次"
                                    Style="{StaticResource RoundButton}" Click="RunOnceButton_Click"
                                    svc:Loc.Key="settings.automation.runOnce"/>
                            <Button x:Name="StopAutomationButton" Padding="14,6" Margin="10,0,0,0"
                                    Content="⏹ 停止自动化" IsEnabled="False"
                                    Style="{StaticResource RoundButton}" Click="StopAutomationButton_Click"
                                    svc:Loc.Key="settings.automation.stopRun"/>
                            <Button x:Name="WizardButton" Padding="14,6" Margin="10,0,0,0"
                                    Content="🧪 测试向导" Style="{StaticResource RoundButton}"
                                    Click="WizardButton_Click"
                                    svc:Loc.Key="settings.automation.wizard"
                                    svc:Loc.TipKey="settings.automation.wizardTip"/>
                            <TextBlock x:Name="AutomationStatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" Text="状态：空闲"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="WizardStep1Button" Padding="10,4" Content="第 1 步"
                                    Style="{StaticResource RoundButton}" Tag="1" Click="WizardStep_Click"
                                    svc:Loc.Key="settings.automation.wizardStep1"/>
                            <Button x:Name="WizardStep2Button" Padding="10,4" Margin="8,0,0,0" Content="第 2 步"
                                    Style="{StaticResource RoundButton}" Tag="2" Click="WizardStep_Click"
                                    svc:Loc.Key="settings.automation.wizardStep2"/>
                            <Button x:Name="WizardStep3Button" Padding="10,4" Margin="8,0,0,0" Content="第 3 步"
                                    Style="{StaticResource RoundButton}" Tag="3" Click="WizardStep_Click"
                                    svc:Loc.Key="settings.automation.wizardStep3"/>
                            <Button x:Name="WizardStep4Button" Padding="10,4" Margin="8,0,0,0" Content="第 4 步"
                                    Style="{StaticResource RoundButton}" Tag="4" Click="WizardStep_Click"
                                    svc:Loc.Key="settings.automation.wizardStep4"/>
                            <Button x:Name="ExportConfigButton" Padding="10,4" Margin="16,0,0,0"
                                    Content="导出配置" Style="{StaticResource RoundButton}"
                                    Click="ExportConfigButton_Click"
                                    svc:Loc.Key="settings.automation.exportConfig"
                                    svc:Loc.TipKey="settings.automation.exportTip"/>
                            <Button x:Name="ImportConfigButton" Padding="10,4" Margin="8,0,0,0"
                                    Content="导入配置" Style="{StaticResource RoundButton}"
                                    Click="ImportConfigButton_Click"
                                    svc:Loc.Key="settings.automation.importConfig"
                                    svc:Loc.TipKey="settings.automation.importTip"/>
                        </StackPanel>

                        <TextBlock Text="运行日志" Margin="0,12,0,4" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBox x:Name="AutomationLogBox" Height="150" Padding="6,4" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                                 FontSize="11" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource InputBackground}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 技能市场 ================= -->
            <TabItem Header="技能市场" svc:Loc.Key="settings.tab.market">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🔌 技能市场（来自 GitHub topic: echodesk-plugin）"
                               FontSize="15" FontWeight="Bold"
                               svc:Loc.Key="settings.market.sectionSearch"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MarketSearchBox" Grid.Column="0" Padding="6,4"
                                 TextChanged="MarketSearchBox_TextChanged"
                                 ToolTip="输入关键词搜索技能（输入后 300ms 自动搜索）"/>
                        <ComboBox x:Name="MarketSortCombo" Grid.Column="1" Width="130" Margin="8,0,0,0"
                                  SelectionChanged="MarketSortCombo_SelectionChanged"/>
                        <Button x:Name="MarketRefreshButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,4"
                                Content="刷新" Style="{StaticResource RoundButton}"
                                Click="MarketRefreshButton_Click" svc:Loc.Key="settings.market.refresh"/>
                        <Button x:Name="MarketInstalledButton" Grid.Column="3" Margin="8,0,0,0" Padding="12,4"
                                Content="已安装" Style="{StaticResource RoundButton}"
                                Click="MarketInstalledButton_Click"
                                svc:Loc.Key="settings.market.installed"
                                ToolTip="查看本机已安装的技能"/>
                    </Grid>

                    <Border Grid.Row="2" CornerRadius="8"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                        <Grid>
                            <ListBox x:Name="MarketList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MouseDoubleClick="MarketList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Badge}" Margin="8,0,0,0" FontSize="11"
                                                               Foreground="{DynamicResource SubTextBrush}"/>
                                                    <TextBlock Text="{Binding Stars}" Margin="8,0,0,0" FontSize="11"
                                                               Foreground="{DynamicResource SubTextBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           TextWrapping="Wrap" MaxWidth="520"
                                                           Foreground="{DynamicResource SubTextBrush}"/>
                                                <TextBlock Text="{Binding Meta}" FontSize="10"
                                                           Foreground="{DynamicResource SubTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="详情" Padding="10,3" FontSize="11"
                                                        Style="{StaticResource RoundButton}"
                                                        Click="MarketDetail_Click" Tag="{Binding}"/>
                                                <Button Content="{Binding ActionText}" Padding="10,3" FontSize="11"
                                                        Margin="6,0,0,0" IsEnabled="{Binding CanAct}"
                                                        Style="{StaticResource RoundButton}"
                                                        Click="MarketInstall_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="MarketEmptyText" Text="输入关键词开始搜索，或点「刷新」浏览全部技能"
                                        svc:Loc.Key="settings.market.empty"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                                       MaxWidth="480" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="MarketStatusText" Grid.Row="3" Margin="0,8,0,0" FontSize="11"
                               TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                </Grid>
            </TabItem>

            <TabItem Header="已安装" svc:Loc.Key="settings.tab.installed">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🧩 已加载插件（技能）" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               svc:Loc.Key="settings.installed.sectionPlugins"/>

                    <TextBlock Grid.Row="1" x:Name="InstalledTipText" Margin="0,6,0,8" FontSize="11"
                               TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                               svc:Loc.Key="settings.installed.tip"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="SkillsRefreshButton" Padding="10,4" Content="🔄 刷新"
                                    Style="{StaticResource RoundButton}" Click="SkillsRefreshButton_Click"
                                    svc:Loc.Key="settings.installed.refresh"/>
                            <Button x:Name="SkillsReloadButton" Padding="10,4" Margin="8,0,0,0"
                                    Content="🔄 重载本地插件" Style="{StaticResource RoundButton}"
                                    Click="SkillsReloadButton_Click" svc:Loc.Key="settings.installed.reload"/>
                            <Button x:Name="SkillsInstallFolderButton" Padding="10,4" Margin="8,0,0,0"
                                    Content="📥 从文件夹安装" Style="{StaticResource RoundButton}"
                                    Click="SkillsInstallFolderButton_Click"
                                    svc:Loc.Key="settings.installed.installFolder"/>
                            <Button x:Name="SkillsScaffoldButton" Padding="10,4" Margin="8,0,0,0"
                                    Content="➕ 新建本地插件" Style="{StaticResource RoundButton}"
                                    Click="SkillsScaffoldButton_Click"
                                    svc:Loc.Key="settings.installed.newPlugin"/>
                        </StackPanel>
                        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SkillList" Margin="4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Margin="4,3" Padding="10,8"
                                                        Background="{DynamicResource WindowBackground}"
                                                        BorderBrush="{DynamicResource InputBorder}"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding SourceTag}" Margin="8,0,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{Binding StatusBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Meta}" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock Text="{Binding Capabilities}" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock Text="{Binding Permissions}" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SubTextBrush}"/>
                                                        <TextBlock Text="{Binding Overrode}" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding OverrodeVisibility}"/>
                                                        <TextBlock Text="{Binding Error}" FontSize="11"
                                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ErrorBrush}"
                                                                   Visibility="{Binding ErrorVisibility}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Button Content="错误详情" Padding="8,2" FontSize="11"
                                                                    Style="{StaticResource RoundButton}"
                                                                    Tag="{Binding}" Click="SkillDetail_Click"
                                                                    Visibility="{Binding ErrorVisibility}"
                                                                    svc:Loc.Key="settings.installed.detail"/>
                                                            <Button Content="📂 打开目录" Padding="8,2" FontSize="11"
                                                                    Margin="6,0,0,0"
                                                                    Style="{StaticResource RoundButton}"
                                                                    Tag="{Binding}" Click="SkillOpenDir_Click"
                                                                    svc:Loc.Key="settings.installed.openDir"/>
                                                            <Button Content="导出 zip" Padding="8,2" FontSize="11"
                                                                    Margin="6,0,0,0"
                                                                    Style="{StaticResource RoundButton}"
                                                                    Tag="{Binding}" Click="SkillExportZip_Click"
                                                                    svc:Loc.Key="settings.installed.exportZip"/>
                                                            <Button Content="发布自检" Padding="8,2" FontSize="11"
                                                                    Margin="6,0,0,0"
                                                                    Style="{StaticResource RoundButton}"
                                                                    Tag="{Binding}" Click="SkillPublishCheck_Click"
                                                                    svc:Loc.Key="settings.installed.publishCheck"/>
                                                            <Button Content="卸载" Padding="8,2" FontSize="11"
                                                                    Margin="6,0,0,0"
                                                                    Style="{StaticResource RoundButton}"
                                                                    Tag="{Binding}" Click="SkillUninstall_Click"
                                                                    svc:Loc.Key="settings.button.uninstall"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="SkillEmptyText" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           svc:Loc.Key="settings.installed.empty"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="SkillStatusText" Grid.Row="3" Margin="0,8,0,0" FontSize="11"
                               TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                </Grid>
            </TabItem>

            <!-- ================= 开发者（任务 2B.10） ================= -->
            <TabItem Header="开发者" svc:Loc.Key="settings.tab.developer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">

                        <TextBlock Text="开发者模式" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"
                                   svc:Loc.Key="settings.developer.sectionMode"/>
                        <CheckBox x:Name="DevModeCheck" Margin="0,4,0,0"
                                  Content="启用开发者模式（放宽验证 + 详细日志 + 热重载）"
                                  Checked="DevModeCheck_Changed" Unchecked="DevModeCheck_Changed"
                                  svc:Loc.Key="settings.developer.mode"/>
                        <TextBlock Text="放宽的是验证严格度，不是权限边界。"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.developer.modeShort"/>
                        <!-- 修复一：开关的当前状态 + 由谁决定，一句话说清"为什么是开/关" -->
                        <TextBlock x:Name="DevModeStatusText" FontSize="11" Margin="0,8,0,0"
                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForeground}"/>
                        <!-- 修复一：已启用的开发插件清单（关闭后应为空，便于用户确认确实关掉了） -->
                        <TextBlock x:Name="DevPluginListText" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock x:Name="DevApiText" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SubTextBrush}"/>

                        <TextBlock Text="插件目录" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                   svc:Loc.Key="settings.developer.sectionDirs"/>
                        <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="DevDirsText" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="📂 开发目录" Padding="10,3" FontSize="11"
                                            Style="{StaticResource RoundButton}"
                                            Click="OpenDevDirButton_Click"/>
                                    <Button Content="📂 安装目录" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                            Style="{StaticResource RoundButton}"
                                            Click="OpenInstallDirButton_Click"/>
                                    <Button Content="📂 示例插件" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                            Style="{StaticResource RoundButton}"
                                            Click="OpenExamplesDirButton_Click"/>
                                    <Button Content="📦 安装示例插件" Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                            Style="{StaticResource RoundButton}"
                                            Click="InstallExamplesButton_Click"
                                            svc:Loc.Key="settings.developer.installExamples"
                                            svc:Loc.TipKey="settings.developer.installExamplesTip"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="重载与日志" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                   svc:Loc.Key="settings.developer.sectionReload"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DevReloadButton" Content="🔄 重载本地插件" Padding="12,4"
                                    Style="{StaticResource RoundButton}" Click="SkillsReloadButton_Click"
                                    svc:Loc.Key="settings.developer.reload"/>
                            <Button Content="导出日志" Padding="12,4" Margin="8,0,0,0"
                                    Style="{StaticResource RoundButton}" Click="ExportDevLogButton_Click"
                                    svc:Loc.Key="settings.developer.exportLog"/>
                            <Button Content="🗑 清空日志" Padding="12,4" Margin="8,0,0,0"
                                    Style="{StaticResource RoundButton}" Click="ClearDevLogButton_Click"
                                    svc:Loc.Key="settings.developer.clearLog"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                            <TextBlock Text="显示最后" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.developer.logLines"/>
                            <ComboBox x:Name="LogLinesCombo" Width="90" Margin="6,0,0,0"
                                      SelectionChanged="LogLinesCombo_SelectionChanged"/>
                            <TextBlock Text="行" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.developer.logLinesUnit"/>
                            <Button Content="🔄 刷新日志" Padding="10,3" Margin="14,0,0,0" FontSize="11"
                                    Style="{StaticResource RoundButton}" Click="RefreshDevLogButton_Click"
                                    svc:Loc.Key="settings.installed.refresh"/>
                        </StackPanel>
                        <TextBox x:Name="DevLogBox" Height="200" Padding="6,4" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                 FontSize="11" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource InputBackground}"/>

                        <TextBlock Text="新建本地插件" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                   svc:Loc.Key="settings.developer.sectionScaffold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="插件 ID" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.installed.scaffoldId"/>
                            <TextBox x:Name="ScaffoldIdBox" Grid.Column="1" Margin="6,0,0,0" Padding="6,4"/>
                            <TextBlock Grid.Column="2" Text="显示名" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.installed.scaffoldName"/>
                            <TextBox x:Name="ScaffoldNameBox" Grid.Column="3" Margin="6,0,0,0" Padding="6,4"/>
                            <TextBlock Grid.Column="4" Text="作者" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       svc:Loc.Key="settings.installed.scaffoldAuthor"/>
                            <TextBox x:Name="ScaffoldAuthorBox" Grid.Column="5" Margin="6,0,0,0" Padding="6,4"/>
                            <Button x:Name="ScaffoldCreateButton" Grid.Column="6" Content="➕ 创建" Margin="12,0,0,0"
                                    Padding="12,4" Style="{StaticResource RoundButton}"
                                    Click="ScaffoldCreateButton_Click"
                                    svc:Loc.Key="settings.button.add"/>
                        </Grid>
                        <TextBlock Text="生成 skill.json、入口文件、语言包与 README；放进 skills_dev/ 即可被识别。"
                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.developer.scaffoldTip"/>

                        <TextBlock Text="本地插件清单（skills_local.json）" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                   svc:Loc.Key="settings.developer.sectionManifest"/>
                        <TextBlock Text="可指定任意路径的插件、设置别名与启用状态、调整加载顺序。相对路径以程序目录为基准。"
                                   FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   svc:Loc.Key="settings.developer.manifestTip"/>
                        <ItemsControl x:Name="ManifestList"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ManifestAddRow" Content="➕ 添加一行" Padding="12,4"
                                    Style="{StaticResource RoundButton}" Click="ManifestAddRow_Click"
                                    svc:Loc.Key="settings.developer.manifestAdd"/>
                            <Button Content="保存清单并重载" Padding="12,4" Margin="8,0,0,0"
                                    Style="{StaticResource RoundButton}" Click="ManifestSave_Click"
                                    svc:Loc.Key="settings.developer.manifestSave"/>
                            <Button Content="直接编辑 JSON 文件" Padding="12,4" Margin="8,0,0,0"
                                    Style="{StaticResource RoundButton}" Click="ManifestOpenRaw_Click"
                                    svc:Loc.Key="settings.developer.manifestOpenRaw"/>
                        </StackPanel>

                        <TextBlock Text="已挂接的自动化钩子" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                   svc:Loc.Key="settings.developer.sectionHooks"/>
                        <TextBlock x:Name="HooksText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"/>

                        <TextBlock Text="插件面板" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,18,0,10"
                                   svc:Loc.Key="settings.developer.sectionPanels"/>
                        <ItemsControl x:Name="PanelList"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 + 加载状态（加载状态只提示、不禁用界面，避免"看起来卡死"） -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LoadStateText" Grid.Column="0" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextWrapping="Wrap" FontSize="11"
                       Text="正在读取配置…" Foreground="{DynamicResource SubTextBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveHintText" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource SubTextBrush}"/>
                <Button x:Name="SaveButton" Padding="16,6" Content="保存设置"
                        Style="{StaticResource RoundButton}" Click="SaveButton_Click"
                        svc:Loc.Key="settings.button.save"/>
                <Button Padding="16,6" Margin="10,0,0,0" Content="关闭"
                        Style="{StaticResource RoundButton}" Click="CloseButton_Click"
                        svc:Loc.Key="settings.button.close"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
