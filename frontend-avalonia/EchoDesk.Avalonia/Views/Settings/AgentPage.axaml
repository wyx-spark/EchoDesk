<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.AgentPage">
  <!--
    智能体页（v0.2.1 跨平台-2 任务一，第 6 个迁移模块）。

    覆盖：**工具授权**（逐工具开关）、**最大步数**、**MCP 状态只读展示**。
    工具列表与 MCP 服务器列表都由代码构建（与 WPF 版一致：这两块是动态行，
    行数取决于后端返回什么）。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="10">

      <!-- ① 工具授权 -->
      <TextBlock x:Name="AgentToolsTitle" FontWeight="Bold" FontSize="14" />
      <TextBlock x:Name="AgentIntroText" FontSize="11" TextWrapping="Wrap" Opacity="0.7" />
      <TextBlock x:Name="AgentStateText" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"
                 AutomationProperties.AutomationId="AgentStateText" />
      <StackPanel x:Name="AgentToolList" Spacing="6" />

      <!-- ② 最大步数 -->
      <TextBlock x:Name="AgentStepsLabel" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="AgentStepsBox" Width="80" Padding="6,4"
                 AutomationProperties.AutomationId="AgentStepsBox" />
        <Button x:Name="AgentStepsApplyButton" Padding="12,4"
                AutomationProperties.AutomationId="AgentStepsApplyButton" />
        <TextBlock x:Name="AgentStepsHint" FontSize="11" VerticalAlignment="Center"
                   TextWrapping="Wrap" Opacity="0.7" MaxWidth="420" />
      </StackPanel>

      <!-- ③ MCP 状态（只读） -->
      <TextBlock x:Name="McpTitle" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />
      <TextBlock x:Name="McpSummaryText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="McpSummaryText" />
      <StackPanel x:Name="McpServerList" Spacing="6" />
      <TextBlock x:Name="McpNotMigratedText" FontSize="11" TextWrapping="Wrap" Opacity="0.7" />

      <!-- ④ 操作与状态 -->
      <Button x:Name="AgentReloadButton" HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0"
              AutomationProperties.AutomationId="AgentReloadButton" />
      <TextBlock x:Name="AgentStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="AgentStatusText" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
