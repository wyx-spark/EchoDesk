<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EchoDesk.Avalonia.Views.SettingsWindow"
        Title="EchoDesk 设置"
        Icon="/Assets/app.ico"
        Width="844" Height="581" MinWidth="680" MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowDecorations="BorderOnly">
  <!--
    [EN] Borderless settings shell. The native caption is removed while the resize frame and drop
         shadow remain, and window movement is performed by the platform move loop in the
         code-behind, so that drag, snap and DPI behaviour match the main window.
    [ZH] 无边框设置外壳。移除原生标题栏，同时保留缩放边框与投影；窗口移动由代码隐藏文件中的
         平台移动循环执行，使拖动、贴靠与 DPI 行为与主窗口一致。
    设置窗口骨架（v0.2.1 跨平台-2 任务一，第 1 个迁移模块）。

    与 WPF 版的对应关系：WPF 的 SettingsWindow 是一个 1321 行的 XAML + 六个分部类；
    这里改成「骨架 + 每页一个 UserControl」（Views/Settings/*），页签由代码按
    ISettingsPage 注册。理由见 Views/Settings/ISettingsPage.cs 顶部注释。

    骨架只负责四件事：页签容器、窗口状态记忆、底部状态与保存、主题/语言即时生效。
  -->
  <Grid RowDefinitions="Auto,*">

    <!--
      [EN] Custom caption shared with the main window: brand mark, localised title and the three
           caption controls.
      [ZH] 与主窗口同款的自定义标题栏：品牌标记、本地化标题与三个窗口控制按钮。
    -->
    <Border x:Name="TitleBar" Grid.Row="0" Height="44"
            Background="{DynamicResource TitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <!--
            [EN] Application identity mark: the official application icon is rendered directly,
                 so that the title bar and the operating-system task switcher present one identity.
            [ZH] 应用标识：直接渲染官方应用程序图标，使标题栏与操作系统任务切换器呈现同一标识。
          -->
          <Image Width="22" Height="22" Source="/Assets/app.ico" Stretch="Uniform" />
          <TextBlock x:Name="TitleBarTitle" Text="EchoDesk" FontSize="13" FontWeight="SemiBold"
                     LineHeight="16" TextWrapping="NoWrap"
                     Foreground="{DynamicResource TitleBarForegroundBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="TitleBarMinimizeButton" Classes="chrome"
                  AutomationProperties.AutomationId="TitleBarMinimizeButton">
            <Path Data="M1,5.5 L11,5.5" Stroke="{DynamicResource TitleBarForegroundBrush}"
                  StrokeThickness="1.2" />
          </Button>
          <Button x:Name="TitleBarMaximizeButton" Classes="chrome"
                  AutomationProperties.AutomationId="TitleBarMaximizeButton">
            <Panel Width="12" Height="12">
              <Path x:Name="MaximizeGlyph" Data="M1,1 L11,1 L11,11 L1,11 Z"
                    Stroke="{DynamicResource TitleBarForegroundBrush}" StrokeThickness="1.2" />
              <Path x:Name="RestoreGlyph" IsVisible="False"
                    Data="M4,1 L11,1 L11,8 M1,4 L8,4 L8,11 L1,11 Z"
                    Stroke="{DynamicResource TitleBarForegroundBrush}" StrokeThickness="1.2" />
            </Panel>
          </Button>
          <Button x:Name="TitleBarCloseButton" Classes="chrome close"
                  AutomationProperties.AutomationId="TitleBarCloseButton">
            <Path Data="M1,1 L11,11 M11,1 L1,11"
                  Stroke="{DynamicResource TitleBarCloseForegroundBrush}" StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!--
      [EN] Content entrance. The settings surface replaces the conversation surface while it is
           open; a 250 ms fade combined with a six-pixel vertical offset communicates that
           replacement without animating any measured property, therefore the conversation layout
           underneath is never invalidated.
      [ZH] 内容入场。设置界面在打开期间取代对话界面；250 毫秒淡入配合六像素垂直偏移即可传达这一
           替换关系，且不涉及任何参与测量的属性，因此底层对话布局绝不会失效。
    -->
    <Grid x:Name="ContentRoot" Grid.Row="1" RowDefinitions="*,Auto" Margin="12"
          Opacity="0" RenderTransform="translate(0px, 6px)">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"
                                         Easing="CubicEaseOut" />
        </Transitions>
      </Grid.Transitions>

    <!-- 底部：状态行 + 保存/关闭（与 WPF 版同位置、同 AutomationId） -->
    <Border Grid.Row="1" Padding="0" Margin="0,8,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock x:Name="LoadStateText" Grid.Column="0" VerticalAlignment="Center"
                   FontSize="12" Opacity="0.8"
                   AutomationProperties.AutomationId="LoadStateText" />
        <TextBlock x:Name="SaveHintText" Grid.Column="1" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="12,0" FontSize="12" Opacity="0.7"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.AutomationId="SaveHintText" />
        <Button x:Name="SaveButton" Grid.Column="2" Padding="18,6" CornerRadius="17"
                AutomationProperties.AutomationId="SaveButton" />
        <Button x:Name="CloseButton" Grid.Column="3" Padding="18,6" Margin="8,0,0,0" CornerRadius="17"
                AutomationProperties.AutomationId="CloseButton" />
      </Grid>
    </Border>

    <!-- 顶部：设置页静态提示（页签名由 TabControl 提供） -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="*">

      <!-- 页签容器：由代码注册 ISettingsPage，未迁移的页签显示明确的"未迁移"说明 -->
      <TabControl x:Name="Tabs" Grid.Row="0" Grid.Column="0" Padding="0"
                  AutomationProperties.AutomationId="Tabs" />

      <!--
        [EN] Field help panel. The panel must remain inspectable by the unattended probes, and it
             is used most frequently by the automation page.
        [ZH] 字段帮助面板。该面板必须保持可被无人值守探针检查，且在自动化页中的使用频率最高。
      -->
      <!--
        [EN] Field help side panel. Its opening and closing motion is expressed as a width
             transition combined with an opacity transition, which is the closest equivalent of
             the grid-length animation requested for sidebars: Avalonia does not provide a
             grid-length animator, while the panel width is a plain double and therefore fully
             animatable. The panel remains outside the layout flow of the tab content and only
             animates while a field receives focus or the panel is dismissed by the user.
        [ZH] 字段帮助侧面板。其开启与关闭动效由宽度过渡配合不透明度过渡表达，这是侧边栏所要求的
             网格长度动画最接近的等价实现：Avalonia 未提供网格长度动画器，而面板宽度是普通双精度值，
             因而完全可以参与动画。该面板不占据页签内容的布局流，且仅在字段获得焦点或用户关闭面板时
             才播放动效。
      -->
      <Border x:Name="FieldHelpPanel" Grid.Row="0" Grid.Column="1" Width="0" Opacity="0"
              IsVisible="False" Margin="0,6,12,12" Classes="elevated"
              ClipToBounds="True"
              Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12,10">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6">
            <TextBlock x:Name="FieldHelpTitle" FontWeight="Bold" FontSize="13"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FieldHelpBody" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock x:Name="FieldHelpExample" FontSize="11" TextWrapping="Wrap"
                       FontFamily="Consolas,Menlo,monospace" Opacity="0.8" />
            <Button x:Name="FieldHelpCloseButton" HorizontalAlignment="Left" Padding="10,3"
                    FontSize="11" />
          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>
    </Grid>
  </Grid>
</Window>
