<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.App"
             RequestedThemeVariant="Default">
  <!--
    [EN] Global style baseline for the Avalonia shell (v0.2.3 iteration 2).
    [ZH] Avalonia 外壳的全局样式基线（v0.2.3 研发任务-2）。
    [EN] Palette definitions now live in Themes/Light.axaml and Themes/Dark.axaml, while the
         immersive scrollbar lives in Themes/Controls.axaml and the core widget themes live in
         Themes/Widgets.axaml. This file is limited to the application-wide control styles that
         must remain identical across themes.
    [ZH] 色板定义现已迁移至 Themes/Light.axaml 与 Themes/Dark.axaml，沉浸式滚动条位于
         Themes/Controls.axaml，核心控件主题位于 Themes/Widgets.axaml。本文件仅保留跨主题必须
         保持一致的全局控件样式。
    [EN] Typography contract: Inter is the preferred Latin face with a Unicode-complete fallback
         chain and the base size is 15 px; body paragraphs use a 1.6x line height, applied by the
         Markdown renderer so that the ratio follows the configured paragraph size.
    [ZH] 排版约定：拉丁字形优先使用 Inter，并配置覆盖完整的回退链，基准字号为 15px；正文段落
         使用 1.6 倍行高，由 Markdown 渲染器按实际配置的段落字号施加，以保持比例一致。
  -->
  <Application.Styles>
    <FluentTheme />

    <!-- ================= 字体与排版 / Typography ================= -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>
    <!--
      [EN] The 1.6 line height is applied by the Markdown renderer to body paragraphs, where it is
           derived from the actual paragraph size. Applying it to every label would clip the fixed
           height status chips, hence no global LineHeight setter is defined.
      [ZH] 1.6 行高由 Markdown 渲染器按实际段落字号施加于正文段落。若对所有标签统一施加，
           会裁切固定高度的状态胶囊，因此此处不定义全局行高设置器。
    -->
    <Style Selector="Label">
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>

    <!--
      [EN] Button geometry, states and transitions are owned by Themes/Widgets.axaml. Only the
           title-bar caption variant remains here because it is a shell-specific exception to the
           general button contract.
      [ZH] 按钮的几何参数、状态与过渡均由 Themes/Widgets.axaml 统一治理。此处仅保留标题栏窗口按钮
           变体，因为它是一般按钮约定之外的外壳专属例外。
    -->
    <!--
      [EN] Caption buttons of the custom title bar. They occupy the full 44 px chrome strip,
           stay transparent at rest, and never inherit the default button margin.
      [ZH] 自定义标题栏的窗口按钮。其高度填满 44px 外框条带，静息态保持透明，且不继承默认按钮外边距。
    -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Arrow" />
      <!--
        [EN] Caption buttons must not inherit the press compression of content buttons: the
             window chrome is a fixed hit target and a scaling caption breaks its alignment.
        [ZH] 窗口按钮不得继承内容按钮的按压缩放：窗口外框是固定命中目标，缩放其标题控件会破坏对齐。
      -->
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.chrome:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
    </Style>

    <!--
      [EN] Text input, combo box, check box and slider themes are owned by Themes/Widgets.axaml.
           Radio buttons and lists remain below because their templates are not part of this
           iteration's redesign scope.
      [ZH] 文本输入框、下拉框、复选框与滑块的主题均由 Themes/Widgets.axaml 治理。单选框与列表保持在
           下方，因为其模板不属于本次重绘范围。
    -->

    <!-- ================= 单选框 / Radio button ================= -->
    <Style Selector="RadioButton">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border Width="16" Height="16" CornerRadius="8"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Ellipse Name="PART_Dot" Width="8" Height="8" IsVisible="False"
                       Fill="{DynamicResource AccentBrush}" />
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#PART_Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ================= 列表 / List ================= -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border Name="PART_Border"
                  Background="Transparent"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>

    <!-- ================= 页签 / Tabs ================= -->
    <Style Selector="TabControl">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabControl">
          <Grid RowDefinitions="Auto,*">
            <ItemsPresenter Name="PART_ItemsPresenter" Grid.Row="0"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                    Background="{DynamicResource AppBackgroundBrush}" CornerRadius="0,0,8,8"
                    BoxShadow="{DynamicResource CardShadow}">
              <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="TabItem">
          <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
          <Setter Property="Padding" Value="14,7" />
          <Setter Property="Margin" Value="0,0,3,0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Template">
            <ControlTemplate TargetType="TabItem">
              <Border Name="PART_Border" CornerRadius="8,8,0,0"
                      Margin="{TemplateBinding Margin}"
                      Padding="{TemplateBinding Padding}"
                      Background="{DynamicResource TabInactiveBackgroundBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
          <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
          </Style>
          <Style Selector="^:selected /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          </Style>
          <Style Selector="^:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </ControlTheme>
      </Setter>
    </Style>

    <!-- ================= 浮层 / Flyouts ================= -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource TooltipBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ================= 进度条 / Progress bar ================= -->
    <Style Selector="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="6" />
    </Style>

    <!-- ================= 折叠区 / Expander ================= -->
    <Style Selector="Expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#PART_toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>

    <!-- ================= 右键菜单 / Context menu ================= -->
    <Style Selector="MenuItem">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--
      [EN] Shared elevation class for panels that must read as a distinct surface.
      [ZH] 供需要表达独立层级的面板复用的高程样式类。
    -->
    <Style Selector="Border.elevated">
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EchoDesk/Themes/Controls.axaml" />
        <ResourceInclude Source="avares://EchoDesk/Themes/Widgets.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://EchoDesk/Themes/Light.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://EchoDesk/Themes/Dark.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
