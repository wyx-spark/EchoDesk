<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    [EN] Core control themes for the EchoDesk Avalonia shell (iteration 3). This dictionary
         supersedes the temporary style overrides that previously lived in App.axaml and governs
         the interaction feedback of Button, TextBox, Slider, ToggleSwitch, CheckBox and ComboBox.
    [ZH] EchoDesk Avalonia 外壳的核心控件主题（第 3 次迭代）。本字典取代此前位于 App.axaml 中的
         临时样式覆盖，统一治理 Button、TextBox、Slider、ToggleSwitch、CheckBox 与 ComboBox 的交互反馈。
    [EN] Interaction contract: state changes are expressed through low-cost Transitions with a
         CubicEaseOut curve in the 150-200 ms range. Animations are used only where a Transition
         cannot produce the required entrance effect, namely the ComboBox drop-down.
    [ZH] 交互约定：状态变化通过低开销的 Transitions 表达，采用 150-200ms 区间的 CubicEaseOut 缓动曲线。
         仅当 Transitions 无法产生所需入场效果时才使用 Animation，当前仅用于 ComboBox 下拉菜单。
    [EN] Structural contract: every template part name consumed by the Avalonia control logic is
         preserved verbatim, so no binding, command or automation identifier is altered.
    [ZH] 结构约定：Avalonia 控件逻辑所消费的全部模板部件名称均原样保留，因此不改变任何绑定、命令或
         自动化标识。
  -->

  <FontFamily x:Key="EchoControlFontFamily">Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol</FontFamily>

  <!-- ============================================================= -->
  <!-- [EN] Button -->
  <!-- [ZH] 按钮                                                  -->
  <!-- ============================================================= -->
  <!--
    [EN] The default button is the secondary variant: a neutral translucent surface with a single
         hairline border. The primary variant is exposed through the "primary" style class and the
         ghost variant through the "ghost" style class, so that call sites select a semantic role
         instead of redefining colours locally.
    [ZH] 默认按钮即为次按钮变体：中性半透明底面配单条细描边。主按钮通过 "primary" 样式类暴露，
         幽灵按钮通过 "ghost" 样式类暴露，使调用方按语义角色选择，而非就地重复定义配色。
  -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource EchoControlFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Border Name="PART_Border"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Name="PART_ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <!--
      [EN] Hover raises the surface brightness by one palette step; the pressed state settles the
           whole button to 96 percent, which reads as a physical compression without bounce.
      [ZH] 悬停将底面亮度提升一个色板层级；按下状态将整体缩放至 96%，呈现物理压缩感且不产生弹跳。
    -->
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    </Style>

    <!--
      [EN] Primary variant: a solid accent surface reserved for the single dominant action of a
           view. The hover and pressed states shift the accent brightness rather than its hue.
      [ZH] 主按钮变体：实心强调色底面，仅用于视图中唯一的主导操作。悬停与按下状态调整强调色亮度而非色相。
    -->
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
      </Style>
    </Style>

    <!--
      [EN] Ghost variant: text only, with no resting surface or border; hover reveals a faint
           neutral wash so that the affordance remains discoverable.
      [ZH] 幽灵按钮变体：仅保留文字，静息态无底面与描边；悬停时呈现极淡的中性底色以维持可发现性。
    -->
    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- ============================================================= -->
  <!-- [EN] TextBox -->
  <!-- [ZH] 输入框                                               -->
  <!-- ============================================================= -->
  <!--
    [EN] Borderless input: the field is expressed by a filled surface only. Focus is signalled by
         a two-pixel accent underline that fades in and carries a restrained glow, which keeps the
         focus indicator visible on both light and dark canvases.
    [ZH] 无边框输入框：仅以填充底面表达输入区域。焦点由一条两像素宽的强调色底部线条提示，该线条淡入
         并附带克制的光晕，使焦点指示在浅色与深色画布上均保持可见。
  -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource EchoControlFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextForegroundBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackgroundBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource SubTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <!--
      [EN] The border thickness is a constant. It is never written by a state selector: changing
           BorderThickness, Margin or Padding on :pointerover would invalidate measure and arrange
           on every pointer crossing, which is exactly the flicker this theme must prevent. The
           hover/focus feedback below is expressed exclusively through BorderBrush, Background and
           BoxShadow transitions, all of which are render-only properties.
      [ZH] 描边宽度是常量。任何状态选择器都不会写入它：在 :pointerover 上修改 BorderThickness、
           Margin 或 Padding 会在每次指针穿越时使测量与排列失效，而这正是本主题必须杜绝的闪烁。
           下方的悬停/焦点反馈只通过 BorderBrush、Background 与 BoxShadow 过渡表达，它们全部是
           仅影响渲染的属性。
    -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
    <Setter Property="Template">
      <ControlTemplate TargetType="TextBox">
        <DataValidationErrors>
          <Border Name="PART_BorderElement"
                  MinWidth="{TemplateBinding MinWidth}"
                  MinHeight="{TemplateBinding MinHeight}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="*,2">
              <Border Grid.Row="0" Padding="{TemplateBinding Padding}" Background="Transparent">
                <ScrollViewer Name="PART_ScrollViewer"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                              AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                              BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                  <Panel>
                    <TextBlock Name="PART_Placeholder"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               Text="{TemplateBinding PlaceholderText}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                      <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                          <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                        </MultiBinding>
                      </TextBlock.IsVisible>
                    </TextBlock>
                    <TextPresenter Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                   CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                   CaretIndex="{TemplateBinding CaretIndex}"
                                   SelectionStart="{TemplateBinding SelectionStart}"
                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   TextWrapping="{TemplateBinding TextWrapping}"
                                   LineHeight="{TemplateBinding LineHeight}"
                                   LetterSpacing="{TemplateBinding LetterSpacing}"
                                   PasswordChar="{TemplateBinding PasswordChar}"
                                   RevealPassword="{TemplateBinding RevealPassword}"
                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                   CaretBrush="{TemplateBinding CaretBrush}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Panel>
                  <ScrollViewer.Styles>
                    <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                      <Setter Property="Cursor" Value="IBeam" />
                    </Style>
                  </ScrollViewer.Styles>
                </ScrollViewer>
              </Border>
              <Border Name="PART_Underline" Grid.Row="1"
                      Background="{DynamicResource AccentBrush}"
                      BoxShadow="0 0 0 0 #00000000"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Grid>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!--
      [EN] Hover and focus deliberately touch only render properties (Background, BorderBrush,
           Opacity, BoxShadow). The two-pixel underline row is part of the fixed template grid, so
           its opacity/shadow changes cannot resize the field. Focus wins over hover because its
           selector is declared last, matching the pre-existing precedence.
      [ZH] 悬停与焦点刻意只修改渲染属性（Background、BorderBrush、Opacity、BoxShadow）。两像素底线
           是固定模板网格的一部分，因此其不透明度/光晕变化不会改变输入框尺寸。焦点选择器声明在最后，
           因而优先于悬停，与既有优先级一致。
    -->
    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Underline">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="BoxShadow" Value="{DynamicResource InputHoverGlow}" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_Underline">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BoxShadow" Value="{DynamicResource InputUnderlineGlow}" />
    </Style>
    <Style Selector="^:error /template/ Border#PART_Underline">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </ControlTheme>

  <!-- ============================================================= -->
  <!-- [EN] Slider -->
  <!-- [ZH] 滑块                                                  -->
  <!-- ============================================================= -->
  <!--
    [EN] Slider rail contract: a two-pixel rail with a twelve-pixel thumb. Both ends of the rail
         use dedicated RepeatButton themes so that the filled portion and the empty portion can
         adopt contrasting palette entries without altering the Track geometry.
    [ZH] 滑块轨道约定：轨道高两像素，滑块直径十二像素。轨道两端采用专用的 RepeatButton 主题，
         使已填充段与未填充段可采用对比色板条目，同时不改变 Track 的几何计算。
  -->
  <ControlTheme x:Key="EchoSliderTrackFillHorizontal" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RepeatButton">
        <Border Height="2" VerticalAlignment="Center" CornerRadius="1"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="EchoSliderTrackFillVertical" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RepeatButton">
        <Border Width="2" HorizontalAlignment="Center" CornerRadius="1"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    [EN] Thumb contract: the visible twelve-pixel dot is centred inside a twenty-pixel glow layer.
         Hover fades the glow layer in; the scale factor is applied to the Thumb itself by the
         Slider theme, therefore the glow never participates in layout measurement.
    [ZH] 滑块约定：可见的十二像素圆点居中于二十像素光晕层之内。悬停时淡入光晕层；缩放系数由 Slider
         主题施加于 Thumb 本身，因此光晕层从不参与布局测量。
  -->
  <ControlTheme x:Key="EchoSliderThumb" TargetType="Thumb">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="Thumb">
        <Grid>
          <Border Name="PART_Glow"
                  Width="20" Height="20" CornerRadius="10"
                  Background="{TemplateBinding Background}" Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border Name="PART_ThumbBorder"
                  Width="12" Height="12" CornerRadius="6"
                  Background="{TemplateBinding Background}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Glow">
      <Setter Property="Opacity" Value="0.3" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}" />
    <Setter Property="Margin" Value="0,-9,0,-9" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate TargetType="Slider">
          <DataValidationErrors>
            <Grid>
              <Track Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     Orientation="Horizontal">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton"
                                Theme="{StaticResource EchoSliderTrackFillHorizontal}"
                                Background="{TemplateBinding Foreground}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton"
                                Theme="{StaticResource EchoSliderTrackFillHorizontal}"
                                Background="{TemplateBinding Background}" />
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="12" Height="12"
                       Background="{TemplateBinding Foreground}"
                       Theme="{StaticResource EchoSliderThumb}" />
              </Track>
            </Grid>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate TargetType="Slider">
          <DataValidationErrors>
            <Grid>
              <Track Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     Orientation="Vertical">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton"
                                Theme="{StaticResource EchoSliderTrackFillVertical}"
                                Background="{TemplateBinding Foreground}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton"
                                Theme="{StaticResource EchoSliderTrackFillVertical}"
                                Background="{TemplateBinding Background}" />
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="12" Height="12"
                       Background="{TemplateBinding Foreground}"
                       Theme="{StaticResource EchoSliderThumb}" />
              </Track>
            </Grid>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>

    <!--
      [EN] Hover magnifies the thumb by 1.2 and pressed settles it to 1.08, so the compression is
           relative to the hovered size rather than to the resting size.
      [ZH] 悬停将滑块放大至 1.2 倍，按下时回落至 1.08 倍，因此压缩是相对悬停尺寸而非静息尺寸发生的。
    -->
    <Style Selector="^:pointerover /template/ Thumb">
      <Setter Property="RenderTransform" Value="scale(1.2)" />
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Thumb">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- ============================================================= -->
  <!-- [EN] ToggleSwitch -->
  <!-- [ZH] 开关                                            -->
  <!-- ============================================================= -->
  <!--
    [EN] Toggle contract: the knob travels through the Canvas.Left transition supplied by the
         control's own KnobTransitions property, which is the only mechanism that keeps the pointer
         drag gesture and the keyboard toggle consistent. The track cross-fades between the off and
         on layers so that the fill colour changes smoothly as well.
    [ZH] 开关约定：滑块位移使用控件自带的 KnobTransitions 属性所提供的 Canvas.Left 过渡，这是唯一能
         使指针拖拽手势与键盘切换保持一致的机制。轨道在关闭层与开启层之间交叉淡入淡出，使填充色同样
         平滑变化。
  -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="FontFamily" Value="{StaticResource EchoControlFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleSwitch">
        <Grid RowDefinitions="Auto,Auto" Background="{TemplateBinding Background}">
          <ContentPresenter Name="PART_ContentPresenter" Grid.Row="0"
                            Margin="0,0,0,6"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
          <Grid Grid.Row="1" Width="40" Height="20"
                HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border Name="OuterBorder"
                    Width="40" Height="20" CornerRadius="10"
                    Background="{DynamicResource ToggleTrackOffBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border Name="SwitchKnobBounds"
                    Width="40" Height="20" CornerRadius="10"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0" Opacity="0">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Canvas Name="PART_SwitchKnob" Width="20" Height="20" HorizontalAlignment="Left">
              <Grid Name="PART_MovingKnobs" Width="20" Height="20">
                <Border Width="16" Height="16" CornerRadius="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ToggleKnobBrush}" />
              </Grid>
            </Canvas>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#OuterBorder">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:unchecked /template/ Border#OuterBorder">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:unchecked /template/ Border#SwitchKnobBounds">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <!-- ============================================================= -->
  <!-- [EN] CheckBox -->
  <!-- [ZH] 复选框                                              -->
  <!-- ============================================================= -->
  <!--
    [EN] Check contract: the tick is a stroked path that scales from 0.6 to 1.0 while fading in,
         producing a restrained drawing sensation within 160 ms. The box fill adopts the accent
         colour at the same moment, therefore the state change is legible before the tick completes.
    [ZH] 复选框约定：对勾为描边路径，在 160ms 内由 0.6 倍缩放淡入至 1.0 倍，形成克制的书写感。
         方框填充在同一时刻转为强调色，因此即便对勾尚未完成，状态变化已可辨识。
  -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource EchoControlFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Grid Width="18" Height="18" VerticalAlignment="Center">
            <Border Name="PART_Box"
                    Width="18" Height="18" CornerRadius="5"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Path Name="PART_CheckGlyph"
                  Data="M 4.4 9.2 L 7.4 12.2 L 13.6 6.0"
                  Stroke="{DynamicResource AccentForegroundBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%"
                  RenderTransform="scale(0.6)"
                  Opacity="0">
              <Path.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
              </Path.Transitions>
            </Path>
          </Grid>
          <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_CheckGlyph">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- ============================================================= -->
  <!-- [EN] ComboBox -->
  <!-- [ZH] 下拉框                                              -->
  <!-- ============================================================= -->
  <!--
    [EN] Combo contract: the selection surface reuses the borderless input language, while the
         drop-down adopts the menu palette and an eight-pixel corner radius. The entrance is
         160 ms in total: the six-pixel upward translation is driven by a TransformOperations
         Transition, and the fade is driven by the single short Animation in this dictionary,
         because a fade has no prior state to transition from while the Popup is closed. The
         resting opacity remains 1, so a style-matching failure can never hide the menu.
    [ZH] 下拉框约定：选择区域沿用无边框输入语言，下拉菜单采用菜单色板与八像素圆角。入场总时长为
         160ms：六像素上移由 TransformOperations 过渡驱动，淡入则由本字典中唯一一段短动画驱动，
         因为 Popup 关闭期间不存在可供淡入过渡的先前状态。静息不透明度保持为 1，确保样式匹配失败时
         菜单也绝不会被隐藏。
  -->
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource EchoControlFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource SubTextBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ComboBox">
        <DataValidationErrors>
          <Grid ColumnDefinitions="*,30">
            <Border Name="Background"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border Name="HighlightBackground"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource FocusBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False" />
            <TextBlock Name="PlaceholderTextBlock"
                       Grid.Column="0"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Margin="{TemplateBinding Padding}"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                  <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <ContentControl Name="ContentPresenter"
                            Grid.Column="0"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
            <TextBox Name="PART_EditableTextBox"
                     Grid.Column="0"
                     Padding="{TemplateBinding Padding}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     Background="Transparent"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     BorderThickness="0"
                     IsVisible="{TemplateBinding IsEditable}" />
            <PathIcon Name="DropDownGlyph"
                      Grid.Column="1"
                      UseLayoutRounding="False"
                      IsHitTestVisible="False"
                      Height="10" Width="10"
                      Margin="0,0,10,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Foreground="{DynamicResource SubTextBrush}"
                      Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z" />
            <Popup Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border Name="PopupBorder"
                      Background="{DynamicResource MenuBackgroundBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="1"
                      Padding="4"
                      CornerRadius="8"
                      BoxShadow="{DynamicResource CardShadow}"
                      RenderTransform="translateY(-6px)"
                      HorizontalAlignment="Stretch">
                <Border.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              IsScrollChainingEnabled="False"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
    <Style Selector="^:focus /template/ Border#HighlightBackground">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!--
      [EN] Drop-down entrance: the style can only match while the drop-down is open, therefore the
           transition restarts on every opening and leaves the closed state untouched. Opacity is
           driven by a short keyframe animation because there is no prior opacity state to
           transition from; the translation is driven by a Transition. The resting opacity remains
           1 and the resting offset is only six pixels, so a style-matching failure cannot hide
           the menu.
      [ZH] 下拉入场：该样式仅在菜单打开期间可匹配，因此过渡在每次展开时重新开始，且不影响关闭状态。
           由于不存在可过渡的先前不透明度状态，不透明度由极短的关帧动画驱动；位移则由 Transitions 驱动。
           静息不透明度保持为 1，静息偏移仅为六像素，因此即使样式匹配失败，菜单也不会被隐藏。
    -->
    <Style Selector="^:dropdownopen /template/ Border#PopupBorder">
      <Setter Property="RenderTransform" Value="translateY(0)" />
      <Style.Animations>
        <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="None">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <!--
    [EN] Drop-down item contract: the item follows the list-row language of the application, with
         a rounded hover wash and an accent-tinted selected row, so that the menu is visually part
         of the same product rather than of the stock Fluent palette.
    [ZH] 下拉项约定：下拉项沿用应用的列表行语言，悬停为圆角淡色底，选中行为强调色调，使菜单在视觉上属于
         同一产品，而非原生 Fluent 色板。
  -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource EchoControlFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ComboBoxItem">
        <Border Name="PART_Border"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
