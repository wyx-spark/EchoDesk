<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.Views.Settings.DeveloperPage">
  <!--
    [EN] Developer page (v0.2.1 cross-platform track 2, development task 1, fifth migrated
         module).

    [EN] Scope: developer-mode switch and status, plugin directory listing, reload, log viewing
         and the new local plugin scaffold. **Editing the "local plugin manifest" table was not
         migrated in this round** (the bottom of the page says so explicitly); that part needs
         an editable table and belongs to the next round. Control names and AutomationIds match
         the WPF build, so the assertions in ui_probe.ps1 can be reused.
    [ZH] 开发者页（v0.2.1 跨平台-2 研发任务 1，第 5 个迁移模块）。

    覆盖：开发者模式开关与状态、插件目录清单、重载、日志查看、新建本地插件骨架。
    **「本地插件清单」表格编辑本轮未迁移**（页面底部有明确说明），
    那部分要一张可编辑表格，属于下一轮的工作。
    控件名与 AutomationId 与 WPF 版同名，便于复用 ui_probe.ps1 的断言。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="14,12" Spacing="10">

      <!-- [EN] (1) Developer mode. -->
      <!-- [ZH] ① 开发者模式。 -->
      <TextBlock x:Name="DevModeSectionLabel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
      <CheckBox x:Name="DevModeCheck" FontSize="13"
                AutomationProperties.AutomationId="DevModeCheck" />
      <TextBlock x:Name="DevModeShortText" FontSize="11" TextWrapping="Wrap" Opacity="0.65" />
      <TextBlock x:Name="DevModeStatusText" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"
                 AutomationProperties.AutomationId="DevModeStatusText" />
      <TextBlock x:Name="DevPluginListText" FontSize="11" TextWrapping="Wrap" Opacity="0.75"
                 AutomationProperties.AutomationId="DevPluginListText" />
      <TextBlock x:Name="DevApiText" FontSize="11" Opacity="0.75"
                 AutomationProperties.AutomationId="DevApiText" />

      <!-- [EN] (2) Plugin directories. -->
      <!-- [ZH] ② 插件目录。 -->
      <TextBlock x:Name="DevDirsSectionLabel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
      <Border Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12,10">
        <StackPanel Spacing="8">
          <TextBlock x:Name="DevDirsText" FontSize="11" TextWrapping="Wrap" Opacity="0.8"
                     AutomationProperties.AutomationId="DevDirsText" />
          <!--
            [EN] The three directory buttons (v0.2.2 batch 4, item 3a): same names and meanings
                 as in WPF, and the example-plugin directory is the first-hand answer to what a
                 plugin looks like.
            [ZH] 三个目录按钮（v0.2.2 第 4 批 3a）：与 WPF 同名同义，
                 「示例插件」目录是“插件长什么样”的第一手答案。
          -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenDevDirButton" Padding="12,4" FontSize="11"
                    AutomationProperties.AutomationId="OpenDevDirButton" />
            <Button x:Name="OpenInstallDirButton" Padding="12,4" FontSize="11"
                    AutomationProperties.AutomationId="OpenInstallDirButton" />
            <Button x:Name="OpenExamplesDirButton" Padding="12,4" FontSize="11"
                    AutomationProperties.AutomationId="OpenExamplesDirButton" />
            <Button x:Name="InstallExamplesButton" Padding="12,4" FontSize="11"
                    AutomationProperties.AutomationId="InstallExamplesButton" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- [EN] (3) Reload and log. -->
      <!-- [ZH] ③ 重载与日志。 -->
      <TextBlock x:Name="DevReloadSectionLabel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="DevReloadButton" Padding="12,4" FontSize="11"
                AutomationProperties.AutomationId="DevReloadButton" />
        <Button x:Name="ClearDevLogButton" Padding="12,4" FontSize="11"
                AutomationProperties.AutomationId="ClearDevLogButton" />
        <Button x:Name="RefreshDevLogButton" Padding="12,4" FontSize="11" />
        <Button x:Name="ExportDevLogButton" Padding="12,4" FontSize="11"
                AutomationProperties.AutomationId="ExportDevLogButton" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="LogLinesLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.75" />
        <ComboBox x:Name="LogLinesCombo" Width="90"
                  AutomationProperties.AutomationId="LogLinesCombo" />
        <TextBlock x:Name="LogLinesUnitText" VerticalAlignment="Center" FontSize="11" Opacity="0.75" />
      </StackPanel>
      <!--
        [EN] The Avalonia TextBox has **no** ScrollBarVisibility property (the WPF TextBox
             does); in practice the compiler reported AVLN2000. Wrapping it in a ScrollViewer
             achieves the same effect, which is yet another "present in WPF, absent in Avalonia"
             API difference (see the list of pitfalls in the notes).
        [ZH] Avalonia 的 TextBox **没有** ScrollBarVisibility 属性（WPF 的 TextBox 有），
             实测编译报 AVLN2000。用 ScrollViewer 包一层达到同样效果 ——
             又一处“WPF 有、Avalonia 没有”的 API 差异（见记录里的坑列表）。
      -->
      <ScrollViewer Height="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <TextBox x:Name="DevLogBox" Padding="6,4" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" FontSize="11"
                 FontFamily="Consolas,Menlo,monospace"
                 AutomationProperties.AutomationId="DevLogBox" />
      </ScrollViewer>

      <!-- [EN] (4) New local plugin. -->
      <!-- [ZH] ④ 新建本地插件。 -->
      <TextBlock x:Name="ScaffoldSectionLabel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
      <TextBlock x:Name="ScaffoldTipText" FontSize="11" TextWrapping="Wrap" Opacity="0.65" />
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" RowDefinitions="Auto">
        <TextBlock x:Name="ScaffoldIdLabel" Grid.Column="0" VerticalAlignment="Center" FontSize="12" />
        <TextBox x:Name="ScaffoldIdBox" Grid.Column="1" Margin="6,0,10,0" Padding="6,4"
                 AutomationProperties.AutomationId="ScaffoldIdBox" />
        <TextBlock x:Name="ScaffoldNameLabel" Grid.Column="2" VerticalAlignment="Center" FontSize="12" />
        <TextBox x:Name="ScaffoldNameBox" Grid.Column="3" Margin="6,0,10,0" Padding="6,4"
                 AutomationProperties.AutomationId="ScaffoldNameBox" />
        <TextBlock x:Name="ScaffoldAuthorLabel" Grid.Column="4" VerticalAlignment="Center" FontSize="12" />
        <TextBox x:Name="ScaffoldAuthorBox" Grid.Column="5" Margin="6,0,10,0" Padding="6,4"
                 AutomationProperties.AutomationId="ScaffoldAuthorBox" />
        <Button x:Name="ScaffoldCreateButton" Grid.Column="6" Padding="12,4"
                AutomationProperties.AutomationId="ScaffoldCreateButton" />
      </Grid>

      <!--
        [EN] (5) Local plugin manifest (v0.2.2 batch 4, item 3a: extended from "not migrated" to
             an editable table).
        [ZH] ⑤ 本地插件清单（v0.2.2 第 4 批 3a：从“未迁移”补成可编辑表格）。
      -->
      <TextBlock x:Name="ManifestSectionLabel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
      <TextBlock x:Name="ManifestNoticeText" FontSize="11" TextWrapping="Wrap" Opacity="0.7" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ManifestAddRow" Padding="12,4" FontSize="11"
                AutomationProperties.AutomationId="ManifestAddRow" />
        <Button x:Name="ManifestSaveButton" Padding="12,4" FontSize="11"
                AutomationProperties.AutomationId="ManifestSaveButton" />
        <Button x:Name="ManifestOpenRawButton" Padding="12,4" FontSize="11"
                AutomationProperties.AutomationId="ManifestOpenRawButton" />
      </StackPanel>
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ManifestList" Spacing="4"
                    AutomationProperties.AutomationId="ManifestList" />
      </ScrollViewer>

      <!-- [EN] (6) Automation hooks and plugin panels (v0.2.2 batch 4, item 3a). -->
      <!-- [ZH] ⑥ 自动化钩子与插件面板（v0.2.2 第 4 批 3a）。 -->
      <TextBlock x:Name="HooksSectionLabel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
      <TextBlock x:Name="HooksText" FontSize="11" TextWrapping="Wrap" Opacity="0.8"
                 AutomationProperties.AutomationId="HooksText" />

      <TextBlock x:Name="PanelsSectionLabel" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
      <StackPanel x:Name="PanelList" Spacing="8"
                  AutomationProperties.AutomationId="PanelList" />

      <!-- [EN] (7) Status row. -->
      <!-- [ZH] ⑦ 状态行。 -->
      <TextBlock x:Name="DevStatusText" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                 AutomationProperties.AutomationId="DevStatusText" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
