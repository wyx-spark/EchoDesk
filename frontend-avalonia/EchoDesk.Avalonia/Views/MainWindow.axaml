<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EchoDesk.Avalonia.Views.MainWindow"
        Title="EchoDesk"
        Width="1080" Height="760" MinWidth="760" MinHeight="540"
        Background="{DynamicResource AppBackgroundBrush}"
        DragDrop.AllowDrop="True">
  <!--
    主窗口（任务一原型 / 任务二第一个迁移模块）。

    布局刻意保持 WPF 版的骨架：顶部横幅（平台降级说明）→ 顶部状态条 → 消息区 → 输入区。
    这样一来迁移是"逐块替换实现"而不是重新设计界面，用户不会因为换前端而重新学一遍。
  -->
  <DockPanel LastChildFill="True">

    <!-- ① 平台能力横幅：只在**本平台缺少能力**时显示（任务五的降级文案落点） -->
    <Border x:Name="PlatformBanner" DockPanel.Dock="Top" IsVisible="False"
            Background="{DynamicResource WarningBannerBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,8">
      <StackPanel Spacing="2">
        <TextBlock x:Name="PlatformBannerText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="PlatformBannerDetail" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- ② 无模型引导条：后端"无模型就绪"时把三条路径直白列出来 -->
    <Border x:Name="GuideBanner" DockPanel.Dock="Top" IsVisible="False"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,8">
      <TextBlock x:Name="GuideText" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <!-- ③ 状态条 -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock x:Name="PlatformChip" Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                   Margin="0,0,12,0" Opacity="0.8" />
        <TextBlock x:Name="ModelChip" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                   Margin="0,0,12,0" />
        <TextBlock x:Name="ContextChip" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                   Margin="0,0,12,0" Opacity="0.8" />
        <TextBlock x:Name="StatusText" Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Opacity="0.7" />
        <Button x:Name="FontDownButton" Grid.Column="4" Content="A-" Padding="7,1" FontSize="12"
                ToolTip.Tip="缩小字号" />
        <Button x:Name="FontUpButton" Grid.Column="5" Content="A+" Padding="7,1" FontSize="12"
                Margin="4,0,0,0" ToolTip.Tip="放大字号" />
        <Button x:Name="ThemeButton" Grid.Column="6" Content="🌓" Padding="7,1" FontSize="12"
                Margin="8,0,0,0" ToolTip.Tip="切换深色/浅色主题" />
        <ComboBox x:Name="LangCombo" Grid.Column="7" FontSize="12" Margin="8,0,0,0"
                  MinWidth="112" ToolTip.Tip="界面语言" />
        <Button x:Name="CapabilityButton" Grid.Column="8" Content="ℹ️" Padding="7,1" FontSize="12"
                Margin="8,0,0,0" ToolTip.Tip="查看本平台能力清单（可用/降级）" />
      </Grid>
    </Border>

    <!-- ④ 输入区 -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
            Padding="10,8">
      <Grid RowDefinitions="Auto,Auto">
        <TextBox x:Name="InputBox" Grid.Row="0" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="64" MaxHeight="200" FontSize="14"
                 Watermark="输入消息，Ctrl+Enter 发送 · 拖拽文件到窗口即可上传"
                 PlaceholderText="输入消息，Ctrl+Enter 发送 · 拖拽文件到窗口即可上传" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
          <Button x:Name="UploadButton" Grid.Column="0" Content="📎 上传文件" FontSize="12" Padding="10,3" />
          <TextBlock x:Name="HintText" Grid.Column="1" FontSize="11" Opacity="0.6"
                     VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
          <Button x:Name="StopButton" Grid.Column="2" Content="⏹ 停止" FontSize="12" Padding="10,3"
                  IsVisible="False" />
          <Button x:Name="SendButton" Grid.Column="3" Content="发送" FontSize="13" Padding="18,4"
                  Margin="8,0,0,0" />
        </Grid>
      </Grid>
    </Border>

    <!-- ⑤ 消息区 -->
    <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="MessagePanel" Margin="14" Spacing="12" />
    </ScrollViewer>
  </DockPanel>
</Window>
