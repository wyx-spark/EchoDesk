<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextForeground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8A7DFF"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="InputBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="InputBorder" Color="#3F3F46"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#3F3F46"/>
    <SolidColorBrush x:Key="UserBrush" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="AssistantBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="SystemBrush" Color="#B0B0B0"/>
</ResourceDictionary>
