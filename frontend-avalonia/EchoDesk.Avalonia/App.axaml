<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EchoDesk.Avalonia.App"
             RequestedThemeVariant="Default">
  <!--
    [EN] Global style baseline for the Avalonia shell (v0.2.3 iteration 2).
    [ZH] Avalonia 外壳的全局样式基线（v0.2.3 研发任务-2）。
    [EN] Palette definitions now live in Themes/Light.axaml and Themes/Dark.axaml, while the
         immersive scrollbar lives in Themes/Controls.axaml. This file is limited to the
         application-wide control styles that must remain identical across themes.
    [ZH] 色板定义现已迁移至 Themes/Light.axaml 与 Themes/Dark.axaml，沉浸式滚动条位于
         Themes/Controls.axaml。本文件仅保留跨主题必须保持一致的全局控件样式。
    [EN] Typography contract: Inter is the preferred Latin face with a Unicode-complete fallback
         chain and the base size is 15 px; body paragraphs use a 1.6x line height, applied by the
         Markdown renderer so that the ratio follows the configured paragraph size.
    [ZH] 排版约定：拉丁字形优先使用 Inter，并配置覆盖完整的回退链，基准字号为 15px；正文段落
         使用 1.6 倍行高，由 Markdown 渲染器按实际配置的段落字号施加，以保持比例一致。
  -->
  <Application.Styles>
    <FluentTheme />

    <!-- ================= 字体与排版 / Typography ================= -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>
    <!--
      [EN] The 1.6 line height is applied by the Markdown renderer to body paragraphs, where it is
           derived from the actual paragraph size. Applying it to every label would clip the fixed
           height status chips, hence no global LineHeight setter is defined.
      [ZH] 1.6 行高由 Markdown 渲染器按实际段落字号施加于正文段落。若对所有标签统一施加，
           会裁切固定高度的状态胶囊，因此此处不定义全局行高设置器。
    -->
    <Style Selector="Label">
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>

    <!-- ================= 按钮（正常 / 悬停 / 按下 / 禁用） / Button states ================= -->
    <!--
      [EN] Geometry: 12x6 padding, 6 px corner radius and no intrinsic minimum size, so that
           compact toolbars keep their intended proportions.
      [ZH] 几何参数：内边距 12x6、圆角 6px、不设固有最小尺寸，以保证紧凑工具栏维持既有比例。
    -->
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="PART_Border"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    </Style>

    <!--
      [EN] Caption buttons of the custom title bar. They occupy the full 44 px chrome strip,
           stay transparent at rest, and never inherit the default button margin.
      [ZH] 自定义标题栏的窗口按钮。其高度填满 44px 外框条带，静息态保持透明，且不继承默认按钮外边距。
    -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.chrome:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
    </Style>

    <!-- ================= 输入框 / Text input ================= -->
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- ================= 下拉框 / Combo box ================= -->
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ================= 复选框 / 单选框 / Check box and radio button ================= -->
    <Style Selector="CheckBox">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border Name="PART_Box" Width="16" Height="16" CornerRadius="4"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <TextBlock Name="PART_Mark" Text="✓" FontSize="12" LineHeight="14" IsVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ TextBlock#PART_Mark">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="RadioButton">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border Width="16" Height="16" CornerRadius="8"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Ellipse Name="PART_Dot" Width="8" Height="8" IsVisible="False"
                       Fill="{DynamicResource AccentBrush}" />
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#PART_Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ================= 列表 / List ================= -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border Name="PART_Border"
                  Background="Transparent"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>

    <!-- ================= 页签 / Tabs ================= -->
    <Style Selector="TabControl">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="TabControl">
          <Grid RowDefinitions="Auto,*">
            <ItemsPresenter Name="PART_ItemsPresenter" Grid.Row="0"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                    Background="{DynamicResource AppBackgroundBrush}" CornerRadius="0,0,8,8"
                    BoxShadow="{DynamicResource CardShadow}">
              <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1"
                                Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="ItemContainerTheme">
        <ControlTheme TargetType="TabItem">
          <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
          <Setter Property="Padding" Value="14,7" />
          <Setter Property="Margin" Value="0,0,3,0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Template">
            <ControlTemplate TargetType="TabItem">
              <Border Name="PART_Border" CornerRadius="8,8,0,0"
                      Margin="{TemplateBinding Margin}"
                      Padding="{TemplateBinding Padding}"
                      Background="{DynamicResource TabInactiveBackgroundBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
          <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource RowHoverBackgroundBrush}" />
          </Style>
          <Style Selector="^:selected /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          </Style>
          <Style Selector="^:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </ControlTheme>
      </Setter>
    </Style>

    <!-- ================= 浮层 / Flyouts ================= -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource TooltipBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ================= 滑块 / 进度条 / Slider and progress bar ================= -->
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin" Value="0,-9,0,-9" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="6" />
    </Style>

    <!-- ================= 折叠区 / Expander ================= -->
    <Style Selector="Expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#PART_toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
    </Style>

    <!-- ================= 右键菜单 / Context menu ================= -->
    <Style Selector="MenuItem">
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI Emoji, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--
      [EN] Shared elevation class for panels that must read as a distinct surface.
      [ZH] 供需要表达独立层级的面板复用的高程样式类。
    -->
    <Style Selector="Border.elevated">
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EchoDesk/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://EchoDesk/Themes/Light.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://EchoDesk/Themes/Dark.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
